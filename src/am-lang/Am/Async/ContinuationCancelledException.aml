namespace Am.Async {

    // Thrown at a suspend point when the Continuation handed to user
    // code is dropped (refcount → 0) without resume() ever being
    // called. The exception propagates up through the suspend chain
    // exactly like any other thrown exception, giving the originally
    // suspended caller a chance to `try`/`catch` it.
    //
    // Raised by the Continuation runtime, not by user code; you should
    // not throw this yourself.
    class ContinuationCancelledException() : Exception("Continuation cancelled — dropped without resume()") {
        import Am.Lang
    }
}
