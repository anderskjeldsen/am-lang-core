namespace Am.Async {

    /**
     * Thrown at a suspend point when the Continuation given to your code is released without
     * resume() ever being called — the asynchronous equivalent of a promise nobody ever settles.
     * It travels up through the suspend chain like any other exception, so the code that suspended
     * can catch it. The runtime raises it; do not throw it yourself.
     */
    class ContinuationCancelledException() : Exception("Continuation cancelled — dropped without resume()") {
        import Am.Lang
    }
}
