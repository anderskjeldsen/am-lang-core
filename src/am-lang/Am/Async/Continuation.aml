namespace Am.Async {

    /**
     * A handle on a suspended computation, used to resume it once whatever it was waiting for has
     * happened. Exactly one call to resume() drives the suspended chain onwards; every later call
     * is silently ignored, so a race between two completion sources is safe by construction and the
     * first one to finish wins.
     * resume() may be called from any thread, and the suspended code continues on whichever thread
     * called it — there is no implicit hop back to the thread that suspended. When you need the
     * continuation to run on the main thread, queue it there yourself, for example through
     * TaskScheduler.
     * This first version is value-less: it carries the fact that something completed, not a result.
     * Passing a value back through a resume is planned for the language-level suspend block.
     */
    #implementationPlatforms "libc"
    native class Continuation() {
        import Am.Lang

        /**
         * Resumes the suspended computation. Idempotent: the first call wins and later calls do nothing
         * at all, neither erroring nor corrupting state.
         */
        native fun resume()

        /**
         * Tests whether resume() has already been called.
         * @return True once the continuation has fired
         */
        native fun isDone(): Bool
    }
}
