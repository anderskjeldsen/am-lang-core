namespace Am.Util {
    /**
     * Pseudo-random numbers from the platform's generator. Fine for games, jitter and sampling;
     * not suitable for anything security-sensitive such as keys, tokens or passwords.
     */
    native class Random {
        import Am.Lang
        /**
         * Returns a pseudo-random integer from 0 up to max.
         * @param max The upper bound
         * @return A pseudo-random value in that range
         */
        #noThrow
        native static fun randomInt(max: Int): Int
    }
}