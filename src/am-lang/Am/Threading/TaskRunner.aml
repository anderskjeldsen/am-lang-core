namespace Am.Threading {

    /**
     * The message that tells a TaskRunner's worker to leave its loop. Sent by TaskRunner.stop().
     */
    class TaskStop {
        import Am.Lang
    }

    /**
     * A single worker thread that runs Tasks in submission order. TaskScheduler owns one per
     * registered thread type; applications schedule work through TaskScheduler.schedule() rather
     * than touching this class. Under the share-nothing thread model the runner IS its mailbox:
     * submit() sends the Task to the worker thread, which blocks in Thread.receive() until one
     * arrives and runs it on its own heap. There is no queue or lock on this side — the mailbox is
     * the queue — and no idle polling: an empty mailbox parks the worker until the next send.
     * A Task travels as a deep copy, so everything the task's lambda captures must be sendable
     * (plain objects, strings, collections, Thread handles); a lambda that captures a native
     * handle makes submit() throw.
     * @param mainThread The thread that tasks scheduled to TaskThreadType.Main go to
     */
    class TaskRunner(private var mainThread: Thread) : Runnable {
        import Am.Lang
        import Am.Collections

        /**
         * Name given to the underlying thread, which is what shows up in a process or task listing.
         * TaskScheduler sets it before start(); it is initialised to a usable default because starting
         * a thread without a name crashes on AmigaOS.
         */
        var name: String = "task-runner"

        /**
         * Priority handed to the worker Thread (see Thread.priority). Set before start().
         */
        var priority: Int = 0

        /**
         * The worker thread, created on start() and never recreated. Nullable so the "not started yet"
         * state is honest; getThread() assumes it is only called after start().
         */
        private var thread: Thread? = null

        /**
         * Sends a task to this runner's worker. Safe to call from any thread; the mailbox serialises
         * delivery. Throws when the task captures something that is not sendable.
         * @param task The task to run
         */
        fun submit(task: Task) {
            this.thread.send(task)
        }

        /**
         * Spawns the worker thread. Call exactly once per runner and before any submit().
         */
        fun start() {
            var t = new Thread(this as Runnable)
            var n = this.name
            if (n == null) {
                n = "task-runner"
            }
            t.name = n
            t.priority = this.priority
            this.thread = t
            t.start()
        }

        /**
         * Asks the worker to stop: it finishes the tasks already in its mailbox ahead of the stop
         * message, then leaves its loop. This does not wait for the thread — join it through
         * getThread() when you need to be sure it has finished.
         */
        fun stop() {
            this.thread.send(new TaskStop())
        }

        /**
         * Returns the worker thread, for joining it. Only valid after start().
         * @return The thread running this worker
         */
        fun getThread(): Thread {
            return this.thread
        }

        /**
         * True when the runner was never started, so shutdown does not join a thread that does not
         * exist.
         * @return Whether a worker thread exists
         */
        fun wasStarted(): Bool {
            return this.thread != null
        }

        /**
         * The worker loop, running on the worker's own copy of this runner: receive a message, run it
         * if it is a Task, stop on a TaskStop. The first thing it does is tell this thread's own
         * TaskScheduler where the main thread is, so tasks the worker schedules to
         * TaskThreadType.Main reach it.
         */
        override fun run() {
            TaskScheduler.attachMain(this.mainThread)
            var running = true
            while (running) {
                var m = Thread.receive()
                if (m is TaskStop) {
                    running = false
                } else if (m is Task) {
                    var task = m as Task
                    task.execute()
                }
            }
        }
    }
}
