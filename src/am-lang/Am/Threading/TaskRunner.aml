namespace Am.Threading {

    /**
     * A single worker thread that drains a queue of Tasks in submission order. TaskScheduler owns
     * one per registered thread type; applications schedule work through TaskScheduler.schedule()
     * rather than touching this class. The thread starts on the first start() call and runs until
     * stop() is requested. Tasks are appended and popped under a mutex, but the lock is released
     * before a task runs, so a slow task never blocks the code submitting new ones.
     * While the queue is empty the worker sleeps briefly and checks again — AmLang has no
     * condition-variable primitive yet — which caps the delay between scheduling a task and it
     * starting at that poll interval, currently 20 ms.
     */
    class TaskRunner : Runnable {
        import Am.Lang
        import Am.Collections

        /**
         * Name given to the underlying thread, which is what shows up in a process or task listing.
         * TaskScheduler sets it before start(); it is initialised to a usable default because starting
         * a thread without a name crashes on AmigaOS.
         */
        var name: String = "task-runner"

        /**
         * Priority handed to the worker Thread (see Thread.priority). Set before start().
         */
        var priority: Int = 0

        /**
         * Pending tasks, oldest first. Only touched while holding the mutex.
         */
        private var queue: List<Task> = new List<Task>()
        /**
         * Guards the queue against concurrent submission and polling.
         */
        private var mutex: Mutex = new Mutex()
        /**
         * Set by stop() and noticed by the worker loop on its next pass.
         */
        private var stopRequested: Bool
        /**
         * Set by the worker as the last thing it does before returning, so shutdown can distinguish a
         * runner that has genuinely left its loop from one still inside `task.execute()`. Read without
         * the mutex: a single Bool write the reader only ever polls for `true`.
         */
        private var finished: Bool = false
        /**
         * True while the worker is inside `task.execute()`. Shutdown reports this so a stuck exit
         * names the runner AND says whether it is mid-task (the case that actually races teardown) or
         * merely between polls.
         */
        private var busy: Bool = false
        /**
         * The worker thread, created on start() and never recreated. Nullable so the "not started yet"
         * state is honest; getThread() assumes it is only called after start().
         */
        private var thread: Thread? = null

        /**
         * How long the worker sleeps between polls while its queue is empty. 20 ms is short enough to
         * feel immediate for UI-driven work without burning CPU on an idle worker.
         */
        private static var IDLE_SLEEP_MS: Long = 20L

        init {
            this.stopRequested = false
        }

        /**
         * Appends a task to this runner's queue. Safe to call from any thread; the mutex serialises it
         * against the worker.
         * @param task The task to queue
         */
        fun submit(task: Task) {
            this.mutex.lock()
            try {
                this.queue.add(task)
            } finally {
                this.mutex.unlock()
            }
        }

        /**
         * Spawns the worker thread. Call exactly once per runner and before any submit(); TaskScheduler
         * guarantees this by creating and starting each runner inside a critical section.
         */
        fun start() {
            var t = new Thread(this as Runnable)
            var n = this.name
            if (n == null) {
                n = "task-runner"
            }
            t.name = n
            t.priority = this.priority
            this.thread = t
            t.start()
        }

        /**
         * Asks the worker to stop. It finishes the task it is running, if any, abandons the rest of the
         * queue, and leaves its loop within one poll interval. This does not wait for the thread —
         * join it through getThread() when you need to be sure it has finished.
         */
        fun stop() {
            this.stopRequested = true
        }

        /**
         * Returns the worker thread, for joining it. Only valid after start().
         * @return The thread running this worker
         */
        fun getThread(): Thread {
            return this.thread
        }

        /**
         * The worker loop: take one task, run it, repeat, sleeping when the queue is empty. The mutex is
         * not held while a task runs, which is the whole point of the queue — a slow task delays the
         * tasks behind it but never the code submitting them.
         */
        override fun run() {
            while (!this.stopRequested) {
                var task = this.poll()
                if (task != null) {
                    this.busy = true
                    task.execute()
                    this.busy = false
                } else {
                    Thread.sleep(TaskRunner.IDLE_SLEEP_MS)
                }
            }
            // Last act: tell shutdown this worker is out of the loop and will
            // touch no more shared state. stopAll waits for this rather than
            // sleeping a fixed 50 ms and hoping.
            this.finished = true
        }

        /**
         * True once the worker has left its loop for good.
         * @return Whether this runner's thread has finished
         */
        fun hasFinished(): Bool {
            return this.finished
        }

        /**
         * True when the worker is currently running a task.
         * @return Whether a task is executing right now
         */
        fun isBusy(): Bool {
            return this.busy
        }

        /**
         * How many tasks are still queued behind the running one.
         * @return Queue depth
         */
        fun pendingCount(): Int {
            var n = 0
            this.mutex.lock()
            try {
                n = this.queue.getSize()
            } finally {
                this.mutex.unlock()
            }
            return n
        }

        /**
         * True when the runner was never started, so shutdown does not wait on a thread that will never
         * set `finished`.
         * @return Whether a worker thread exists
         */
        fun wasStarted(): Bool {
            return this.thread != null
        }

        /**
         * Removes and returns the oldest queued task, under the mutex.
         * @return The next task, or null when the queue is empty
         */
        private fun poll(): Task? {
            var task: Task? = null
            this.mutex.lock()
            try {
                if (this.queue.getSize() > 0) {
                    task = this.queue.get(0)
                    this.queue.removeAt(0)
                }
            } finally {
                this.mutex.unlock()
            }
            return task
        }
    }
}
