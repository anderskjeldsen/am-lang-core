namespace Am.Threading {

    /**
     * A scheduler that runs short-lived pieces of work on per-category worker threads, so an
     * application can get work off its main thread without managing threads itself. Call
     * TaskScheduler.schedule(TaskThreadType.IO, lambda) and the lambda runs on the IO worker; the
     * worker for a category is created the first time something is scheduled to it.
     * Threads share nothing, so a task travels to its worker as a deep COPY: everything the lambda
     * captures must be sendable (plain objects, strings, collections, Thread handles — not files,
     * sockets or windows), and a task cannot write back into the scheduling thread's objects. Send
     * results home instead: schedule a task to TaskThreadType.Main that carries them, which the
     * application runs by calling handleMainTasks() from its event loop.
     * Tasks in one category run serially, so a single long blocking task holds up everything queued
     * behind it — put slow work in its own category, or break it up.
     * Static state is per thread: the runners live in the thread that first scheduled to them
     * (normally main). A worker that schedules to another category gets runners of its own, and
     * its Main tasks go to the thread that created it.
     * Shutdown is automatic — the compiler arranges for the runners to stop when the process exits.
     */
    class TaskScheduler {
        import Am.Lang
        import Am.Collections

        /**
         * Each thread type mapped to its dedicated runner, created lazily. Per thread, like every
         * static, so no lock is needed.
         */
        private static var runners: HashMap<Int, TaskRunner> = new HashMap<Int, TaskRunner>()

        /**
         * Every runner ever created, kept alongside the map so shutdown can iterate the runners
         * directly rather than going through the map's keys, a chain that currently trips the binder.
         */
        private static var allRunners: List<TaskRunner> = List.newList<TaskRunner>()

        /**
         * Where tasks scheduled to TaskThreadType.Main are sent: the thread that runs
         * handleMainTasks(). Null on the main thread itself, which then queues to its own mailbox;
         * set on a worker by its TaskRunner on entry.
         */
        private static var mainThread: Thread? = null

        /**
         * Records the thread that Main tasks go to. Called by TaskRunner when a worker starts, with
         * the handle the runner carried from the thread that created it.
         * @param t The main thread's handle
         */
        static fun attachMain(t: Thread) {
            TaskScheduler.mainThread = t
        }

        /**
         * Queues a lambda to run on the worker for a thread type, and returns as soon as it is queued.
         * Work scheduled to TaskThreadType.Main is sent to the main thread's mailbox and runs when
         * it next calls handleMainTasks(); everything else goes to that type's worker, which is
         * created and started on first use. The lambda is invoked at most once and its Bool result is
         * ignored. Throws when the lambda captures something that is not sendable.
         * @param threadType Which worker to run on, typically a TaskThreadType constant
         * @param task The work to run
         */
        static fun schedule(threadType: Int, task: () => Bool) {
            var wrapper = new Task(task)
            if (threadType == TaskThreadType.Main) {
                var target: Thread = TaskScheduler.mainThread ?? Thread.getCurrent()
                target.send(wrapper)
                return
            }
            var runner = TaskScheduler.ensureRunner(threadType)
            runner.submit(wrapper)
        }

        /**
         * Runs every Task currently waiting in the calling thread's mailbox and returns how many ran.
         * This is the dispatch for TaskThreadType.Main — call it from your event loop, between input
         * ticks or at the top of a frame. It blocks for the combined runtime of the tasks it drains,
         * so keep those tasks short; anything scheduled while the drain is in progress runs on the next
         * call. Messages that are not Tasks are put back into the mailbox, after the tasks, so a
         * program mixing raw Thread messages with Main tasks keeps them — but that is a copy per call,
         * so prefer not to mix the two on one thread. A task that throws is caught and logged, and the
         * drain continues.
         * @return The number of tasks executed, 0 when nothing was waiting
         */
        static fun handleMainTasks(): Int {
            var count = 0
            var others = List.newList<Object>()
            var draining = true
            while (draining) {
                var m = Thread.tryReceive()
                if (m == null) {
                    draining = false
                } else if (m is Task) {
                    var task = m as Task
                    task.execute()
                    count = count + 1
                } else {
                    others.add(m)
                }
            }
            if (others.getSize() > 0) {
                var me = Thread.getCurrent()
                var i = 0
                while (i < others.getSize()) {
                    me.send(others.get(i))
                    i = i + 1
                }
            }
            return count
        }

        /**
         * Returns the runner for a thread type, creating and starting it on first use. The lookup is
         * gated with containsKey() because HashMap.get throws on a missing key rather than returning
         * null.
         * @param threadType The worker category
         * @return The runner for that category
         */
        private static fun ensureRunner(threadType: Int): TaskRunner {
            if (TaskScheduler.runners.containsKey(threadType)) {
                return TaskScheduler.runners.get(threadType)
            }
            var home: Thread = TaskScheduler.mainThread ?? Thread.getCurrent()
            var runner = new TaskRunner(home)
            runner.name = "task-runner-" + threadType.toString()
            // Workers run at the default priority 0. They used to run at
            // -1 "so a download never steals frames from the window" --
            // but on AmigaOS a -1 task gets NO CPU while any priority-0
            // task is busy, and a child process the application spawns
            // (a compiler) runs at 0: every HTTP request then froze for
            // the whole build. The UI is kept responsive the other way
            // round: the application raises its own task to +1 with
            // Thread.setCurrentPriority, and workers, children and other
            // programs share the CPU at 0.
            TaskScheduler.runners.set(threadType, runner)
            TaskScheduler.allRunners.add(runner)
            runner.start()
            return runner
        }

        /**
         * Tells every runner this thread created to stop and waits for its worker to finish. Registered
         * by the compiler through #runOnExit and run between main() returning and static teardown.
         * A worker finishes the tasks already in its mailbox first, so a task that never returns holds
         * the exit — the price of not tearing down a heap a worker is still using.
         */
        #runOnExit
        private static fun stopAll() {
            var list = TaskScheduler.allRunners
            var i = 0
            while (i < list.getSize()) {
                var runner = list.get(i)
                if (runner.wasStarted()) {
                    runner.stop()
                }
                i = i + 1
            }
            var j = 0
            while (j < list.getSize()) {
                var runner = list.get(j)
                if (runner.wasStarted()) {
                    runner.getThread().join()
                }
                j = j + 1
            }
        }
    }
}
