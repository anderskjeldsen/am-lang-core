namespace Am.Threading {

    /**
     * A process-wide scheduler that runs short-lived pieces of work on per-category worker threads,
     * so an application can get work off its main thread without managing threads itself. Call
     * TaskScheduler.schedule(TaskThreadType.IO, lambda) and the lambda runs on the IO worker; the
     * worker for a category is created the first time something is scheduled to it.
     * The important constraint is that tasks in one category run serially, so a single long
     * blocking task holds up everything queued behind it — put slow work in its own category, or
     * break it up. TaskThreadType.Main is special: those tasks are not run by any worker, and the
     * application must call handleMainTasks() from its event loop to run them on the main thread.
     * Shutdown is automatic — the compiler arranges for the runners to stop when the process exits.
     * Not yet provided, and worth knowing you have to do yourself: results from a task (capture a
     * variable or post back through Main), cancellation, backpressure on the queue, and per-task
     * setup of AmigaOS libraries such as bsdsocket and AmiSSL, whose state is per-task and so is
     * not shared with a worker thread.
     */
    class TaskScheduler {
        import Am.Lang
        import Am.Collections

        /**
         * Each thread type mapped to its dedicated runner, created lazily. Guarded by runnersMutex so
         * two first-time schedule() calls for the same type cannot both spawn a runner.
         */
        private static var runners: HashMap<Int, TaskRunner> = new HashMap<Int, TaskRunner>()

        /**
         * Every runner ever created, kept alongside the map so shutdown can iterate the runners
         * directly rather than going through the map's keys, a chain that currently trips the binder.
         */
        private static var allRunners: List<TaskRunner> = List.newList<TaskRunner>()

        /**
         * Guards runner creation and shutdown.
         */
        private static var runnersMutex: Mutex = new Mutex()

        /**
         * Tasks queued for the main thread. No worker drains these — the application does, by calling
         * handleMainTasks(). Until it does they simply accumulate.
         */
        private static var mainQueue: List<Task> = List.newList<Task>()
        /**
         * Guards the main-thread queue.
         */
        private static var mainMutex: Mutex = new Mutex()

        /**
         * Queues a lambda to run on the worker for a thread type, and returns as soon as it is queued.
         * Work scheduled to TaskThreadType.Main is appended to the main-thread queue and runs on
         * whichever thread next calls handleMainTasks(); everything else goes to that type's worker,
         * which is created and started on first use. The lambda is invoked at most once and its Bool
         * result is ignored.
         * @param threadType Which worker to run on, typically a TaskThreadType constant
         * @param task The work to run
         */
        static fun schedule(threadType: Int, task: () => Bool) {
            var wrapper = new Task(task)
            if (threadType == TaskThreadType.Main) {
                TaskScheduler.mainMutex.lock()
                try {
                    TaskScheduler.mainQueue.add(wrapper)
                } finally {
                    TaskScheduler.mainMutex.unlock()
                }
                return
            }
            var runner = TaskScheduler.ensureRunner(threadType)
            runner.submit(wrapper)
        }

        /**
         * Runs every task currently queued for the main thread, on the calling thread, and returns how
         * many ran. This is the dispatch for TaskThreadType.Main — call it from your event loop,
         * between input ticks or at the top of a frame. It blocks for the combined runtime of the tasks
         * it drains, so keep those tasks short. The queue is snapshotted under the lock and drained
         * without it, so producers never wait; anything scheduled while the drain is in progress runs on
         * the next call. A task that throws is caught and logged, and the drain continues.
         * @return The number of tasks executed, 0 when the queue was empty
         */
        static fun handleMainTasks(): Int {
            var drained = List.newList<Task>()
            TaskScheduler.mainMutex.lock()
            try {
                var q = TaskScheduler.mainQueue
                var i = 0
                while (i < q.getSize()) {
                    drained.add(q.get(i))
                    i = i + 1
                }
                TaskScheduler.mainQueue = List.newList<Task>()
            } finally {
                TaskScheduler.mainMutex.unlock()
            }

            var count = 0
            var j = 0
            while (j < drained.getSize()) {
                drained.get(j).execute()
                count = count + 1
                j = j + 1
            }
            return count
        }

        /**
         * Returns the runner for a thread type, creating and starting it on first use. Held under the
         * runners mutex so two concurrent first calls cannot both spawn one. The lookup is gated with
         * containsKey() because HashMap.get throws on a missing key rather than returning null.
         * @param threadType The worker category
         * @return The runner for that category
         */
        private static fun ensureRunner(threadType: Int): TaskRunner {
            TaskScheduler.runnersMutex.lock()
            try {
                if (TaskScheduler.runners.containsKey(threadType)) {
                    return TaskScheduler.runners.get(threadType)
                }
                var runner = new TaskRunner()
                runner.name = "task-runner-" + threadType.toString()
                TaskScheduler.runners.set(threadType, runner)
                TaskScheduler.allRunners.add(runner)
                runner.start()
                return runner
            } finally {
                TaskScheduler.runnersMutex.unlock()
            }
        }

        /**
         * Signals every active runner to stop and waits briefly for them to leave their poll
         * loops. Registered by the compiler through #runOnExit and run between main() returning
         * and static teardown, an ordering that matters because runners may still hold references
         * to objects that have to be released cleanly. Private so application code cannot call it;
         * the generated exit call is not affected by the modifier.
         */
        #runOnExit
        private static fun stopAll() {
            TaskScheduler.runnersMutex.lock()
            try {
                // Walk `allRunners` rather than `runners.keys()` — the
                // HashMap-keys-into-List chain trips the binder
                // ("Can't inject as operator on expression …").
                // ensureRunner keeps the two structures in sync.
                var list = TaskScheduler.allRunners
                var i = 0
                while (i < list.getSize()) {
                    var runner = list.get(i)
                    runner.stop()
                    i = i + 1
                }
            } finally {
                TaskScheduler.runnersMutex.unlock()
            }

            // Give the runners one idle-poll's worth of time to notice
            // the flag and leave their loop. We don't bother joining —
            // the workers themselves never touch shared state after
            // setting the flag, and the runtime teardown that follows
            // doesn't depend on the threads being fully reaped.
            Thread.sleep(50L)
        }
    }
}
