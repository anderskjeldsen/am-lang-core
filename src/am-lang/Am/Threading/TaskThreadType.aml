namespace Am.Threading {

    /**
     * Conventional worker categories to pass to TaskScheduler.schedule(). Each distinct value gets
     * its own worker thread the first time something is scheduled to it, and everything scheduled
     * with that value runs serially on that worker — so the value you choose decides both which
     * tasks can overlap and how many threads exist. Use IO for network and disk work, Worker for
     * CPU-heavy work that would otherwise stall IO behind it, Background for anything deferrable,
     * and Main for work that must happen on the program's main thread. Main is the one that needs
     * care: nothing drains it automatically, so the application has to call
     * TaskScheduler.handleMainTasks() from its event loop or those tasks never run. These are plain
     * Int constants and any Int works, so you can add your own categories.
     */
    class TaskThreadType {
        import Am.Lang

        /**
         * Network and disk work: one worker that absorbs long blocking calls.
         */
        static var IO: Int = 1
        /**
         * Work that must run on the program's main thread, typically anything touching the UI. Not
         * drained automatically — the application must pump it with TaskScheduler.handleMainTasks().
         */
        static var Main: Int = 2
        /**
         * Low-priority miscellaneous work that is safe to defer.
         */
        static var Background: Int = 3
        /**
         * Heavier CPU work — parsing a fetched document, transforming a buffer — kept on its own runner
         * so a long computation does not stall the next IO task queued behind it.
         */
        static var Worker: Int = 4
    }
}
