
namespace Am.Threading {

    /**
     * A mutual-exclusion lock, for guarding data that more than one thread touches. It is
     * recursive, so the same thread may lock it several times as long as it unlocks the same
     * number of times, and it blocks rather than spinning while another thread holds it. Underneath
     * it is a recursive pthread mutex on the libc platforms and an exec.library signal semaphore on
     * AmigaOS and MorphOS.
     * Until the planned lock-block syntax lands, take and release the lock by hand and make sure
     * the release happens on every path: lock(), then a try block for the critical section whose
     * catch unlocks and rethrows, then unlock() at the end. Use tryLock() when you would rather do
     * other work than wait.
     */
    #implementationPlatforms "libc", "amigaos", "morphos-ppc"
    native class Mutex() {
        import Am.Lang

        /**
         * Blocks until the calling thread holds the lock. A thread that already holds it returns
         * immediately and increments the hold count.
         */
        native fun lock()

        /**
         * Releases one hold on the lock. Call it exactly once for every successful lock() or tryLock().
         * Unlocking a mutex you do not hold is undefined behaviour — on AmigaOS it corrupts the
         * semaphore's wait queue rather than failing cleanly.
         */
        native fun unlock()

        /**
         * Takes the lock if it is free and returns immediately either way. A thread that already holds
         * the lock gets true straight away.
         * @return True if the lock is now held by the caller, who must unlock() it
         */
        native fun tryLock(): Bool
    }
}
