
namespace Am.Threading {

    // Mutual-exclusion primitive. Recursive — the same task may
    // call lock() N times and must call unlock() N times. Blocks
    // (does NOT spin) when another task holds the lock.
    //
    // Per platform:
    //   - libc        : pthread_mutex_t with PTHREAD_MUTEX_RECURSIVE
    //   - amigaos     : exec.library struct SignalSemaphore +
    //                   ObtainSemaphore / ReleaseSemaphore /
    //                   AttemptSemaphore. Recursive by design.
    //   - morphos-ppc : same as amigaos (exec-compatible).
    //
    // Usage pattern (manual — until the `lock { }` keyword lands):
    //
    //   var m = new Mutex()
    //   m.lock()
    //   try {
    //       // critical section
    //   } catch (e: Exception) {
    //       m.unlock()
    //       throw e
    //   }
    //   m.unlock()
    //
    // For non-blocking acquisition, use tryLock() which returns
    // true on success / false if another task currently holds it.
    //
    // See docs/LOCK_KEYWORD_DESIGN.md in am-lang-compiler-code for
    // the planned `lock(mutex) { }` / `lock { }` keyword sugar.
    #implementationPlatforms "libc", "amigaos", "morphos-ppc"
    native class Mutex() {
        import Am.Lang

        // Block until this mutex is acquired by the current task.
        // Recursive — a task already holding the mutex returns
        // immediately and increments the hold count.
        native fun lock()

        // Release one hold on this mutex. Must be called exactly
        // once per successful lock() / tryLock() that returned
        // true. Calling unlock() without a matching lock is
        // undefined behaviour on AmigaOS (the underlying
        // SignalSemaphore corrupts its wait queue).
        native fun unlock()

        // Non-blocking acquire. Returns true if the lock was
        // taken (caller must unlock() when done), false if
        // another task currently holds it. Recursive — returns
        // true immediately if the current task already holds it.
        native fun tryLock(): Bool
    }
}
