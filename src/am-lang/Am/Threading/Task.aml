namespace Am.Threading {

    // Queued unit of work — a thin wrapper around a `() => Bool`
    // lambda. The Bool return value is currently ignored (AmLang has
    // no `() => Void` lambda type, so we mirror the convention used
    // by listener fields throughout am-ui / am-mui).
    //
    // Why a wrapper class rather than queuing the lambda directly:
    //   * keeps TaskRunner.queue typed as List<Task>, not
    //     List<() => Bool> — the latter trips the renderer crash
    //     pattern around generic lists of function types.
    //   * gives `execute()` a single place to catch + log task
    //     exceptions so a bad task can't tear down the runner.
    //   * future: a Continuation handle for "await this task's
    //     completion / result" can hang off this object without
    //     touching the schedule() API again.
    class Task(var fn: () => Bool) {
        import Am.Lang

        // Run the wrapped lambda. Exceptions are caught and printed —
        // the runner loop never sees them, so one misbehaving task
        // does not stop subsequent tasks on the same worker.
        fun execute() {
            try {
                this.fn()
            } catch (e: Exception) {
                "TaskRunner: task threw, continuing".println()
                e.printWithStackTrace()
            }
        }
    }
}
