namespace Am.Threading {

    /**
     * One queued unit of work: a thin wrapper around a lambda, as handed to TaskScheduler. The
     * lambda's Bool result is ignored — it is there because AmLang has no void lambda type, the
     * same convention the UI listener fields use. The wrapper exists so the runner's queue can be a
     * list of ordinary objects rather than a list of function types, and so that exceptions can be
     * caught in one place: a task that throws is logged and the worker carries on with the next
     * one.
     */
    class Task(var fn: () => Bool) {
        import Am.Lang

        /**
         * Runs the wrapped lambda, catching and printing anything it throws so one misbehaving task
         * cannot stop the tasks queued behind it.
         */
        fun execute() {
            try {
                this.fn()
            } catch (e: Exception) {
                "TaskRunner: task threw, continuing".println()
                e.printWithStackTrace()
            }
        }
    }
}
