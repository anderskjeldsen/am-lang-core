/*
TODO: Make it as an interface
*/
namespace Am.IO
{
    native class FileStream(private var file: File, private var access: FileAccess) : Stream
    {
        import Am.Lang
        import Am.Collections

        native fun read(buffer: UByte[], offset: Long, length: UInt): UInt
        native fun write(buffer: UByte[], offset: Long, length: UInt)
        native fun seekFromStart(offset: Long)
        native fun readByte(): Int
        native fun writeByte(byte: Int)
        // Size of the OPEN file via the handle (fseek/ftell), NOT a path
        // stat() — cwd-independent, so it works even when a -noixemul child
        // has a mismatched libc cwd. readAll() uses this to always take the
        // fast bulk path. Returns 0 if the handle is unusable.
        native fun fileSize(): Long

        // Release the underlying OS file handle now, instead of waiting
        // for the runtime to release the FileStream object. Needed when
        // a writer and a reader of the same path coexist briefly inside
        // one process: on AmigaOS DOS the reader's fopen doesn't see
        // the writer's bytes cleanly until the writer's FILE* is gone.
        // Safe to call more than once; subsequent reads/writes after
        // close are undefined.
        native fun close()

        fun readAll(): UByte[] {
            // Bulk-read into a pre-sized buffer using the file's size —
            // reading byte-by-byte via readByte() is O(n) native calls and
            // is catastrophically slow for large files (e.g. multi-MB
            // packfiles). One or a few native read() calls fill the buffer
            // directly instead. Size comes from the open HANDLE (fileSize),
            // not a path stat, so it doesn't fail on a -noixemul child whose
            // libc cwd differs from its DOS current dir (which would drop us
            // into the byte-by-byte fallback — the ~500s pack read).
            var total = this.fileSize()
            if (total > 0L) {
                var buf = new UByte[total as UInt]
                var pos: Long = 0L
                while (pos < total) {
                    var remaining = (total - pos).toUInt()
                    var got = this.read(buf, pos, remaining)
                    if (got == 0UI) {
                        break
                    }
                    pos = pos + (got as Long)
                }
                return buf
            }

            // Size unavailable (0 / pipe / special file): fall back to a
            // chunked read that doesn't rely on a known length.
            var data = List<UByte>.newList<UByte>()
            var go = true
            while (go) {
                var b = this.readByte()
                if (b >= 0) {
                    data.add(b as UByte)
                } else {
                    go = false
                }
            }
            return data.toArray()
        }
    }
}
