namespace Am.IO
{
    /**
     * How a file should be opened, passed to the FileStream constructor. The six modes map onto
     * the familiar C ones: readOnly requires the file to exist and only reads ("r"); writeOnly
     * truncates an existing file or creates a new one ("w"); appendOnly writes at the end and
     * creates the file when missing ("a"); readWrite reads and writes an existing file without
     * truncating it ("r+"); readWriteTruncate reads and writes, creating the file or emptying it
     * first ("w+"); and readAppend reads and appends, creating the file when missing but keeping
     * existing content ("a+"). Pick the narrowest mode that does the job — reaching for
     * readWriteTruncate out of habit silently empties a file you meant to update.
     */
    enum FileAccess {
        import Am.Lang

        // Read only - file must exist (C mode: "r")
        readOnly = 1
        
        // Write only - truncates existing file or creates new (C mode: "w")
        writeOnly = 2
        
        // Append only - writes to end, creates if doesn't exist (C mode: "a")
        appendOnly = 3
        
        // Read and write - file must exist (C mode: "r+")
        readWrite = 4
        
        // Read and write - creates file if doesn't exist, truncates if exists (C mode: "w+")
        readWriteTruncate = 5
        
        // Read and append - creates if doesn't exist, preserves existing content (C mode: "a+")
        readAppend = 6
    }
}