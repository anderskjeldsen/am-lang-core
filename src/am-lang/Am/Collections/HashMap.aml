namespace Am.Collections {


    class HashMap<K, V>: Map<K, V> {
        import Am.Lang

        private var size: Int
        // High-water mark of entry slots allocated when no freed slot was
        // available to reuse. Freed slots are recycled through `freeHead`, so
        // this stays bounded to the peak LIVE entry count and never marches past
        // the backing arrays under add/remove churn.
        private var currentEntryIndex: Int
        // Head of the free-slot list (0 = empty, else slot+1). remove() pushes a
        // vacated entry slot here; privateSetKeyValue() pops one before extending
        // currentEntryIndex. Without this, remove reclaimed nothing and the map
        // overflowed / leaked under churn.
        private var freeHead: Int
        // Backing arrays eagerly initialised to zero-length so the field
        // declarations are honest about being non-null. The lazy-init
        // path in `set()` gates on `length() == 0` instead of the old
        // `== null` check; the storage materialises on first insert.
        private var nextIndexes: Int[] = new Int[0]
        private var keyIndexes: Int[] = new Int[0]
        private var keys: K[] = new K[0]
        private var values: V[] = new V[0]
        private var bucketSize: Int = 10
        private var currentIndex: Int

        static fun createWithInitialSize<K, V>(initialSize: Int): HashMap<K, V> {
            var map = new HashMap<K, V>()
            map.bucketSize = initialSize
            map.currentIndex = initialSize
            map.nextIndexes = new Int[initialSize]
            map.keys = new K[initialSize]
            map.values = new V[initialSize]
            map.keyIndexes = new Int[initialSize * 2]
            return map
        }

        fun getSize(): Int {
            return this.size
        }

        fun get(key: K): V {
            if (this.keyIndexes.length() == 0) {
                throw new KeyNotFoundException(key.toString())
            }
            var hash = key.hash()
            var index = hash % this.bucketSize
            var keyIndex = this.keyIndexes[index] - 1
            var entryIndex = this.findEntry(keyIndex, key)
            if (entryIndex >= 0) {
                return this.values[entryIndex]
            }
            throw new KeyNotFoundException(key.toString())
        }

        private fun findEntry(keyIndex: Int, key: K): Int {
            while(keyIndex > -1) {
                var key2 = this.keys[keyIndex]
                if (key2 == key) {
                    return keyIndex
                }
                keyIndex = this.nextIndexes[keyIndex] - 1
            }
            return -1
        }

        fun set(key: K, value: V) {
            if (this.nextIndexes.length() == 0) {
                this.bucketSize = 100
                this.nextIndexes = new Int[this.bucketSize]
                this.keys = new K[this.bucketSize]
                this.values = new V[this.bucketSize]
                this.keyIndexes = new Int[this.bucketSize * 2]
                this.currentIndex = this.bucketSize
            }

            // Grow at load factor 0.5 of LIVE entries. size is the correct (and
            // sole) trigger now that slots are recycled and resize walks only
            // live bucket chains; the old currentIndex/currentEntryIndex gates
            // both overflowed the arrays and (via resize) resurrected removed
            // keys once remove was used.
            if (this.size * 4 >= this.bucketSize * 2) {
                var oldKeyIndexes = this.keyIndexes
                var oldKeys = this.keys
                var oldValues = this.values
                var oldNextIndexes = this.nextIndexes
                var oldBucketSize = this.bucketSize

                var newBucketSize = this.bucketSize * 10
                this.bucketSize = newBucketSize
                this.currentIndex = newBucketSize
                this.currentEntryIndex = 0
                this.size = 0
                this.freeHead = 0

                this.nextIndexes = new Int[newBucketSize]
                this.keys = new K[newBucketSize]
                this.values = new V[newBucketSize]
                this.keyIndexes = new Int[newBucketSize * 2]

                // Re-insert LIVE entries only, by walking the old bucket chains.
                // Freed slots sit on the old free list, unreachable from any
                // bucket, so they are naturally skipped (no resurrection).
                var b = 0
                while (b < oldBucketSize) {
                    var ki = oldKeyIndexes[b] - 1
                    while (ki > -1) {
                        this.privateSetKeyValue(oldKeys[ki], oldValues[ki])
                        ki = oldNextIndexes[ki] - 1
                    }
                    b++
                }
            }

            this.privateSetKeyValue(key, value)
        }

        private fun privateSetKeyValue(key: K, value: V) {
            var hash = key.hash()
            var index = hash % this.bucketSize

            // Update existing value if the key is already present.
            var keyIndex = this.keyIndexes[index] - 1
            var existingIndex = this.findEntry(keyIndex, key)
            if (existingIndex >= 0) {
                this.values[existingIndex] = value
                return
            }

            // Allocate an entry slot: reuse a freed one if available, else extend.
            var slot = 0
            if (this.freeHead > 0) {
                slot = this.freeHead - 1
                this.freeHead = this.nextIndexes[slot]
            } else {
                slot = this.currentEntryIndex
                this.currentEntryIndex++
            }

            this.keys[slot] = key
            this.values[slot] = value

            keyIndex = this.keyIndexes[index] - 1 // current head of this bucket
            if (keyIndex < 0) {
                this.nextIndexes[slot] = 0
            } else {
                this.nextIndexes[slot] = keyIndex + 1 // chain to old head
                this.currentIndex++
            }
            this.keyIndexes[index] = slot + 1 // new head of the bucket
            this.size++
        }

        fun remove(key: K): Bool {
            if (this.keyIndexes.length() == 0) {
                return false
            }
            var hash = key.hash()
            var index = hash % this.bucketSize
            var keyIndex = this.keyIndexes[index] - 1

            if (keyIndex < 0) {
                return false
            }

            // First item in the chain?
            var firstKey = this.keys[keyIndex]
            if (firstKey == key) {
                var nextIndex = this.nextIndexes[keyIndex] - 1
                if (nextIndex >= 0) {
                    this.keyIndexes[index] = nextIndex + 1
                } else {
                    this.keyIndexes[index] = 0
                }
                this.freeSlot(keyIndex)
                this.size--
                return true
            }

            // Walk the chain.
            var previousIndex = keyIndex
            keyIndex = this.nextIndexes[keyIndex] - 1
            while(keyIndex > -1) {
                var key2 = this.keys[keyIndex]
                if (key2 == key) {
                    var nextIndex = this.nextIndexes[keyIndex] - 1
                    if (nextIndex >= 0) {
                        this.nextIndexes[previousIndex] = nextIndex + 1
                    } else {
                        this.nextIndexes[previousIndex] = 0
                    }
                    this.freeSlot(keyIndex)
                    this.size--
                    return true
                }
                previousIndex = keyIndex
                keyIndex = this.nextIndexes[keyIndex] - 1
            }
            return false
        }

        // Return an unlinked entry slot to the free list. Its nextIndexes cell is
        // repurposed as the free-list link; the slot is off every bucket chain,
        // so no lookup or bucket-walk visits it until it is handed back out.
        private fun freeSlot(slot: Int) {
            this.nextIndexes[slot] = this.freeHead
            this.freeHead = slot + 1
            // Drop the references to the removed key/value now, instead of
            // leaving them pinned in the backing arrays until this slot is
            // handed back out. default(K)/default(V) is null for object types
            // (0 for primitives), and is typed as K/V so it satisfies the
            // non-nullable arrays. Freed slots are never read before reuse.
            this.keys[slot] = default(K)
            this.values[slot] = default(V)
        }

        fun clear() {
            this.size = 0
            this.currentEntryIndex = 0
            this.currentIndex = this.bucketSize
            this.freeHead = 0
            if (this.keyIndexes.length() > 0) {
                var i = 0
                while(i < this.keyIndexes.length()) {
                    this.keyIndexes[i] = 0
                    i++
                }
            }
        }

        fun containsKey(key: K): Bool {
            if (this.keyIndexes.length() == 0) {
                return false
            }
            var hash = key.hash()
            var index = hash % this.bucketSize
            var keyIndex = this.keyIndexes[index] - 1
            var entryIndex = this.findEntry(keyIndex, key)
            return entryIndex >= 0
        }

        fun containsValue(value: V): Bool {
            if (this.keyIndexes.length() == 0) {
                return false
            }
            // Walk live bucket chains only — freed slots may hold stale values.
            var b = 0
            while (b < this.bucketSize) {
                var ki = this.keyIndexes[b] - 1
                while (ki > -1) {
                    var value2 = this.values[ki]
                    if (value2 == value) {
                        return true
                    }
                    ki = this.nextIndexes[ki] - 1
                }
                b++
            }
            return false
        }

        fun isEmpty(): Bool {
            return this.size == 0
        }

        // Same as "keys()" on other frameworks. 
        fun buildKeys(): List<K> {
            var keyList = List.newList<K>()
            if (this.keyIndexes.length() == 0) {
                return keyList
            }
            // Walk live bucket chains only — never the raw slot array, whose
            // freed slots can still hold stale keys.
            var b = 0
            while (b < this.bucketSize) {
                var ki = this.keyIndexes[b] - 1
                while (ki > -1) {
                    keyList.add(this.keys[ki])
                    ki = this.nextIndexes[ki] - 1
                }
                b++
            }
            return keyList
        }

        fun keys(): List<K> {
            return this.buildKeys()
        }
    }
}
