namespace Am.Collections {

    /**
     * A hash-based set of distinct values, for membership tests and de-duplication. Adding a value
     * that is already present does nothing, and has() is constant time on average, which makes
     * this far better than List.contains() when you test membership often. Element types need
     * hash() and equals() that agree. Iteration order is unspecified. Not synchronised.
     * One caveat worth knowing: remove() unlinks the value but does not recycle its slot, so a
     * long-lived set under heavy add/remove churn keeps growing its backing arrays; rebuild the
     * set periodically if that pattern applies to you.
     */
    class HashSet<T>: Set<T>, Iterable<T> {
        import Am.Lang

        /**
         * Number of distinct values held.
         */
        private var size: Int
        /**
         * Next free slot in the values array; only ever moves forward.
         */
        private var currentValueIndex: Int
        /**
         * Chain links between values sharing a bucket. Eagerly initialised to zero length so the
         * field declaration is honest about being non-null; the real storage materialises on the
         * first insert, which add() detects by checking the length rather than for null.
         */
        private var nextIndexes: Int[] = new Int[0]
        /**
         * Bucket heads: for each bucket, the slot index of its first value plus one, or 0 when the
         * bucket is empty.
         */
        private var valueIndexes: Int[] = new Int[0]
        /**
         * The values themselves, indexed by slot.
         */
        private var values: T[] = new T[0]
        /**
         * Number of buckets; a value's bucket is its hash modulo this.
         */
        private var bucketSize: Int
        /**
         * Counter of chained entries, used together with the load factor to decide when to grow.
         */
        private var currentIndex: Int

        /**
         * Returns the number of distinct values in the set.
         * @return The element count
         */
        fun getSize(): Int {
            return this.size
        }

        /**
         * Tests whether a value is in the set. Constant time on average.
         * @param value The value to look for
         * @return True if an equal value is present
         */
        fun has(value: T): Bool {
            if (this.valueIndexes.length() == 0) {
                return false
            }
            var hash = value.hash()
            var index = hash % this.bucketSize
            var valueIndex = this.valueIndexes[index] - 1
            var x = this.findEntry(valueIndex, value)
            if (x >= 0) {
                return true
            }
            return false
        }

        /**
         * Walks one bucket's chain looking for a value.
         * @param valueIndex Slot index of the first entry in the chain, or -1 for an empty bucket
         * @param value The value to find
         * @return The slot index holding the value, or -1 when it is not in the chain
         */
        private inline fun findEntry(valueIndex: Int, value: T): Int {
            while(valueIndex > -1) {
//                var valueIndex = this.valueIndexes[index] - 1
                var value2 = this.values[valueIndex]
                if (value2 == value) {
                    return valueIndex
                }
                valueIndex = this.nextIndexes[valueIndex] - 1                
            }
            return -1
        }

        /**
         * Adds a value if it is not already present. The backing arrays are allocated on the first add
         * and grown when the set passes half full, which rehashes everything.
         * @param value The value to add
         */
        fun add(value: T) {
            if (this.nextIndexes.length() == 0) {
                this.bucketSize = 1024
                this.nextIndexes = new Int[this.bucketSize]
                this.values = new T[this.bucketSize]
                this.valueIndexes = new Int[this.bucketSize]
                this.currentIndex = this.bucketSize
            }

            if ( this.size * 4 >= this.bucketSize * 2 || this.currentIndex >= (this.bucketSize * 2) ) {
                var valueLastIndex = this.currentValueIndex
                var oldValues = this.values
                var newBucketSize = this.bucketSize * 4
                this.bucketSize = newBucketSize
                this.currentIndex = newBucketSize
                this.currentValueIndex = 0
                this.size = 0

                this.nextIndexes = new Int[newBucketSize]
                this.values = new T[newBucketSize]
                this.valueIndexes = new Int[newBucketSize]
//                ("create new bucket in HashSet: " + this.bucketSize.toString() + ", copy " + valueLastIndex.toString() + " items").println()

                var i = 0
                while(i < valueLastIndex) {
                    var oldValue = oldValues[i]
                    this.privateSetValue(oldValue)
                    i++
                }       
            }

            this.privateSetValue(value)
        }

        /**
         * Inserts a value without considering growth, ignoring it when an equal value is already
         * present. Used both by add() and by the rehash loop.
         * @param value The value to insert
         */
        private fun privateSetValue(value: T) {
            var hash = value.hash()
            var index = hash % this.bucketSize

            var valueIndex = this.valueIndexes[index] - 1 // index of values and next arrays
            
            // Check if value already exists
            var existingIndex = this.findEntry(valueIndex, value)
            if (existingIndex >= 0) {
                // Value already exists, don't add it again (Set behavior)
                return
            }

            this.values[this.currentValueIndex] = value
//            this.nextIndexes[this.currentValueIndex] = 0

            if (valueIndex < 0) {
                this.valueIndexes[index] = this.currentValueIndex + 1 // cause all are initially set to 0, then a real 0 will be 1
                this.nextIndexes[this.currentValueIndex] = 0
                this.size++            
            } 
            else {        
//                {v: x, n: 0}          
//              {v: y, n: x}
//                this.valueIndexes[this.currentIndex] = valueIndex + 1 // append new index to the value at the end
//                this.nextIndexes[this.currentValueIndex] = this.nextIndexes[valueIndex] // append new index to the next value at the end

                this.valueIndexes[index] = this.currentValueIndex + 1
                this.nextIndexes[this.currentValueIndex] = valueIndex + 1 // old value
                this.currentIndex++
                this.size++
            }
            this.currentValueIndex++
        }
        /**
         * Tests whether a value is in the set; an alias for has() that matches the naming used by List.
         * @param value The value to look for
         * @return True if an equal value is present
         */
        fun contains(value: T): Bool {
            return this.has(value)
        }

        /**
         * Tests whether the set holds no values.
         * @return True when the set is empty
         */
        fun isEmpty(): Bool {
            return this.size == 0
        }

        /**
         * Removes a value from the set. The slot it occupied is not returned to a free list, so heavy
         * add/remove churn grows the backing arrays over time.
         * @param value The value to remove
         * @return True if the value was present and removed
         */
        fun remove(value: T): Bool {
            if (this.valueIndexes.length() == 0) {
                return false
            }
            var hash = value.hash()
            var index = hash % this.bucketSize
            var valueIndex = this.valueIndexes[index] - 1
            
            if (valueIndex < 0) {
                return false
            }
            
            // Check if it's the first item in the chain
            var firstValue = this.values[valueIndex]
            if (firstValue == value) {
                // Remove first item - update bucket to point to next
                var nextIndex = this.nextIndexes[valueIndex] - 1
                if (nextIndex >= 0) {
                    this.valueIndexes[index] = nextIndex + 1
                } else {
                    this.valueIndexes[index] = 0
                }
                this.size--
                return true
            }
            
            // Look for item in the chain
            var previousIndex = valueIndex
            valueIndex = this.nextIndexes[valueIndex] - 1
            while(valueIndex > -1) {
                var value2 = this.values[valueIndex]
                if (value2 == value) {
                    // Remove item by updating previous to point to next
                    var nextIndex = this.nextIndexes[valueIndex] - 1
                    if (nextIndex >= 0) {
                        this.nextIndexes[previousIndex] = nextIndex + 1
                    } else {
                        this.nextIndexes[previousIndex] = 0
                    }
                    this.size--
                    return true
                }
                previousIndex = valueIndex
                valueIndex = this.nextIndexes[valueIndex] - 1
            }
            return false
        }

        /**
         * Removes every value, keeping the allocated capacity.
         */
        fun clear() {
            this.size = 0
            this.currentValueIndex = 0
            this.currentIndex = this.bucketSize
            if (this.valueIndexes.length() > 0) {
                var i = 0
                while(i < this.valueIndexes.length()) {
                    this.valueIndexes[i] = 0
                    i++
                }
            }
        }

        /**
         * Returns a fresh iterator over the values, in unspecified order. This is what `each` uses; do
         * not add to or remove from the set while iterating.
         * @return An iterator over the values
         */
        fun iterator(): Iterator<T> {
            if (this.valueIndexes.length() == 0) {
                return new HashSetIterator<T>(new Int[0], new Int[0], this.values, 0)
            }
            return new HashSetIterator<T>(this.valueIndexes, this.nextIndexes, this.values, this.bucketSize)
        }

        /**
         * Copies the values into a new array sized exactly to the set, in unspecified order.
         * @return A new array holding the values
         */
        fun toArray(): T[] {
            if (this.size == 0) {
                return new T[0]
            }
            var arr = new T[this.size]
            var arrIndex = 0
            
            // Iterate through all bucket indices
            var bucketIndex = 0
            while(bucketIndex < this.bucketSize && arrIndex < this.size) {
                var valueIndex = this.valueIndexes[bucketIndex] - 1
                while((valueIndex > -1) && (arrIndex < this.size)) {
                    arr[arrIndex] = this.values[valueIndex]
                    arrIndex++
                    valueIndex = this.nextIndexes[valueIndex] - 1
                }
                bucketIndex++
            }
            return arr
        }
    }
}