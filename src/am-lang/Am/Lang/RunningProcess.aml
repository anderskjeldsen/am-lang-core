namespace Am.Lang
{
    #implementationPlatforms "libc", "amigaos", "morphos-ppc", "aros-arm64"
    /**
     * A handle to a child process running asynchronously with a pseudo-terminal attached, as
     * returned by Process.start, Process.startBinary and Process.startWithReportedSize. The
     * child sees what looks like a real console: it blocks reading stdin until you feed it bytes
     * with writeInput(), and everything it writes comes back through tryReadOutput(). Reads never
     * block, so drive it from a loop that polls, does its other work, and sleeps briefly. A
     * typical lifecycle is: var p = Process.start("bebbossh user@host", "amStudio:") then loop
     * while (p.isAlive() || p.tryReadOutput().length() > 0) doing Thread.sleep(20L), and finally
     * p.close(). close() is safe to call at any time and happens automatically when the handle is
     * released, so an explicit call is only needed to free the child early.
     */
    native class RunningProcess {
        import Am.Lang

        /**
         * Spawns the child and the console handler behind it. Called by the Process.start family
         * after the handle is created; there is no reason to call it yourself.
         * @param command The command line to execute
         * @param workingDir Directory to run in, or an empty string for the current one
         * @throws Exception if the handler or the child process cannot be created
         */
        native fun startNative(command: String, workingDir: String)

        /**
         * Reads whatever output has arrived since the last call, without blocking. Returns an
         * empty string when nothing is queued, which is the normal case most of the time. After
         * the child has exited and its final output has been drained this keeps returning empty,
         * so pair it with isAlive() to decide when to stop polling.
         * @return The output collected so far, or an empty string
         */
        native fun tryReadOutput(): String

        /**
         * Sends text to the child's standard input verbatim. Most programs expect line-buffered
         * input, so append a newline yourself. Writing after close() does nothing.
         * @param text The text to send
         */
        native fun writeInput(text: String)

        /**
         * Reads whatever bytes have arrived, without blocking — the binary counterpart of
         * tryReadOutput(), for processes started with Process.startBinary. Use this when the
         * stream carries arbitrary bytes, because the String-based read truncates at the first
         * NUL and would corrupt, say, a git packfile.
         * @return The bytes available now, or an empty array
         */
        native fun tryReadOutputBytes(): UByte[]

        /**
         * Writes raw bytes to the child's standard input, with no encoding or terminal
         * translation. The binary counterpart of writeInput().
         * @param data The buffer to write from
         * @param offset Index of the first byte to write
         * @param length Number of bytes to write
         * @return The number of bytes actually accepted
         */
        native fun writeInputBytes(data: UByte[], offset: Long, length: UInt): UInt

        /**
         * Switches this handle into binary mode, which must happen before the child is spawned —
         * Process.startBinary does it for you. On the libc platforms it swaps the cooked
         * pseudo-terminal for a raw socket pair; on AmigaOS it tells the console handler not to
         * intercept the terminal-size probe, so no bytes are ever swallowed from the stream.
         */
        native fun enableBinaryMode()

        /**
         * Tests whether the child is still running. It may report true once more after the child
         * has exited, while the last of its output is still being drained.
         * @return True while the child is alive
         */
        native fun isAlive(): Bool

        /**
         * Returns the child's exit status. Only meaningful once isAlive() has returned false;
         * while the child is still running this returns 0.
         * @return The exit code of the finished child
         */
        native fun exitCode(): Int

        /**
         * Tests whether the child has switched its input to raw mode, the equivalent of a Unix
         * terminal turning off echo and line discipline. While this is true a terminal view should
         * pass keystrokes through one character at a time, without local echo, translating special
         * keys to escape sequences; when it goes back to false, return to line-buffered input. The
         * call is cheap enough to read on every paint or keyboard tick.
         * @return True while the child has stdin in raw mode
         */
        native fun isRawMode(): Bool

        /**
         * Sets the terminal dimensions reported to the child when it queries the console size. Call
         * this when your terminal view is created or resized so the remote side matches the local
         * viewport. Defaults to 24 rows by 80 columns until called; to have the very first query
         * answered correctly, start the child with Process.startWithReportedSize instead.
         * @param rows Terminal height in character rows
         * @param cols Terminal width in character columns
         */
        native fun setReportedSize(rows: Int, cols: Int)

        /**
         * Terminates the child if it is still running and tears down the console handler behind
         * it. Idempotent, and called automatically when the handle is released, so you only need
         * it to free things early. To stop a live child from a user action, prefer
         * terminateChild(): closing out from under a running child on AmigaOS tears down the
         * handler while the child may still issue calls through it.
         */
        native fun close()

        /**
         * Asks the child to stop, and returns immediately. On AmigaOS this signals the child the
         * way Ctrl-C does, letting it exit on its own terms; the handle is then reaped by the
         * normal isAlive() polling. This is the right call for a user-initiated stop while the
         * child is alive.
         */
        native fun terminateChild()

        /**
         * Registers a task and signal bit to be signalled whenever any child writes output, so an
         * event loop that is blocked waiting for input wakes immediately on streaming output
         * instead of relying on a timer. Pass the values from your window's user port, and pass a
         * taskPtr of 0 to disable it again.
         * @param taskPtr Pointer to the task to signal
         * @param sigBit The signal bit to set on that task
         */
        native static fun setGlobalWake(taskPtr: Long, sigBit: Int)

        /**
         * Terminates every console handler this program has spawned and waits briefly for each to
         * exit. This has to happen before the program's code is unloaded, because a handler still
         * alive afterwards would execute freed memory the next time it was dispatched. It runs
         * automatically at exit, so application code does not need to call it.
         */
        native static fun shutdownAllNative()

        /**
         * Exit hook that shuts down any handlers still running. Registered by the compiler through
         * the #runOnExit directive; the generated call is not blocked by `private`.
         */
        #runOnExit
        private static fun shutdownAllOnExit() {
            RunningProcess.shutdownAllNative()
        }
    }
}
