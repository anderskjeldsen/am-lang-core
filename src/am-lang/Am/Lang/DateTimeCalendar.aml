namespace Am.Lang {
    /** Native implementation detail behind DateTime's signed calendar API. */
    #implementationPlatforms "libc"
    native class DateTimeCalendar {
        static native fun parts(milliseconds: Long, zone: String, output: Int[]): Bool
        static native fun compose(year: Long, month: Long, day: Long, hour: Long, minute: Long, second: Long, millisecond: Long, zone: String, output: Long[]): Bool
        static native fun parse(text: String, output: Long[]): Bool
        static native fun zoneName(zone: String): String
        static native fun abbreviation(milliseconds: Long, zone: String): String
        static native fun zones(): String
    }
}
