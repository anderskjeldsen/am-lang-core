
namespace Am.Lang 
{
    /**
     * A 32-bit unsigned integer, range 0 to 4294967295. Used throughout the core library for
     * sizes, hashes and string indices. Literals need a UI suffix, as in 0UI — writing a plain
     * 0 where a UInt is expected is a common source of type errors. Subtracting past zero wraps
     * to a huge value rather than going negative, so compare before subtracting.
     */
    primitive native class UInt {
        /**
         * Formats the value as decimal text.
         * @return The value as a String
         */
        override native fun toString(): String
        /**
         * Returns a hash of the value so it can be used as a HashMap or HashSet key.
         * @return The hash value
         */
        override native fun hash(): UInt
        /**
         * Converts this UInt value to a Byte (8-bit signed).
         * The target type is narrower, so values that do not fit are truncated.
         * @return The value as a Byte
         */
        native fun toByte(): Byte
        /**
         * Converts this UInt value to a Short (16-bit signed).
         * The target type is narrower, so values that do not fit are truncated.
         * @return The value as a Short
         */
        native fun toShort(): Short
        /**
         * Converts this UInt value to a Long (64-bit signed).
         * Signed and unsigned differ here, so out-of-range values are reinterpreted rather than clamped.
         * @return The value as a Long
         */
        native fun toLong(): Long
        /**
         * Converts this UInt value to a UByte (8-bit unsigned).
         * The target type is narrower, so values that do not fit are truncated.
         * @return The value as a UByte
         */
        native fun toUByte(): UByte
        /**
         * Converts this UInt value to a UShort (16-bit unsigned).
         * The target type is narrower, so values that do not fit are truncated.
         * @return The value as a UShort
         */
        native fun toUShort(): UShort
        /**
         * Converts this UInt value to a Int (32-bit signed).
         * Signed and unsigned differ here, so out-of-range values are reinterpreted rather than clamped.
         * @return The value as a Int
         */
        native fun toInt(): Int
        /**
         * Converts this UInt value to a ULong (64-bit unsigned).
         * @return The value as a ULong
         */
        native fun toULong(): ULong
        #require floatingPoint
        /**
         * Converts this UInt value to a Float (32-bit floating-point).
         * @return The value as a Float
         */
        native fun toFloat(): Float
        #require floatingPoint
        /**
         * Converts this UInt value to a Double (64-bit floating-point).
         * @return The value as a Double
         */
        native fun toDouble(): Double
        /**
         * Converts to a Bool, where zero is false and any other value is true.
         * @return True when the value is not zero
         */
        native fun toBool(): Bool

        /**
         * Parses decimal text into a UInt.
         * @param s The text to parse
         * @return The parsed value
         */
        static native fun parse(s: String): UInt

        /**
         * The largest value a UInt can hold.
         */
        static const var maxValue: UInt = 0xffffffffUI
        /**
         * The smallest value a UInt can hold.
         */
        static const var minValue: UInt = 0x00000000UI

        /**
         * Returns the smaller of two values.
         * @param a The first value
         * @param b The second value
         * @return a if it is less than b, otherwise b
         */
        static static fun min(a: UInt, b: UInt): UInt {
            if (a < b) {
                return a
            }
            return b
        }

        /**
         * Returns the larger of two values.
         * @param a The first value
         * @param b The second value
         * @return a if it is greater than b, otherwise b
         */
        static static fun max(a: UInt, b: UInt): UInt {
            if (a > b) {
                return a
            }
            return b
        }

    }
}

