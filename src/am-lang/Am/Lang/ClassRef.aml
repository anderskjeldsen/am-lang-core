namespace Am.Lang 
{
    /**
     * One property of a reflected class (see ClassRef.getProperties()): its name, its slot, its
     * declared type and whether it was declared nullable, plus reading and writing it on an
     * instance. Values travel as Any: a primitive slot reads as the boxed primitive, an object
     * slot as the object or null.
     */
    native class PropertyInfo {
        private var name: String? = null
        private var index: UInt = 0UI
        private var nullable: Bool = false

        /**
         * Returns the property's name as declared.
         * @return The name
         */
        fun getName(): String {
            return this.name
        }

        /**
         * Returns the property's slot index within the instance.
         * @return The slot index
         */
        fun getIndex(): UInt {
            return this.index
        }

        /**
         * Tells whether the property was declared nullable (`T?`).
         * @return True for a nullable declaration
         */
        fun isNullable(): Bool {
            return this.nullable
        }

        /**
         * Returns the ClassRef of the property's DECLARED type: for `var items: List<Person>` the
         * List<Person> variant, whose type arguments are then available through
         * ClassRef.getTypeArguments(). The runtime type of a value may be a subclass of it.
         * @return The declared type's ClassRef
         */
        native fun getPropertyClassRef(): ClassRef

        /**
         * Reads the property from an instance of the declaring class.
         * @param target The instance to read
         * @return The value: a boxed primitive, an object, or null
         */
        native fun getValue(target: Object): Any

        /**
         * Writes the property on an instance of the declaring class. A primitive slot accepts any
         * numeric primitive and converts it; an object slot takes the object or null.
         * @param target The instance to write
         * @param value The new value
         */
        native fun setValue(target: Object, value: Any)
    }

    /**
     * Describes a class at run time. Every value answers getClassRef() with the ClassRef of its
     * class, which always carries the class name; a class marked `#reflect` (and every class in
     * its closure: base classes, property types with their type arguments, and subclasses) also
     * exposes its properties, can be found by name and can be instantiated. That is what a
     * serializer needs to walk and rebuild an object graph without knowing the types in advance.
     * ClassRefs are shared by all threads and live for the whole program.
     */
    native class ClassRef
    {
        import Am.Collections

        private var className: String? = null
        private var properties: Array<PropertyInfo>? = null
        private var reflected: Bool = false

        /**
         * Finds a reflected class by its full name, for example "Shop.Order" or
         * "Am.Collections.List_ta_Shop.Order" for a generic variant.
         * @param name The class name
         * @return The ClassRef, or null when no class of that name is reflected
         */
        native static fun getClassRef(name: String): ClassRef?

        /**
         * Finds the reflected class named by a type argument.
         * @return The ClassRef, or null when T is not reflected
         */
        static fun getClassRefFromClass<T>(): ClassRef? {
            return ClassRef.getClassRef(nameof(T))
        }

        /**
         * Returns the ClassRef of a value's run-time class - what getClassRef() on the value does.
         * @param any The value
         * @return Its class
         */
        native static fun getClassRefFromAny(any: Any): ClassRef

        /**
         * Tells whether the class carries reflection data (properties, instantiation). A class
         * that does not still has a name.
         * @return True for a `#reflect` class or one in a reflected closure
         */
        fun isReflected(): Bool {
            return this.reflected
        }

        /**
         * Returns the full class name; a generic variant includes its type arguments.
         * @return The class name
         */
        fun getClassName(): String {
            return this.className
        }

        /**
         * Returns the instance properties in slot order, base classes first. Throws when the
         * class is not reflected.
         * @return The properties
         */
        fun getProperties(): PropertyInfo[] {
            this.ensureProperties()
            return this.properties
        }

        private native fun ensureProperties()

        /**
         * Finds an instance property by name.
         * @param name The property name
         * @return The property, or null
         */
        fun getProperty(name: String): PropertyInfo? {
            var props = this.getProperties()
            var i = 0UI
            while (i < props.length()) {
                var p = props[i]
                if (p.getName() == name) {
                    return p
                }
                i++
            }
            return null
        }

        /**
         * Returns the type arguments of a generic variant (List<Person> gives [Person]); empty
         * for a non-generic class.
         * @return The type arguments' ClassRefs
         */
        native fun getTypeArguments(): ClassRef[]

        /**
         * Creates an instance of a reflected class without running its constructor: the object
         * is allocated and its property defaults applied, constructor parameters start null and
         * are expected to be set through PropertyInfo.setValue(). Throws for a class that is not
         * reflected.
         * @return The new instance
         */
        native fun newInstance(): Object

        /**
         * Calls an instance method of a reflected class by name. The arguments are converted to
         * the method's declared parameter types, numeric primitives included; the return value
         * comes back as Any (null for a method that returns nothing), and an exception thrown by
         * the method propagates. Overloads are matched by name and argument count, so two
         * overloads taking the same number of arguments are not distinguishable here.
         * @param target The instance to call on; its run-time class is searched, then its bases
         * @param name The method name
         * @param args The arguments, in order
         * @return The method's return value, or null
         */
        native static fun invoke(target: Object, name: String, args: Any[]): Any

        /**
         * Creates an array of the given array type (`Int[]`, `Person[]` - the ClassRef of the
         * Array variant, as PropertyInfo.getPropertyClassRef() returns for an array property).
         * @param arrayType The array variant's ClassRef
         * @param length The number of elements, zero/null-filled
         * @return The array
         */
        native static fun newArray(arrayType: ClassRef, length: Int): Object

        /**
         * Returns the length of any array given as an Object.
         * @param array The array
         * @return Its length
         */
        native static fun arrayLength(array: Object): Int

        /**
         * Reads an element of any array given as an Object.
         * @param array The array
         * @param index The element index
         * @return The element as Any
         */
        native static fun arrayGet(array: Object, index: Int): Any

        /**
         * Writes an element of any array given as an Object; numeric primitives are converted to
         * the element type.
         * @param array The array
         * @param index The element index
         * @param value The new element
         */
        native static fun arraySet(array: Object, index: Int, value: Any)

        override fun toString(): String {
            return this.className
        }
    }
}
