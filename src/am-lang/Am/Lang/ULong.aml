
namespace Am.Lang 
{
    /**
     * A 64-bit unsigned integer, range 0 to 18446744073709551615. Literals take a UL suffix, as
     * in 0UL. As with UInt, subtraction past zero wraps rather than going negative.
     */
    primitive native class ULong {
        /**
         * Formats the value as decimal text.
         * @return The value as a String
         */
        override native fun toString(): String
        /**
         * Returns a hash of the value so it can be used as a HashMap or HashSet key.
         * @return The hash value
         */
        override native fun hash(): UInt
        /**
         * Converts this ULong value to a Byte (8-bit signed).
         * The target type is narrower, so values that do not fit are truncated.
         * @return The value as a Byte
         */
        native fun toByte(): Byte
        /**
         * Converts this ULong value to a Short (16-bit signed).
         * The target type is narrower, so values that do not fit are truncated.
         * @return The value as a Short
         */
        native fun toShort(): Short
        /**
         * Converts this ULong value to a Int (32-bit signed).
         * The target type is narrower, so values that do not fit are truncated.
         * @return The value as a Int
         */
        native fun toInt(): Int
        /**
         * Converts this ULong value to a Long (64-bit signed).
         * Signed and unsigned differ here, so out-of-range values are reinterpreted rather than clamped.
         * @return The value as a Long
         */
        native fun toLong(): Long
        /**
         * Converts this ULong value to a UByte (8-bit unsigned).
         * The target type is narrower, so values that do not fit are truncated.
         * @return The value as a UByte
         */
        native fun toUByte(): UByte
        /**
         * Converts this ULong value to a UShort (16-bit unsigned).
         * The target type is narrower, so values that do not fit are truncated.
         * @return The value as a UShort
         */
        native fun toUShort(): UShort
        /**
         * Converts this ULong value to a UInt (32-bit unsigned).
         * The target type is narrower, so values that do not fit are truncated.
         * @return The value as a UInt
         */
        native fun toUInt(): UInt
        #require floatingPoint
        /**
         * Converts this ULong value to a Float (32-bit floating-point).
         * @return The value as a Float
         */
        native fun toFloat(): Float
        #require floatingPoint
        /**
         * Converts this ULong value to a Double (64-bit floating-point).
         * @return The value as a Double
         */
        native fun toDouble(): Double
        /**
         * Converts to a Bool, where zero is false and any other value is true.
         * @return True when the value is not zero
         */
        native fun toBool(): Bool

        /**
         * Parses decimal text into a ULong.
         * @param s The text to parse
         * @return The parsed value
         */
        static native fun parse(s: String): ULong

        /**
         * The largest value a ULong can hold.
         */
        static const var maxValue: ULong = 0xffffffffffffffffUL
        /**
         * The smallest value a ULong can hold.
         */
        static const var minValue: ULong = 0x0000000000000000UL

        /**
         * Returns the smaller of two values.
         * @param a The first value
         * @param b The second value
         * @return a if it is less than b, otherwise b
         */
        static fun min(a: ULong, b: ULong): ULong {
            if (a < b) {
                return a
            }
            return b
        }

        /**
         * Returns the larger of two values.
         * @param a The first value
         * @param b The second value
         * @return a if it is greater than b, otherwise b
         */
        static fun max(a: ULong, b: ULong): ULong {
            if (a > b) {
                return a
            }
            return b
        }        
    }
}

