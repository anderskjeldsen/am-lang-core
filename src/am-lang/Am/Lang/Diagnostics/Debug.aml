namespace Am.Lang.Diagnostics {
    /**
     * Switches for the compiler's optional runtime logging. The logging itself only exists in a
     * binary built with the runtime-logging options (-rl and friends); in an ordinary build
     * these calls are harmless no-ops.
     */
    native class Debug {
        import Am.Lang

        /**
         * Turns conditional runtime logging on or off at runtime, so you can narrow the output to
         * the section of code you are actually investigating instead of logging the whole run.
         * @param on True to start logging, false to stop
         */
        #noThrow
        native static fun setConditionalLogging(on: Bool)

        /**
         * Formats one packed exception stack-trace site into the human-readable frame text
         * ("... in class X on line N" and friends). Called lazily by Exception when a trace is
         * read; generated unwinding code stores only the packed pair.
         * @param cls The site's aclass pointer as a Long (0 is formatted as "?")
         * @param lineKind The site's source line * 8 + kind (0 pass, 1 throw, 2 suspend child, 3 resumed, 4 allocation failed)
         * @return The formatted frame line
         */
        native static fun formatExceptionSite(cls: Long, lineKind: Long): String
    }
}
