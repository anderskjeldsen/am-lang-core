/*
//        native fun operator<Long, T>[]
//        native fun operator<Long> []:T

*/

namespace Am.Lang
{
    /**
     * A fixed-length, indexed block of values of one type, written T[] in source, as in
     * String[] or UByte[]. Arrays are the low-level storage the collections are built on: the
     * length is fixed at creation, indexing is bounds-checked and throws on an out-of-range
     * index, and element access is direct with no boxing. Reach for List when you need to grow
     * or shrink, and for an array when the size is known and you want the cheapest possible
     * access. Iterate with `each`, or with a while loop over length() in hot code.
     */
    native class Array<T>()
    {
        import Am.Lang
        import Am.Collections
        /**
         * Returns the number of elements the array was created with.
         * @return The element count
         */
        #noThrow
        native fun length(): UInt

        /**
         * Copies a range into a new array of the same element type. As with String.substring, the
         * second argument is a LENGTH rather than an end index. Reading past the end of the source
         * array throws.
         * @param offset Zero-based index of the first element to copy
         * @param length Number of elements to copy
         * @return A new array holding the copied elements
         */
        fun subArray(offset: UInt, length: UInt): T[] {
            var newArray = this.createEmptyArrayOfSameType(length)
            this.copyTo(newArray, 0UI, offset, length)
            return newArray
        }

        /**
         * Copies `length` elements from this array, starting at `srcOffset`, into `dest`,
         * starting at `destOffset`. Both ranges must lie fully inside their arrays or the call
         * throws IndexOutOfBoundsException before copying anything. `dest` may be this same
         * array with overlapping ranges - the copy behaves as if it went through a temporary
         * (like C's memmove), so shifting elements up or down within one array is safe.
         *
         * This is the bulk-copy primitive: for primitive element types (UByte, Int, ...) it is
         * a single native memory move instead of a per-element loop with a bounds check and a
         * function call per element - byte-heavy code (network buffers, hashing, file I/O)
         * should build on it. Object elements keep correct reference counts: every copied
         * reference is retained and every overwritten destination reference is released,
         * exactly as per-element assignment would have done.
         * @param dest The array to copy into (may be this array)
         * @param destOffset Zero-based index in dest of the first element written
         * @param srcOffset Zero-based index in this array of the first element read
         * @param length Number of elements to copy
         * @throws IndexOutOfBoundsException if either range reaches outside its array
         */
        fun copyTo(dest: T[], destOffset: UInt, srcOffset: UInt, length: UInt) {
            if (length == 0UI) {
                return
            }
            var srcLen = this.length()
            if (length > srcLen || srcOffset > srcLen - length) {
                throw new IndexOutOfBoundsException((srcOffset + length).toInt(), srcLen)
            }
            var dstLen = dest.length()
            if (length > dstLen || destOffset > dstLen - length) {
                throw new IndexOutOfBoundsException((destOffset + length).toInt(), dstLen)
            }
            this.copyToNative(dest, destOffset, srcOffset, length)
        }

        private native fun copyToNative(dest: T[], destOffset: UInt, srcOffset: UInt, length: UInt)

        /**
         * Allocates an uninitialised array with this array's element type, used by subArray to
         * build its result without knowing T at runtime.
         * @param length Number of elements to allocate
         * @return The new array
         */
        private native fun createEmptyArrayOfSameType(length: UInt): T[]

        /**
         * Returns an iterator over the elements in index order, which is what lets an array be
         * the subject of an each loop. Arrays are fixed-length, so the iterator never sees a
         * resize; the usual caveat about not writing to the array while iterating still applies.
         * @return An iterator positioned before the first element
         */
        fun iterator(): Iterator<T> {
            return new ArrayIterator<T>(this) as Iterator<T>
        }
    }
}
