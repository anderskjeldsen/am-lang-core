namespace Am.Lang
{
    #implementationPlatforms "libc", "amigaos", "morphos-ppc"
    native class Process
    {
        import Am.Lang

        // Execute a shell command and return its exit code.
        static native fun run(command: String): Int

        // Execute a shell command and return its stdout output as a String.
        static native fun runAndCaptureOutput(command: String): String

        // Same as runAndCaptureOutput, but with the process's current
        // working directory temporarily set to `workingDir` for the
        // duration of the command. The previous CWD is restored on
        // return (including on error). Use this instead of prefixing
        // commands with "cd ..." — the AmigaOS shell treats `;` as a
        // comment so a chained cd doesn't actually move the shell.
        // An empty `workingDir` behaves exactly like runAndCaptureOutput.
        static native fun runAndCaptureOutputInDir(command: String, workingDir: String): String

        // Resolve `path` to its OS-canonical form. On AmigaOS /
        // MorphOS this means "DH0:Tools/" becomes "Workbench:Tools/"
        // (i.e. device name → mounted volume name) via Lock +
        // NameFromLock. On libc it returns the realpath; if the path
        // can't be resolved (doesn't exist, permission denied) the
        // original input is returned unchanged so the caller still
        // has something usable.
        static native fun canonicalPath(path: String): String

        // The process's current working directory. On AmigaOS /
        // MorphOS this is the lock the IDE was launched with
        // (NameFromLock of pr_CurrentDir); on libc it's getcwd().
        // Returns "" if the OS can't resolve a name — the caller
        // should treat empty as "unknown" rather than as a path.
        static native fun getCwd(): String
    }
}
