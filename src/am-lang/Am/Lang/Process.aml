namespace Am.Lang
{
    #implementationPlatforms "libc", "amigaos", "morphos-ppc"
    native class Process
    {
        import Am.Lang

        // Execute a shell command and return its exit code.
        static native fun run(command: String): Int

        // Execute a shell command and return its stdout output as a String.
        static native fun runAndCaptureOutput(command: String): String

        // Same as runAndCaptureOutput, but with the process's current
        // working directory temporarily set to `workingDir` for the
        // duration of the command. The previous CWD is restored on
        // return (including on error). Use this instead of prefixing
        // commands with "cd ..." — the AmigaOS shell treats `;` as a
        // comment so a chained cd doesn't actually move the shell.
        // An empty `workingDir` behaves exactly like runAndCaptureOutput.
        static native fun runAndCaptureOutputInDir(command: String, workingDir: String): String

        // Resolve `path` to its OS-canonical form. On AmigaOS /
        // MorphOS this means "DH0:Tools/" becomes "Workbench:Tools/"
        // (i.e. device name → mounted volume name) via Lock +
        // NameFromLock. On libc it returns the realpath; if the path
        // can't be resolved (doesn't exist, permission denied) the
        // original input is returned unchanged so the caller still
        // has something usable.
        static native fun canonicalPath(path: String): String

        // The process's current working directory. On AmigaOS /
        // MorphOS this is the lock the IDE was launched with
        // (NameFromLock of pr_CurrentDir); on libc it's getcwd().
        // Returns "" if the OS can't resolve a name — the caller
        // should treat empty as "unknown" rather than as a path.
        static native fun getCwd(): String

        // Spawn `command` asynchronously with piped stdin/stdout.
        // Returns a [[RunningProcess]] handle the caller polls for
        // output and writes to for stdin. Use this for interactive
        // programs (ssh, REPLs, anything that prompts the user) —
        // runAndCaptureOutput blocks until the child exits and gives
        // it a NULL stdin, which won't work for password prompts.
        // `workingDir` empty means "current dir".
        static fun start(command: String, workingDir: String): RunningProcess {
            var p = new RunningProcess()
            p.startNative(command, workingDir)
            return p
        }

        // Same as `start` but lets the caller pre-set the terminal
        // dimensions the handler reports to the child's getConsoleSize
        // probe. Bebbossh / nano query that probe very early during
        // init — before the AmLang main task gets a turn to call
        // setReportedSize() — so without this they see the rp_state
        // default (24x80) and the remote PTY is sized to that. Pass
        // the CliView's grid dimensions here so the first probe
        // already has the right answer.
        static fun startWithReportedSize(
            command: String, workingDir: String,
            rows: Int, cols: Int): RunningProcess {
            var p = new RunningProcess()
            // First setReportedSize stashes the dims on the per-
            // process data (amiga backend uses these to seed the
            // freshly-allocated rp_state, which is what bebbossh's
            // early getConsoleSize probe reads). On libc this is
            // a no-op (no PTY master fd yet) — the SECOND call
            // below ioctls TIOCSWINSZ once the master exists.
            p.setReportedSize(rows, cols)
            p.startNative(command, workingDir)
            // Apply again post-spawn — needed on libc to actually
            // hit TIOCSWINSZ. Harmless on amiga (same value).
            p.setReportedSize(rows, cols)
            return p
        }
    }
}
