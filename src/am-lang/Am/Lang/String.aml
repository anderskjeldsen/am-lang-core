
namespace Am.Lang 
{
    /**
     * An immutable sequence of characters, backed by the C runtime. Every method that appears
     * to modify a string returns a new one instead. Build strings piecewise with StringBuilder
     * rather than repeated concatenation. Two things commonly trip up newcomers: substring
     * takes a start and a LENGTH (not an end index), and the ordering operators < and > compare
     * references rather than text, so use equals() for comparisons and write your own loop if
     * you need lexicographic ordering.
     */
    native class String {
        import Am.Collections
        import Am.IO

        /**
         * Returns a content-derived hash, so equal strings hash equally and String works as a
         * HashMap or HashSet key.
         * @return The hash value
         */
        #noThrow
        override native fun hash(): UInt
        /**
         * Returns the string itself.
         * @return This string
         */
        override fun toString(): String {
            return this
        }
        /**
         * Returns the length of the string in characters — UTF-16 code units, the same count Java
         * and JavaScript report. This is the index space characterAt(), substring() and indexOf()
         * work in, so it is the length to pair with them.
         *
         * Pre-calculated when the string is built, so it is a field read and safe as a loop bound.
         * Use byteLength() when you need the storage size — for a buffer, a file offset or a
         * protocol field. The two agree for ASCII and diverge the moment they do not.
         * @return The character count
         */
        #noThrow
        native fun getLength(): Int
        /**
         * Returns the length of the string in characters; an alias for getLength().
         * @return The character count
         */
        #nativeEntry
        fun length(): Int {
            return this.getLength()
        }
        /**
         * Returns the length of the string in bytes of UTF-8. The explicit name for what
         * getLength() and length() report, for code that wants to be unambiguous about the unit.
         * @return The byte count
         */
        #noThrow
        native fun byteLength(): Int
        /**
         * Returns the number of UTF-16 code units — the explicit name for what getLength() and
         * length() report, for code that wants to be unambiguous about the unit.
         *
         * Characters outside the Basic Multilingual Plane count as two, because they take a
         * surrogate pair.
         * @return The character count
         */
        #noThrow
        native fun charLength(): Int
        /**
         * Tests whether the string has no characters. Note this is a length test only — a string
         * of spaces is not empty.
         * @return True if the length is zero
         */
        fun isEmpty(): Bool {
            return this.getLength() == 0
        }
        /**
         * Writes the string to standard output without a trailing newline. Use println() when you
         * want the line terminator.
         */
        #noThrow
        native fun print()
        /**
         * Compares this string with another object by content. Passing a null reference throws, so
         * narrow a nullable String to a non-null local before calling this.
         * @param other The object to compare with
         * @return True if other is a String with the same characters
         */
        #nativeEntry
        #noThrow
        native override fun equals(other: Object): Bool
        /**
         * Concatenates two strings into a new string. Each + allocates, so prefer StringBuilder
         * inside loops.
         * @param s The string to append
         * @return A new string holding both operands
         */
        #noThrow
        native op + (s: String): String
        /**
         * Decodes a byte array into a string using the named encoding, for example "UTF-8". This
         * is the counterpart of toBytes and the usual way to turn bytes read from a Stream into
         * text.
         * @param bytes The bytes to decode
         * @param encoding Name of the character encoding
         * @return The decoded string
         */
        native static fun fromBytes(bytes: UByte[], encoding: String): String
        /**
         * Encodes this string into bytes using the named encoding, for example "UTF-8".
         * @param encoding Name of the character encoding
         * @return The encoded bytes
         */
        native fun toBytes(encoding: String): UByte[]
        /**
         * Finds the first occurrence of a substring.
         * @param s The substring to search for
         * @return The zero-based index of the first match, or -1 if there is none
         */
        #nativeEntry
        #noThrow
        native fun indexOf(s: String): Int
        /**
         * Finds the last occurrence of a substring.
         * @param s The substring to search for
         * @return The zero-based index of the last match, or -1 if there is none
         */
        #nativeEntry
        #noThrow
        native fun lastIndexOf(s: String): Int
        /**
         * Extracts a range of characters. The second argument is a LENGTH, not an end index —
         * passing an end index throws. Use substringToEnd when you want everything from a
         * position onwards.
         *
         * Both arguments count CHARACTERS, matching getLength() and characterAt(), so a range can
         * never split a multi-byte character. Splitting a surrogate pair — only reachable with
         * astral text and a hand-computed index — throws rather than producing a broken sequence.
         * @param start Zero-based character index of the first character to take
         * @param length Number of characters to take
         * @return The extracted substring
         */
        #nativeEntry
        native fun substring(start: UInt, length: UInt): String
        
        /**
         * Returns everything from a position to the end of the string, or an empty string if the
         * position is at or past the end. Safer than computing a length yourself for substring().
         * @param start Zero-based index of the first character to take
         * @return The remainder of the string
         */
        fun substringToEnd(start: UInt): String {
            var totalLength = this.getLength().toUInt()
            if (start >= totalLength) {
                return ""
            }
            var remainingLength = totalLength - start
            return this.substring(start, remainingLength)
        }
        
        /**
         * Finds the first occurrence of a substring at or after a starting position; the building
         * block for scanning a string repeatedly.
         * @param s The substring to search for
         * @param startIndex Zero-based index to start searching from
         * @return The index of the first match, or -1 if there is none or the arguments are out of range
         */
        fun indexOfAfter(s: String, startIndex: Int): Int {
            var searchText = this
            var searchLen = searchText.getLength()
            var patternLen = s.getLength()
            
            if (startIndex < 0 || startIndex >= searchLen || patternLen == 0) {
                return -1
            }
            
            var i = startIndex
            while (i <= (searchLen - patternLen)) {
                var found = true
                var j = 0
                while (j < patternLen) {
                    if (searchText.characterAt((i + j).toUInt()) != s.characterAt(j.toUInt())) {
                        found = false
                        break
                    }
                    j++
                }
                if (found) {
                    return i
                }
                i++
            }
            return -1
        }

        /**
         * Unchecked character read used by characterAt() once the index has been validated.
         * @param index Zero-based character index
         * @return The character code at that index
         */
        #nativeEntry
        native private fun characterAtNative(index: UInt): UShort
        /**
         * Returns the character at a position as a UTF-16 code unit, for example 65US for 'A'.
         * Compare the result against character-code literals such as 32US.
         *
         * The index counts CHARACTERS, not bytes, so it pairs with getLength(). For ASCII the two
         * are the same number and this is a single load; for anything else the string decodes once
         * into a cached UTF-16 view and indexes that, so a loop over characterAt() stays linear
         * rather than going quadratic.
         *
         * A character outside the Basic Multilingual Plane occupies two positions — a surrogate
         * pair — exactly as in Java and JavaScript. Use getChars() when you want the whole string
         * as an array.
         * @param index Zero-based character index
         * @return The UTF-16 code unit at that index
         * @throws IndexOutOfBoundsException if the index is at or past the end of the string
         */
        fun characterAt(index: UInt): UShort {
            if (index >= this.getLength().toUInt()) {
                throw new IndexOutOfBoundsException(index.toInt(), this.length().toUInt())
            }
            return this.characterAtNative(index)
        }

        /**
         * Decodes the string into UTF-16 code units — what Java and JavaScript call chars.
         *
         * This is the counterpart to characterAt(), which indexes BYTES and so only agrees with a
         * character index for ASCII. Decode once with getChars() and index the array in O(1)
         * afterwards; that is the efficient way to walk text by character, and the only correct
         * way once the text is not ASCII.
         *
         * Characters outside the Basic Multilingual Plane occupy two units (a surrogate pair), so
         * the array length equals charLength() rather than the number of characters. Malformed
         * UTF-8 decodes to U+FFFD instead of throwing, so this never fails on bytes that arrived
         * from a file or a socket.
         *
         *     var chars = text.getChars()
         *     var i = 0
         *     while (i < chars.length().toInt()) { ... chars[i] ... i++ }
         *
         * @return The string as UTF-16 code units
         */
        native fun getChars(): UShort[]

        /**
         * Returns the character at a position as a UTF-16 code unit — the JavaScript name for
         * characterAt(), which it simply forwards to.
         * @param index Zero-based character index
         * @return The UTF-16 code unit at that index
         * @throws IndexOutOfBoundsException if the index is at or past the end of the string
         */
        fun codeUnitAt(index: UInt): UShort {
            return this.characterAt(index)
        }

        /**
         * Tests whether the string ends with a suffix. An empty suffix always matches, and a
         * suffix longer than the string never does.
         * @param s The suffix to look for
         * @return True if the string ends with s
         */
        fun endsWith(s: String): Bool {
            var suffixLength = s.getLength()
            var totalLength = this.getLength()

            // An empty suffix should always return true
            if (suffixLength == 0) {
                return true
            }

            // A suffix longer than the string cannot be a suffix. This guard is
            // load-bearing: without it the subtraction below goes negative, and
            // the old toUInt() wrapped it to 4294967295, which compared equal to
            // lastIndexOf's -1 "not found" result. That made "".endsWith(x) — and
            // every other too-short receiver — answer true.
            if (suffixLength > totalLength) {
                return false
            }

            return this.lastIndexOf(s) == totalLength - suffixLength
        }

        /**
         * Splits the string on a single separator character given as a code, for example 44US for a
         * comma. Consecutive separators yield empty entries, but a trailing separator does not add
         * an empty entry at the end. Use splitByString to split on a multi-character separator.
         * @param character The separator character code
         * @return The pieces between separators
         */
        fun split(character: UShort): String[] {
            var result = List<String>.newList<String>()
            var sb = new StringBuilder()
            var len = this.getLength()
            var i = 0UI
            while(i < len) {
                var c = this.characterAt(i)
                if (c == character) {
                    result.add(sb.toString())
                    sb.clear()
                } else {
                    sb.addChar(c)
                }
                i++
            }
            if (sb.getLength() > 0) {
                result.add(sb.toString())
            }
            return result.toArray()
        }
        
        /**
         * Splits the string on a multi-character separator. Empty pieces are preserved, including a
         * trailing empty piece when the string ends with the separator. An empty separator returns
         * the original string as the only element.
         * @param separator The separator to split on
         * @return The pieces between separators
         */
        fun splitByString(separator: String): String[] {
            var result = List<String>.newList<String>()
            var separatorLen = separator.getLength()
            
            if (separatorLen == 0) {
                // If separator is empty, return array with original string
                result.add(this)
                return result.toArray()
            }
            
            var lastIndex = 0
            var currentIndex = this.indexOf(separator)
            
            while (currentIndex >= 0) {
                // Add the substring before the separator
                var partLength = (currentIndex - lastIndex).toUInt()
                if (partLength > 0UI) {
                    result.add(this.substring(lastIndex.toUInt(), partLength))
                } else {
                    result.add("")
                }
                
                // Move past the separator
                lastIndex = currentIndex + separatorLen
                currentIndex = this.indexOfAfter(separator, lastIndex)
            }
            
            // Add the remaining part after the last separator
            var remainingLength = (this.getLength() - lastIndex).toUInt()
            if (remainingLength > 0UI) {
                result.add(this.substring(lastIndex.toUInt(), remainingLength))
            } else {
                result.add("")
            }
            
            return result.toArray()
        }

        /**
         * Writes the string followed by a newline to standard output. This is the idiomatic way to
         * print in AmLang: call it on the string itself, as in "hello".println().
         */
        fun println() {
            var s = this + "\n"
            s.print()
        }

        /**
         * Returns a copy with ASCII letters a-z folded to upper case. Bytes outside that range,
         * including accented and non-Latin characters, are copied unchanged.
         * @return The upper-cased string
         */
        fun toUpperCase(): String {
            var sb = new StringBuilder()
            var len = this.getLength()
            var i = 0UI
            while(i < len) {
                var c = this.characterAt(i)
                // Convert lowercase letters to uppercase
                if (c >= 97US && c <= 122US) { // 'a' to 'z'
                    var upperC = c - 32US // Convert to uppercase
                    sb.addChar(upperC)
                } else {
                    sb.addChar(c)
                }
                i++
            }
            return sb.toString()
        }

        /**
         * Returns a copy with ASCII letters A-Z folded to lower case. Bytes outside that range,
         * including accented and non-Latin characters, are copied unchanged.
         * @return The lower-cased string
         */
        fun toLowerCase(): String {
            var sb = new StringBuilder()
            var len = this.getLength()
            var i = 0UI
            while(i < len) {
                var c = this.characterAt(i)
                // Convert uppercase letters to lowercase
                if (c >= 65US && c <= 90US) { // 'A' to 'Z'
                    var lowerC = c + 32US // Convert to lowercase
                    sb.addChar(lowerC)
                } else {
                    sb.addChar(c)
                }
                i++
            }
            return sb.toString()
        }

        /**
         * Returns a copy without leading and trailing whitespace, where whitespace means space,
         * tab, line feed or carriage return. A string that is entirely whitespace trims to an empty
         * string.
         * @return The trimmed string
         */
        fun trim(): String {
            var len = this.getLength().toUInt()
            if (len == 0UI) {
                return this
            }
            
            // Find start index (skip whitespace from beginning)
            var start = 0UI
            while(start < len) {
                var c = this.characterAt(start)
                if (c != 32US && c != 9US && c != 10US && c != 13US) { // space, tab, newline, carriage return
                    break
                }
                start++
            }
            
            // If all characters are whitespace
            if (start == len) {
                return ""
            }
            
            // Find end index (skip whitespace from end)
            var end = len - 1UI
            while(end > start) {
                var c = this.characterAt(end)
                if (c != 32US && c != 9US && c != 10US && c != 13US) { // space, tab, newline, carriage return
                    break
                }
                end--
            }
            
            // Return substring without leading/trailing whitespace
            // Break down the calculation to avoid operator precedence issues
            var lengthPart = end - start
            var trimmedLength = lengthPart + 1UI
            return this.substring(start, trimmedLength)
        }
        
        /**
         * Tests whether the string begins with a prefix. An empty prefix always matches.
         * @param prefix The prefix to look for
         * @return True if the string starts with prefix
         */
        fun startsWith(prefix: String): Bool {
            var prefixLen = prefix.getLength().toUInt()
            var thisLen = this.getLength().toUInt()
            
            // Empty prefix should always return true
            if (prefixLen == 0UI) {
                return true
            }
            
            // If prefix is longer than this string, it cannot be a prefix
            if (prefixLen > thisLen) {
                return false
            }
            
            // Check each character
            var i = 0UI
            while(i < prefixLen) {
                if (this.characterAt(i) != prefix.characterAt(i)) {
                    return false
                }
                i++
            }
            
            return true
        }
        
        // File operations
        /**
         * Writes this string to a file, truncating any existing contents. Convenience wrapper over
         * File, FileStream and TextStream for one-shot writes.
         * @param filename Path of the file to write
         */
        fun writeToFile(filename: String) {
            var file = new File(filename)
            var fileStream = new FileStream(file, FileAccess.readWriteTruncate)
            var textStream = new TextStream(fileStream)
            textStream.writeString(this)
        }
        
        /**
         * Reads an entire file into a string. Convenience wrapper over File, FileStream and
         * TextStream; the whole file is held in memory, so prefer a TextStream for large files.
         * @param filename Path of the file to read
         * @return The file contents
         */
        static fun readFromFile(filename: String): String {
            var file = new File(filename)
            var fileStream = new FileStream(file, FileAccess.readOnly)
            var textStream = new TextStream(fileStream)
            return textStream.readString()
        }
        
        /**
         * Joins an array of strings, placing the separator between adjacent elements. The inverse
         * of split / splitByString.
         * @param strings The strings to join
         * @param separator Text to insert between elements
         * @return The joined string, or an empty string when the array is empty
         */
        static fun join(strings: String[], separator: String): String {
            if (strings.length() == 0) {
                return ""
            }
            
            if (strings.length() == 1) {
                return strings[0]
            }
            
            var sb = new StringBuilder()
            var i = 0
            var maxIndex = strings.length() - 1UI
            
            while (i <= maxIndex) {
                sb.add(strings[i])
                if (i < maxIndex) {
                    sb.add(separator)
                }
                i++
            }
            
            return sb.toString()
        }
    }
}

