namespace OomShutdown {

    // Out of memory shuts the program down (Redmine #446). Each mode runs out
    // of memory somewhere, through the test hook Arc.failAllocationsAfter, and
    // run.sh checks the exit code, the message, and which #runOnExit hooks
    // wrote their marker file (oom-first-<mode>.txt, oom-second-<mode>.txt):
    //   normal               no failure: exit 0, both hooks
    //   main                 main runs out: exit 1 (20 on AmigaOS), both hooks
    //   main-sticky          main runs out and keeps failing: the shutdown runs
    //                        out too, so the hooks are skipped
    //   shutdown             the first exit hook runs out: the second is skipped
    //   worker               a worker runs out while main waits in join() and
    //                        other workers sleep, wait in receive() and join()
    //   worker-main-receive  ... while main waits in receive()
    //   worker-main-busy     ... while main allocates in a loop
    //   busy                 ... while another worker spins without a stop
    //                        point: main gives up on it after the join timeout
    //   send                 main runs out in the middle of Thread.send's
    //                        deep copy (the copy must put main's object list
    //                        back before the shutdown sweeps it)
    //   late                 main has already returned; a worker runs out
    //                        while an exit hook joins another, healthy worker:
    //                        the join still waits for it (exit 0: main's own
    //                        run had succeeded)
    // Open files in the frames the jump skips (Redmine #447). Files.openAndFail
    // writes through a nested stream (TextStream over BinaryStream over a
    // FileStream) held only by locals, and through a FileStream in a cycle of
    // two Holders, builds a 20000-node list, then runs out of memory without
    // closing either:
    //   main-file            main runs out: its final heap release closes them
    //                        (run.sh checks the data reached the files; on
    //                        AmigaOS that they can be deleted, i.e. no lock)
    //   main-sticky-file     ... and every allocation fails from then on
    //   worker-file          a worker runs out: its teardown closes them, so
    //                        the first exit hook can read them back

    class Box(var n: Int) {
        import Am.Lang
    }

    class Holder(var name: String, var stream: Stream?, var other: Holder?) {
        import Am.Lang
        import Am.IO
    }

    class Files {
        import Am.Lang
        import Am.IO
        import Am.Lang.Diagnostics

        static fun name(mode: String, n: Int): String {
            return "oom-data-${mode}-${n}.txt"
        }

        static fun openAndFail(mode: String, sticky: Bool) {
            var fs = new FileStream(new File(Files.name(mode, 1)), FileAccess.writeOnly)
            var nested = new TextStream(new BinaryStream(fs))
            nested.writeString("nested ${mode}")
            var a = new Holder("a", null, null)
            var b = new Holder("b", new FileStream(new File(Files.name(mode, 2)), FileAccess.writeOnly), a)
            a.other = b
            var inCycle = new TextStream(b.stream!!)
            inCycle.writeString("cycle ${mode}")
            // A long list a local holds: marking it and releasing it must not
            // recurse as deep as it is long (an AmigaOS stack is small).
            var head = new Chain(0, null)
            var tail = head
            for (i = 1 until 20000) {
                var c = new Chain(i, null)
                tail.next = c
                tail = c
            }
            Arc.failAllocationsAfter(0, sticky)
            var x = new Box(4)
            "files: not reached ${x.n}".println()
        }

        static fun readBack(mode: String, n: Int) {
            var stream = new FileStream(new File(Files.name(mode, n)), FileAccess.readOnly)
            var ts = new TextStream(stream)
            var text = ts.readString()
            stream.close()
            "read back ${n}: ${text}".println()
        }
    }

    class FileOomer : Runnable {
        import Am.Lang
        import Am.Threading
        override fun run() {
            Thread.sleep(300L)
            Files.openAndFail("worker-file", false)
        }
    }

    class Settings {
        import Am.Lang
        import Am.Threading
        static var mode: String = "normal"
        static var slow: Thread? = null
        static var keep: Chain? = null
    }

    class Chain(var n: Int, var next: Chain?) {
        import Am.Lang
    }

    class Slow : Runnable {
        import Am.Lang
        import Am.Threading
        override fun run() {
            Thread.sleep(1500L)
            "slow: finished".println()
        }
    }

    class LateOomer : Runnable {
        import Am.Lang
        import Am.Threading
        import Am.Lang.Diagnostics
        override fun run() {
            Thread.sleep(400L)
            Arc.failAllocationsAfter(0, false)
            var b = new Box(3)
            "late oomer: not reached ${b.n}".println()
        }
    }

    // Exit hooks: the normal shutdown sequence must run after out of memory.
    class Hooks {
        import Am.Lang
        import Am.IO
        import Am.Lang.Diagnostics

        static fun writeMarker(name: String, text: String) {
            var stream = new FileStream(new File(name), FileAccess.writeOnly)
            var ts = new TextStream(stream)
            ts.writeString(text)
            stream.close()
        }

        #runOnExit
        static fun first() {
            Hooks.writeMarker("oom-first-${Settings.mode}.txt", "first hook ran in mode ${Settings.mode}")
            if (Settings.mode == "worker-file") {
                // The worker's teardown has closed the files it left open.
                Files.readBack("worker-file", 1)
                Files.readBack("worker-file", 2)
            }
            if (Settings.mode == "late") {
                "hook: joining slow".println()
                Settings.slow!!.join()
                "hook: join returned".println()
            }
            if (Settings.mode == "shutdown") {
                // Out of memory inside the shutdown itself: every allocation from here fails.
                Arc.failAllocationsAfter(0, true)
                var b = new Box(1)
                "not reached ${b.n}".println()
            }
        }

        #runOnExit(10)
        static fun second() {
            Hooks.writeMarker("oom-second-${Settings.mode}.txt", "second hook ran in mode ${Settings.mode}")
        }
    }

    class Sleeper : Runnable {
        import Am.Lang
        import Am.Threading
        override fun run() {
            while (true) {
                Thread.sleep(100L)
            }
        }
    }

    class Receiver : Runnable {
        import Am.Lang
        import Am.Threading
        override fun run() {
            var m = Thread.receive()
            "receiver got a message".println()
        }
    }

    class Joiner(var other: Thread) : Runnable {
        import Am.Lang
        import Am.Threading
        override fun run() {
            this.other.join()
            "joiner: join returned".println()
        }
    }

    class Busy : Runnable {
        import Am.Lang
        override fun run() {
            var i = 0
            while (true) {
                i = i + 1
            }
        }
    }

    class Oomer(var sticky: Bool) : Runnable {
        import Am.Lang
        import Am.Threading
        import Am.Lang.Diagnostics
        override fun run() {
            Thread.sleep(300L)
            "oomer: failing allocations".println()
            Arc.failAllocationsAfter(0, this.sticky)
            var b = new Box(2)
            "oomer: not reached ${b.n}".println()
        }
    }

    class Program {
        import Am.Lang
        import Am.Threading
        import Am.Lang.Diagnostics

        static fun start(r: Runnable, name: String): Thread {
            var t = new Thread(r)
            t.name = name
            t.start()
            return t
        }

        static fun main(args: String[]) {
            if (args.length() > 0) {
                Settings.mode = args[0]
            }
            var mode = Settings.mode
            "mode ${mode}".println()
            if (mode == "main" || mode == "main-sticky") {
                var list = new Box(0)
                Arc.failAllocationsAfter(3, mode == "main-sticky")
                for (i = 0 to 10) {
                    list = new Box(i)
                    "allocated ${i}".println()
                }
                "main: not reached".println()
            } else if (mode == "worker" || mode == "busy") {
                var sleeper = Program.start(new Sleeper(), "sleeper")
                var receiver = Program.start(new Receiver(), "receiver")
                var joiner = Program.start(new Joiner(receiver), "joiner")
                if (mode == "busy") {
                    Program.start(new Busy(), "busy")
                }
                Program.start(new Oomer(false), "oomer")
                "main: joining the receiver".println()
                receiver.join()
                "main: not reached".println()
            } else if (mode == "worker-main-receive") {
                var sleeper = Program.start(new Sleeper(), "sleeper")
                Program.start(new Oomer(true), "oomer")
                var m = Thread.receive()
                "main: not reached".println()
            } else if (mode == "worker-main-busy") {
                // Main never blocks: it sees the request at its next allocation.
                Program.start(new Oomer(false), "oomer")
                var n = 0
                while (true) {
                    var b = new Box(n)
                    n = n + 1
                }
            } else if (mode == "send") {
                var receiver = Program.start(new Receiver(), "receiver")
                var g = new Chain(1, new Chain(2, new Chain(3, null)))
                Settings.keep = new Chain(9, null)
                Arc.failAllocationsAfter(1, false)
                receiver.send(g)
                "main: not reached".println()
            } else if (mode == "main-file" || mode == "main-sticky-file") {
                Files.openAndFail(mode, mode == "main-sticky-file")
            } else if (mode == "worker-file") {
                var sleeper = Program.start(new Sleeper(), "sleeper")
                var t = Program.start(new FileOomer(), "file-oomer")
                t.join()
                "main: not reached".println()
            } else if (mode == "late") {
                Settings.slow = Program.start(new Slow(), "slow")
                Program.start(new LateOomer(), "late-oomer")
                "main: returning".println()
            } else {
                "normal run".println()
            }
        }
    }
}
