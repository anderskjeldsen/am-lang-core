namespace TestsV1 {

    // Redmine #516: a nullable enum out of a `List<Color?>` into an Any, the one
    // way v2 doesn't compile yet (a nullable type argument names a class
    // `List_ta_Color?`; true for `List<Int?>` too). The rest is
    // am-lang-core/tests/AnyNullableEnumTests.aml. v1 keeps the enum's tag.

    enum NaColor {
        import Am.Lang

        red = 1
        green = 2
    }

    class NaHolder {
        import Am.Lang
        import Am.Collections

        var opt: NaColor?
        var list: List<NaColor?>

        init {
            this.list = new List<NaColor?>()
        }

        fun maybe(give: Bool): NaColor? {
            if (give) {
                return NaColor.green
            }
            return null
        }
    }

    class NullableEnumAnyV1Tests {
        import Am.Lang
        import Am.Collections
        import Am.Tests

        static fun kind(a: Any): String {
            if (a == null) {
                return "null"
            }
            if (a is NaColor) {
                return "color"
            }
            if (a is Int) {
                return "int"
            }
            return "else"
        }

        test listOfOptionalElementIntoAny() {
            var h = new NaHolder()
            h.list.add(NaColor.green)
            h.list.add(null)
            Assert.assertEquals("color", NullableEnumAnyV1Tests.kind(h.list.get(0)))
            Assert.assertEquals("null", NullableEnumAnyV1Tests.kind(h.list.get(1)))
            var la = new List<Any>()
            la.add(h.list.get(0))
            la.add(h.list.get(1))
            la.add(1)
            Assert.assertEquals("color", NullableEnumAnyV1Tests.kind(la.get(0)))
            Assert.assertEquals("null", NullableEnumAnyV1Tests.kind(la.get(1)))
            Assert.assertEquals("int", NullableEnumAnyV1Tests.kind(la.get(2)))
            Assert.assertEquals("2", la.get(0).toString())
        }
    }
}
