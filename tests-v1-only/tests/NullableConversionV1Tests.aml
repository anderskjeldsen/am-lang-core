namespace TestsV1 {

    // Redmine #571 (return, assignment and property store): v2 still passes the
    // Int box on unchanged there (its argument conversion landed in #565/#566),
    // so these cases are v1-only until v2 converts them.

    class NcvV1Holder {
        import Am.Lang

        var stored: Long? = null

        static fun describe(l: Long?): String {
            if (l == null) { return "n" }
            return l!!.toString()
        }

        static fun asLong(q: Int?): Long? {
            return q
        }

        fun keep(q: Int?) {
            this.stored = q
        }
    }

    class NullableConversionV1Tests {
        import Am.Lang
        import Am.Tests

        test intToLongReturn() {
            var q: Int? = -5
            Assert.assertEquals("-5", NcvV1Holder.describe(NcvV1Holder.asLong(q)))
            var n: Int? = null
            Assert.assertEquals("n", NcvV1Holder.describe(NcvV1Holder.asLong(n)))
        }

        test intToLongAssignment() {
            var q: Int? = -5
            var l: Long? = q
            Assert.assertEquals("-5", NcvV1Holder.describe(l))
            var m: Long? = 99
            m = q
            Assert.assertEquals("-5", NcvV1Holder.describe(m))
            var n: Int? = null
            m = n
            Assert.assertEquals("n", NcvV1Holder.describe(m))
        }

        test intToLongPropertyAssignment() {
            var h = new NcvV1Holder()
            var q: Int? = -5
            h.keep(q)
            Assert.assertEquals("-5", NcvV1Holder.describe(h.stored))
            var n: Int? = null
            h.keep(n)
            Assert.assertEquals("n", NcvV1Holder.describe(h.stored))
        }
    }
}
