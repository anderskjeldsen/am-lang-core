namespace Tests {

    // Redmine #420, the cases v2 can't run yet (see V2_PORT_PLAN.md): v2
    // emits no null check for a property read through a null object or a
    // method call on a null `String?`, and
    // segfaults on `as String` from an Any holding an Int. The rest are in
    // tests/NothrowInferenceTests.aml.
    class NothrowInferenceV1Node {
        import Am.Lang
        var v: Int = 1
    }

    class NothrowInferenceV1Tests {
        import Am.Lang
        import Am.Tests

        static fun nullableObjectMember(node: NothrowInferenceV1Node?): Int {
            return node.v
        }

        static fun nullableStringMember(s: String?): Int {
            return s.length()
        }

        static fun cast(a: Any): String {
            return a as String
        }

        test aPropertyReadThroughANullObjectReachesTheCaller() {
            var caught = false
            try {
                NothrowInferenceV1Tests.nullableObjectMember(null)
            } catch (e: Exception) {
                caught = true
            }
            Assert.assertTrue(caught)
            Assert.assertEquals(1, NothrowInferenceV1Tests.nullableObjectMember(new NothrowInferenceV1Node()))
        }

        test aMethodCallOnANullStringReachesTheCaller() {
            var caught = false
            try {
                NothrowInferenceV1Tests.nullableStringMember(null)
            } catch (e: Exception) {
                caught = true
            }
            Assert.assertTrue(caught)
            Assert.assertEquals(2, NothrowInferenceV1Tests.nullableStringMember("ab"))
        }

        test aFailedCastReachesTheCaller() {
            var caught = false
            try {
                NothrowInferenceV1Tests.cast(5)
            } catch (e: Exception) {
                caught = true
            }
            Assert.assertTrue(caught)
            Assert.assertEquals("s", NothrowInferenceV1Tests.cast("s"))
        }
    }
}
