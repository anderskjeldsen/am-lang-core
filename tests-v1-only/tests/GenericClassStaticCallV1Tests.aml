namespace TestsV1 {

    // Redmine #568: a bare call in a STATIC function of a generic class
    // (`return plain(xs)` in GsBox<U>) stopped v1's renderer with "Collection is
    // empty" (it looked for a plain variant of the class, which a generic class
    // doesn't have). v2 can't compile a non-generic static function of a generic
    // class at all yet (an undeclared `<M>_GsBox_f_plain_0_T` function-pointer
    // type), so these live here; see V2_PORT_PLAN.md.

    class GsBox<U>(var item: U) {
        import Am.Lang
        import Am.Collections

        static fun plain(xs: List<Int>): Int {
            return xs.getSize()
        }

        static fun lenOf<T>(xs: List<T>): Int {
            return xs.getSize()
        }

        static fun viaPlain(xs: List<Int>): Int {
            return plain(xs)
        }

        static fun viaGeneric(xs: List<Int>): Int {
            return lenOf<Int>(xs)
        }

        static fun inOperators(xs: List<Int>): Int {
            return 10 + lenOf<Int>(xs) + plain(xs)
        }

        static fun qualifiedAndBare(xs: List<Int>): Int {
            return GsBox<U>.lenOf<Int>(xs) + lenOf<Int>(xs)
        }
    }

    class GenericClassStaticCallV1Tests {
        import Am.Lang
        import Am.Collections
        import Am.Tests

        test bareCallsInStaticFunctionOfGenericClass() {
            var l = new List<Int>()
            l.add(1)
            l.add(2)
            Assert.assertEquals(2, GsBox<String>.viaPlain(l))
            Assert.assertEquals(2, GsBox<String>.viaGeneric(l))
            Assert.assertEquals(14, GsBox<Int>.inOperators(l))
            Assert.assertEquals(4, GsBox<String>.qualifiedAndBare(l))
            Assert.assertEquals("2", GsBox<String>.viaGeneric(l).toString())
        }
    }
}
