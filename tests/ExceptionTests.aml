namespace Tests {

    // An exception with a field of its own, for the catch-variable test.
    class FieldException(var field: String) : Exception("bad " + field) {
        import Am.Lang
    }

    // An exception class whose property initializer reads a primary-constructor
    // parameter (#480): `throw new` must run the constructor first, as `new` does.
    class CodedException(var code: Int) : Exception("coded") {
        import Am.Lang

        var text: String = "code " + this.code.toString()
        var doubled: Int = this.code * 2
    }

    class ExceptionTests {
        import Am.Lang
        import Am.Collections
        import Am.Tests
        
        // #480
        test throwNewRunsConstructorBeforeInitializers() {
            var text = ""
            var doubled = 0
            var code = 0
            try {
                throw new CodedException(21)
            } catch (e: CodedException) {
                text = e.text
                doubled = e.doubled
                code = e.code
            }
            Assert.assertEquals("code 21", text)
            Assert.assertEquals(42, doubled)
            Assert.assertEquals(21, code)
        }

        // #480: the same class built with `new` and thrown later agrees.
        test throwNewAgreesWithNew() {
            var viaNew = new CodedException(5)
            var text = ""
            try {
                throw new CodedException(5)
            } catch (e: CodedException) {
                text = e.text
            }
            Assert.assertEquals(viaNew.text, text)
        }

        test throwAndCatch() {
            var caught = false
            try {
                throw new Exception("Test exception")
            } catch(e: Exception) {
                caught = true
            }
            
            Assert.assertTrue(caught)
        }
        
        test exceptionMessage() {
            var message = ""
            try {
                throw new Exception("Custom message")
            } catch(e: Exception) {
                message = e.message
            }
            
            Assert.assertEquals("Custom message", message)
        }
        
        test listIndexOutOfBounds() {
            var caught = false
            var list = List.newList<Int>()
            list.add(1)
            
            try {
                var item = list.get(10)  // Index out of bounds
            } catch(e: Exception) {
                caught = true
            }
            
            Assert.assertTrue(caught)
        }

        // Two catch clauses reusing a variable name with different types:
        // each body must see its own clause's type. v2 rendered the first
        // body with the LAST clause's type, so e.field became raw C.
        test catchVariablesReusingANameKeepTheirOwnTypes() {
            var field = ""
            var message = ""
            try {
                throw new FieldException("age")
            } catch (e: FieldException) {
                field = e.field
            }
            try {
                throw new Exception("plain")
            } catch (e: Exception) {
                message = e.message
            }
            Assert.assertEquals("age", field)
            Assert.assertEquals("plain", message)
        }
    }
}
