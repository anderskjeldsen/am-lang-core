namespace Tests {

    class LoopJumpItem {
        import Am.Lang
        var n: Int = 0
    }

    // Redmine #387: a plain break/continue in an unlabeled for, loop or each
    // must release the objects of the blocks it leaves and run the finally
    // blocks on the way, as in while loops and labeled loops. v2 emitted a
    // raw C break;/continue; there, which leaked the if block's objects and
    // skipped finally. Each case checks its result, then runs again with an
    // allocation count around it.
    class LoopJumpTests {
        import Am.Lang
        import Am.Lang.Diagnostics
        import Am.Collections
        import Am.Async
        import Am.Tests

        static var pending: Continuation? = null
        static var lastLog: String = ""
        var fin: Int = 0
        var log: String = ""

        private static fun forUntil(): Int {
            var s = 0
            for (i = 0 until 6) {
                var a = new LoopJumpItem()
                a.n = i
                if (i == 4) {
                    var b = new LoopJumpItem()
                    b.n = 1000
                    s = s + b.n
                    break
                }
                if (i == 1) {
                    var c = new LoopJumpItem()
                    var t = "skip" + c.n.toString()
                    s = s + 100
                    continue
                }
                s = s + a.n
            }
            return s
        }

        private static fun forTo(): Int {
            var s = 0
            for (i = 1 to 5) {
                if (i == 2) {
                    var c = new LoopJumpItem()
                    c.n = i
                    continue
                }
                if (i == 5) {
                    var b = new LoopJumpItem()
                    s = s + b.n + 1000
                    break
                }
                s = s + i
            }
            return s
        }

        private static fun loopInf(): Int {
            var s = 0
            loop {
                s++
                if (s == 2) {
                    var c = new LoopJumpItem()
                    c.n = s
                    continue
                }
                if (s == 4) {
                    var b = new LoopJumpItem()
                    b.n = s
                    break
                }
            }
            return s
        }

        private static fun eachArray(): Int {
            var arr: Int[] = [1, 2, 3, 4, 5]
            var s = 0
            each (x in arr) {
                if (x == 2) {
                    var c = new LoopJumpItem()
                    c.n = x
                    continue
                }
                if (x == 4) {
                    var b = new LoopJumpItem()
                    s = s + b.n + 1000
                    break
                }
                s = s + x
            }
            return s
        }

        private static fun eachList(): Int {
            var l = new List<LoopJumpItem>()
            var k = 0
            while (k < 5) {
                var it = new LoopJumpItem()
                it.n = k
                l.add(it)
                k++
            }
            var s = 0
            each (x in l) {
                if (x.n == 1) {
                    var c = new LoopJumpItem()
                    c.n = x.n
                    continue
                }
                if (x.n == 3) {
                    var b = new LoopJumpItem()
                    s = s + b.n + 1000
                    break
                }
                s = s + x.n
            }
            return s
        }

        // The jump two if blocks deep, both holding objects.
        private static fun nestedIf(): Int {
            var s = 0
            for (i = 0 until 6) {
                var a = new LoopJumpItem()
                if (i > 1) {
                    var b = new LoopJumpItem()
                    b.n = i
                    if (b.n == 2) {
                        var c = new LoopJumpItem()
                        s = s + 10 + c.n
                        continue
                    }
                    if (b.n == 4) {
                        var d = new LoopJumpItem()
                        s = s + 1000 + d.n
                        break
                    }
                }
                s = s + i
            }
            return s
        }

        // An if block holding only the jump stays a raw C jump; the results
        // must be the same.
        private static fun jumpOnlyIf(): Int {
            var s = 0
            for (i = 0 until 10) {
                var a = new LoopJumpItem()
                a.n = i
                if (i == 7) {
                    break
                }
                if (i == 2) {
                    continue
                } else {
                    s = s + a.n
                }
            }
            return s
        }

        static test forUntilReleasesIfBlockObjects() {
            Assert.assertEquals(0 + 100 + 2 + 3 + 1000, LoopJumpTests.forUntil())
            var before = Arc.getAllocationCount()
            for (n = 0 until 5) {
                LoopJumpTests.forUntil()
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        static test forToReleasesIfBlockObjects() {
            Assert.assertEquals(1 + 3 + 4 + 1000, LoopJumpTests.forTo())
            var before = Arc.getAllocationCount()
            for (n = 0 until 5) {
                LoopJumpTests.forTo()
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        static test loopReleasesIfBlockObjects() {
            Assert.assertEquals(4, LoopJumpTests.loopInf())
            var before = Arc.getAllocationCount()
            for (n = 0 until 5) {
                LoopJumpTests.loopInf()
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        static test eachArrayReleasesIfBlockObjects() {
            Assert.assertEquals(1 + 3 + 1000, LoopJumpTests.eachArray())
            var before = Arc.getAllocationCount()
            for (n = 0 until 5) {
                LoopJumpTests.eachArray()
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        static test eachListReleasesIfBlockObjects() {
            Assert.assertEquals(0 + 2 + 1000, LoopJumpTests.eachList())
            var before = Arc.getAllocationCount()
            for (n = 0 until 5) {
                LoopJumpTests.eachList()
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        static test nestedIfReleasesBothBlocks() {
            Assert.assertEquals(0 + 1 + 10 + 3 + 1000, LoopJumpTests.nestedIf())
            var before = Arc.getAllocationCount()
            for (n = 0 until 5) {
                LoopJumpTests.nestedIf()
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        static test jumpOnlyIfBlocks() {
            Assert.assertEquals(0 + 1 + 3 + 4 + 5 + 6, LoopJumpTests.jumpOnlyIf())
            var before = Arc.getAllocationCount()
            for (n = 0 until 5) {
                LoopJumpTests.jumpOnlyIf()
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        // ── finally ──────────────────────────────────────────────────────

        fun forFinally(): Int {
            for (i = 0 until 6) {
                var a = new LoopJumpItem()
                try {
                    var b = new LoopJumpItem()
                    if (i == 1) {
                        continue
                    }
                    if (i == 3) {
                        break
                    }
                } finally {
                    this.fin = this.fin + 1
                }
            }
            return this.fin
        }

        fun loopFinally(): Int {
            var s = 0
            loop {
                s++
                try {
                    if (s == 1) {
                        continue
                    }
                    if (s == 3) {
                        break
                    }
                } finally {
                    this.fin = this.fin + 1
                }
            }
            return this.fin
        }

        fun eachArrayFinally(): Int {
            var arr: Int[] = [1, 2, 3, 4]
            each (x in arr) {
                try {
                    if (x == 1) {
                        continue
                    }
                    if (x == 3) {
                        break
                    }
                } finally {
                    this.fin = this.fin + 1
                }
            }
            return this.fin
        }

        fun eachListFinally(): Int {
            var l = new List<String>()
            l.add("a")
            l.add("b")
            l.add("c")
            l.add("d")
            each (x in l) {
                try {
                    if (x == "a") {
                        continue
                    }
                    if (x == "c") {
                        break
                    }
                } finally {
                    this.fin = this.fin + 1
                }
            }
            return this.fin
        }

        // Both finally blocks run, inner first.
        fun nestedFinally(): Int {
            for (i = 0 until 5) {
                try {
                    try {
                        if (i == 1) {
                            continue
                        }
                        if (i == 2) {
                            break
                        }
                    } finally {
                        this.fin = this.fin + 1
                    }
                } finally {
                    this.fin = this.fin + 10
                }
            }
            return this.fin
        }

        // A break in a catch block runs the finally too.
        fun breakInCatch(): Int {
            for (i = 0 until 5) {
                try {
                    if (i == 2) {
                        throw new Exception("stop")
                    }
                } catch (e: Exception) {
                    break
                } finally {
                    this.fin = this.fin + 1
                }
            }
            return this.fin
        }

        // So do a return and a throw in a catch block (v2 skipped it).
        fun returnInCatch(): Int {
            try {
                throw new Exception("x")
            } catch (e: Exception) {
                return 5
            } finally {
                this.fin = this.fin + 1
            }
            return 0
        }

        fun throwInCatch() {
            try {
                throw new Exception("x")
            } catch (e: Exception) {
                throw new Exception("y")
            } finally {
                this.fin = this.fin + 1
            }
        }

        // A function of its own: a loop body's locals live until the end
        // of the function under v2.
        private static fun finallyCases() {
            var f1 = new LoopJumpTests()
            f1.forFinally()
            var f2 = new LoopJumpTests()
            f2.eachListFinally()
        }

        test finallyRunsOnBreakAndContinue() {
            Assert.assertEquals(4, (new LoopJumpTests()).forFinally())
            Assert.assertEquals(3, (new LoopJumpTests()).loopFinally())
            Assert.assertEquals(3, (new LoopJumpTests()).eachArrayFinally())
            Assert.assertEquals(3, (new LoopJumpTests()).eachListFinally())
            Assert.assertEquals(11 + 11 + 11, (new LoopJumpTests()).nestedFinally())
            var before = Arc.getAllocationCount()
            for (n = 0 until 5) {
                LoopJumpTests.finallyCases()
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test finallyRunsOnCatchExits() {
            Assert.assertEquals(3, (new LoopJumpTests()).breakInCatch())
            var r = new LoopJumpTests()
            Assert.assertEquals(5, r.returnInCatch())
            Assert.assertEquals(1, r.fin)
            var t = new LoopJumpTests()
            var caught = false
            try {
                t.throwInCatch()
            } catch (e: Exception) {
                caught = true
            }
            Assert.assertTrue(caught)
            Assert.assertEquals(1, t.fin)
        }

        // ── suspend functions ────────────────────────────────────────────

        suspend fun tick(): Int {
            suspend(cont) {
                LoopJumpTests.pending = cont
            }
            return 1
        }

        // A suspension inside the try and inside the finally.
        suspend fun suspendFor() {
            for (i = 0 until 5) {
                var a = new LoopJumpItem()
                try {
                    var k = this.tick()
                    if (i == 1) {
                        var c = new LoopJumpItem()
                        continue
                    }
                    if (i == 3) {
                        var b = new LoopJumpItem()
                        break
                    }
                    this.log = this.log + i.toString()
                } finally {
                    this.fin = this.fin + 1
                    var k2 = this.tick()
                }
            }
            this.log = this.log + " done"
        }

        suspend fun suspendEachNested() {
            var l = new List<String>()
            l.add("a")
            l.add("b")
            l.add("c")
            l.add("d")
            each (x in l) {
                try {
                    try {
                        var k = this.tick()
                        if (x == "b") {
                            continue
                        }
                        if (x == "c") {
                            break
                        }
                        this.log = this.log + x
                    } finally {
                        this.fin = this.fin + 1
                    }
                } finally {
                    this.fin = this.fin + 10
                }
            }
            this.log = this.log + " done"
        }

        suspend fun suspendLoopCatch() {
            var i = 0
            loop {
                i++
                try {
                    var k = this.tick()
                    if (i == 3) {
                        throw new Exception("stop")
                    }
                    this.log = this.log + i.toString()
                } catch (e: Exception) {
                    break
                } finally {
                    this.fin = this.fin + 1
                }
            }
            this.log = this.log + " done"
        }

        // A labeled jump out of an inner loop goes through the finally too.
        suspend fun suspendLabeled() {
            outer@ for (i = 0 until 3) {
                for (j = 0 until 3) {
                    try {
                        var k = this.tick()
                        if (j == 1) {
                            continue@outer
                        }
                        this.log = this.log + i.toString() + j.toString()
                    } finally {
                        this.fin = this.fin + 1
                    }
                }
            }
            this.log = this.log + " done"
        }

        private static fun driveSuspend(which: Int): Int {
            var t = new LoopJumpTests()
            if (which == 0) {
                t.suspendFor()
            } else if (which == 1) {
                t.suspendEachNested()
            } else if (which == 2) {
                t.suspendLoopCatch()
            } else {
                t.suspendLabeled()
            }
            var guard = 0
            while (LoopJumpTests.pending != null && guard < 100) {
                var c = LoopJumpTests.pending
                LoopJumpTests.pending = null
                if (c != null) {
                    c.resume()
                }
                guard++
            }
            LoopJumpTests.lastLog = t.log
            return t.fin
        }

        // A function of its own, so nothing it reads outlives it.
        private static fun assertLog(expected: String) {
            Assert.assertEquals(expected, LoopJumpTests.lastLog)
        }

        test suspendForRunsFinally() {
            Assert.assertEquals(4, LoopJumpTests.driveSuspend(0))
            LoopJumpTests.assertLog("02 done")
            var before = Arc.getAllocationCount()
            for (n = 0 until 5) {
                LoopJumpTests.driveSuspend(0)
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test suspendEachRunsNestedFinally() {
            Assert.assertEquals(33, LoopJumpTests.driveSuspend(1))
            LoopJumpTests.assertLog("a done")
            var before = Arc.getAllocationCount()
            for (n = 0 until 5) {
                LoopJumpTests.driveSuspend(1)
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test suspendLoopCatchRunsFinally() {
            Assert.assertEquals(3, LoopJumpTests.driveSuspend(2))
            LoopJumpTests.assertLog("12 done")
            var before = Arc.getAllocationCount()
            for (n = 0 until 5) {
                LoopJumpTests.driveSuspend(2)
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test suspendLabeledJumpRunsFinally() {
            Assert.assertEquals(6, LoopJumpTests.driveSuspend(3))
            LoopJumpTests.assertLog("001020 done")
            var before = Arc.getAllocationCount()
            for (n = 0 until 5) {
                LoopJumpTests.driveSuspend(3)
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }
    }
}
