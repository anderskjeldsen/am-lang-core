namespace CalendarRegression {
 class Program {
  import Am.Lang
  static var checks: Int = 0
  static fun check(ok: Bool, label: String) { if (!ok) { throw new Exception(label) }
 Program.checks++ }
  static fun compose(year: Long, month: Long, day: Long, hour: Long, minute: Long, second: Long, millisecond: Long, zone: String): Long {
   var out = new Long[1UI]
   Program.check(DateTime.calendarMillis(year, month, day, hour, minute, second, millisecond, zone, out), "compose " + year.toString() + "-" + month.toString() + "-" + day.toString())
   return out[0]
  }
  static fun composeFails(year: Long, month: Long, day: Long, zone: String): Bool {
   var out = new Long[1UI]
   out[0] = 42L
   return !DateTime.calendarMillis(year, month, day, 0L, 0L, 0L, 0L, zone, out) && out[0] == 42L
  }
  static fun parse(text: String): Long {
   var out = new Long[1UI]
   Program.check(DateTime.parseCalendarMillis(text, out), "parse " + text)
   return out[0]
  }
  static fun parseFails(text: String): Bool {
   var out = new Long[1UI]
   out[0] = 42L
   return !DateTime.parseCalendarMillis(text, out) && out[0] == 42L
  }
  static fun main() {
   var before = DateTime.calendarParts(-1L, "UTC")
   Program.check(before.length() == 9UI && before[0] == 1969 && before[1] == 12 && before[2] == 31 && before[3] == 23 && before[6] == 999 && before[7] == 3, "pre-epoch breakdown")
   Program.check(Program.compose(1969L,12L,31L,23L,59L,59L,999L,"UTC") == -1L, "pre-epoch compose")
   Program.check(Program.compose(1970L,0L,32L,0L,0L,0L,0L,"UTC") == 0L, "negative month normalization")
   Program.check(Program.compose(1970L,1L,1L,0L,0L,0L,-1L,"UTC") == -1L, "negative millisecond normalization")
   Program.check(Program.parse("1970-01-01T01:30:00+01:30") == 0L, "offset parse")
   Program.check(Program.parse("1969-12-31T23:59:59.999Z") == -1L, "fraction parse")
   Program.check(Program.parse("1970-01-01T24:00:00Z") == 86400000L, "24 hour parse")
   Program.check(Program.parse("1970") == 0L, "year parse")
   Program.check(Program.parseFails("2024-01-01T00:00:00+01:00junk"), "reject offset suffix")
   Program.check(Program.parseFails("2024-01-01T24:00:01Z"), "reject invalid 24 hour")
   Program.check(Program.parseFails("-000000-01-01"), "reject negative zero year")
   Program.check(Program.parseFails("+275760-09-13T00:00:00.001Z"), "reject parse past the limit")
   Program.check(DateTime.calendarParts(8640000000000001L,"UTC").length() == 0UI, "range rejection")
   Program.check(DateTime.calendarParts(-8640000000000001L,"UTC").length() == 0UI, "negative range rejection")
   var maxParts = DateTime.calendarParts(8640000000000000L,"UTC")
   Program.check(maxParts[0] == 275760 && maxParts[1] == 9 && maxParts[2] == 13, "positive limit")
   var minParts = DateTime.calendarParts(-8640000000000000L,"UTC")
   Program.check(minParts[0] == -271821 && minParts[1] == 4 && minParts[2] == 20, "negative limit")
   Program.check(Program.parse("+275760-09-13T00:00:00.000Z") == 8640000000000000L, "expanded year parse")
   Program.check(Program.composeFails(275760L,9L,14L,"UTC"), "compose past the limit")
   Program.check(Program.composeFails(1000000001L,1L,1L,"UTC"), "field over 1e9")
   Program.check(Program.composeFails(2000L,1L,-1000000001L,"UTC"), "field under -1e9")
   Program.check(Program.compose(1970L,1L,1L,0L,0L,0L,1000000000L,"UTC") == 1000000000L, "field at 1e9")
   Program.check(Program.compose(2000L,1L,1L,-1000000000L,0L,0L,0L,"UTC") == Program.parse("2000-01-01T00:00:00Z") - 3600000000000000L, "hour at -1e9")
   Program.check(Program.composeFails(1000000000L,1L,1L,"UTC"), "year at 1e9 out of range")
   Program.check(DateTime.resolveTimeZone("Not/AZone") == "", "unknown timezone")
   Program.check(DateTime.calendarParts(0L,"Not/AZone").length() == 0UI, "unknown zone parts")
   Program.check(Program.composeFails(2000L,1L,1L,"Not/AZone"), "unknown zone compose")
   var year = -800
   while (year < 2800) {
    var ms = Program.compose(year.toLong(),3L,1L,12L,34L,56L,789L,"UTC")
    var p = DateTime.calendarParts(ms,"UTC")
    Program.check(p[0] == year && p[1] == 3 && p[2] == 1 && p[3] == 12 && p[4] == 34 && p[5] == 56 && p[6] == 789, "era roundtrip")
    year += 37
   }
   if (DateTime.resolveTimeZone("Europe/Oslo") != "") {
    var winter = DateTime.calendarParts(Program.parse("2024-01-01T00:00:00Z"),"Europe/Oslo")
    var summer = DateTime.calendarParts(Program.parse("2024-07-01T00:00:00Z"),"Europe/Oslo")
    Program.check(winter[8] == 60 && summer[8] == 120, "DST offsets")
    Program.check(Program.compose(2024L,7L,1L,2L,0L,0L,0L,"Europe/Oslo") == Program.parse("2024-07-01T00:00:00Z"), "named zone compose")
    Program.check(DateTime.timeZoneAbbreviation(Program.parse("2024-07-01T00:00:00Z"),"Europe/Oslo") != "", "named zone abbreviation")
    Program.check(Program.parse("Sun, 06 Nov 1994 08:49:37 GMT") == 784111777000L, "RFC 1123 date")
   } else {
    Program.check(DateTime.availableTimeZones() == "UTC", "portable timezone list")
    Program.check(DateTime.timeZoneAbbreviation(0L,"UTC") == "UTC", "portable abbreviation")
   }
   Program.check(Date.now().getValue() > 0UL, "core clock")
   ("PASS signed calendar: " + Program.checks.toString()).println()
  }
 }
}
