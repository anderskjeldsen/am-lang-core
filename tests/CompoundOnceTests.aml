namespace Tests {

    // Redmine #550: `target op= rhs` evaluates the receiver chain and every
    // index ONCE. v2 copied the target and evaluated it twice, so `arr[n++] += 5`
    // bumped n twice and `arr[f()] += 1` called f twice. Counters prove each
    // side effect runs once and that the right element changes.

    struct CoPoint {
        import Am.Lang
        var x: Int
        var y: Int
    }

    class CoInner {
        import Am.Lang
        var d: Int = 1
        var s: String = "a"
    }

    // Redmine #554: a class with operator overloading, for `op=` on class targets.
    class CoVec(var v: Int) {
        import Am.Lang

        op + (o: CoVec): CoVec {
            return new CoVec(this.v + o.v)
        }

        op * (o: CoVec): CoVec {
            return new CoVec(this.v * o.v)
        }
    }

    class CoNode {
        import Am.Lang
        var c: Int[] = new Int[4]
        var ss: String[] = new String[3]
        var vec: CoVec = new CoVec(1)
        var vecs: CoVec[] = new CoVec[3]
        var inner: CoInner = new CoInner()
        var pt: CoPoint
        var n: Int = 10
        var s: String = "x"
        var m: Int? = 3
        var l: Long = 100
        var u: UInt = 100

        static var sn: Int = 5
        static var calls: Int = 0
        static var shared: CoNode = new CoNode()

        static fun idx(i: Int): Int {
            CoNode.calls++
            return i
        }

        static fun get(): CoNode {
            CoNode.calls++
            return CoNode.shared
        }

        fun me(): CoNode {
            CoNode.calls++
            return this
        }

        fun inn(): CoInner {
            CoNode.calls++
            return this.inner
        }

        fun arr(): Int[] {
            CoNode.calls++
            return this.c
        }

        fun sarr(): String[] {
            CoNode.calls++
            return this.ss
        }

        fun varr(): CoVec[] {
            CoNode.calls++
            return this.vecs
        }

        static fun tag(t: String): String {
            CoNode.calls++
            return t
        }

        static fun fail(): String {
            throw new Exception("rhs failed")
        }
    }

    class CompoundOnceTests {
        import Am.Lang
        import Am.Tests

        static fun reset() {
            CoNode.calls = 0
            CoNode.shared = new CoNode()
        }

        test indexSideEffectOnce() {
            var a = new Int[4]
            a[0] = 10
            a[1] = 20
            a[2] = 30
            var n = 0
            a[n++] += 5
            Assert.assertEquals(1, n)
            Assert.assertEquals(15, a[0])
            Assert.assertEquals(20, a[1])
            a[n++] -= 2
            Assert.assertEquals(2, n)
            Assert.assertEquals(18, a[1])
            a[n++] *= 3
            Assert.assertEquals(90, a[2])
            Assert.assertEquals(3, n)
            Assert.assertEquals(0, a[3])
        }

        test everyOperatorOnCallIndex() {
            reset()
            var a = new Int[4]
            a[1] = 100
            a[CoNode.idx(1)] += 5
            Assert.assertEquals(105, a[1])
            a[CoNode.idx(1)] -= 5
            Assert.assertEquals(100, a[1])
            a[CoNode.idx(1)] *= 2
            Assert.assertEquals(200, a[1])
            a[CoNode.idx(1)] /= 8
            Assert.assertEquals(25, a[1])
            a[CoNode.idx(1)] %= 7
            Assert.assertEquals(4, a[1])
            a[CoNode.idx(1)] |= 9
            Assert.assertEquals(13, a[1])
            a[CoNode.idx(1)] &= 6
            Assert.assertEquals(4, a[1])
            a[CoNode.idx(1)] ^= 5
            Assert.assertEquals(1, a[1])
            Assert.assertEquals(8, CoNode.calls)
            Assert.assertEquals(0, a[0])
            Assert.assertEquals(0, a[2])
        }

        test callIndexOnFieldArray() {
            reset()
            var o = new CoNode()
            o.c[2] = 7
            o.c[CoNode.idx(2)] += 3
            Assert.assertEquals(1, CoNode.calls)
            Assert.assertEquals(10, o.c[2])
            o.me().c[CoNode.idx(2)] *= 2
            Assert.assertEquals(3, CoNode.calls)
            Assert.assertEquals(20, o.c[2])
            o.arr()[CoNode.idx(3)] += 9
            Assert.assertEquals(5, CoNode.calls)
            Assert.assertEquals(9, o.c[3])
            Assert.assertEquals(0, o.c[0])
        }

        test fieldOfCallResult() {
            reset()
            CoNode.get().n += 1
            Assert.assertEquals(1, CoNode.calls)
            Assert.assertEquals(11, CoNode.shared.n)
            CoNode.get().n -= 3
            CoNode.get().n *= 4
            CoNode.get().n /= 2
            CoNode.get().n %= 7
            CoNode.get().n |= 8
            CoNode.get().n &= 12
            CoNode.get().n ^= 5
            Assert.assertEquals(8, CoNode.calls)
            var v = 11
            v -= 3
            v *= 4
            v /= 2
            v %= 7
            v |= 8
            v &= 12
            v ^= 5
            Assert.assertEquals(v, CoNode.shared.n)
            CoNode.get().l += 5
            Assert.assertTrue(CoNode.shared.l == 105)
            CoNode.get().u -= 1
            Assert.assertEquals(99, CoNode.shared.u as Int)
            Assert.assertEquals(10, CoNode.calls)
        }

        test nestedChain() {
            reset()
            var o = new CoNode()
            o.inn().d += 4
            Assert.assertEquals(1, CoNode.calls)
            Assert.assertEquals(5, o.inner.d)
            o.me().inn().d *= 3
            Assert.assertEquals(3, CoNode.calls)
            Assert.assertEquals(15, o.inner.d)
            o.me().arr()[CoNode.idx(1)] += 6
            Assert.assertEquals(6, CoNode.calls)
            Assert.assertEquals(6, o.c[1])
            o.me().me().n -= 1
            Assert.assertEquals(8, CoNode.calls)
            Assert.assertEquals(9, o.n)
        }

        // #554: v1 rendered a class-typed `target op= rhs` as `target = target op rhs`
        // on a copy of the target, so a call in the receiver ran twice.
        test stringOnCallResult() {
            reset()
            var o = new CoNode()
            o.me().s += "y"
            Assert.assertEquals(1, CoNode.calls)
            Assert.assertEquals("xy", o.s)
            o.inn().s += "b"
            Assert.assertEquals(2, CoNode.calls)
            Assert.assertEquals("ab", o.inner.s)
            CoNode.get().s += "z"
            Assert.assertEquals(3, CoNode.calls)
            Assert.assertEquals("xz", CoNode.shared.s)
            o.me().me().inn().s += "c"
            Assert.assertEquals(6, CoNode.calls)
            Assert.assertEquals("abc", o.inner.s)
            CoNode.shared.s += "w"
            Assert.assertEquals("xzw", CoNode.shared.s)
            o.me().s += CoNode.tag("t")
            Assert.assertEquals(8, CoNode.calls)
            Assert.assertEquals("xyt", o.s)
        }

        test stringElementOnce() {
            reset()
            var o = new CoNode()
            o.ss[0] = "a"
            o.ss[1] = "b"
            o.ss[2] = "c"
            o.ss[CoNode.idx(1)] += "y"
            Assert.assertEquals(1, CoNode.calls)
            Assert.assertEquals("by", o.ss[1])
            o.sarr()[CoNode.idx(2)] += "z"
            Assert.assertEquals(3, CoNode.calls)
            Assert.assertEquals("cz", o.ss[2])
            o.me().ss[CoNode.idx(0)] += "q"
            Assert.assertEquals(5, CoNode.calls)
            Assert.assertEquals("aq", o.ss[0])
            var n = 0
            o.ss[n++] += "1"
            o.ss[n++] += "2"
            Assert.assertEquals(2, n)
            Assert.assertEquals("aq1", o.ss[0])
            Assert.assertEquals("by2", o.ss[1])
            Assert.assertEquals("cz", o.ss[2])
        }

        static fun fillHeap(a: String[]) {
            var k = 5
            a[0] = "abc" + k.toString()
            a[1] = "def" + k.toString()
        }

        // The element a heap string held only by the array: the store used to
        // release it before the right side read it.
        test heapStringElement() {
            var a = new String[2]
            CompoundOnceTests.fillHeap(a)
            a[0] = a[0] + "x"
            Assert.assertEquals("abc5x", a[0])
            a[1] += "y"
            Assert.assertEquals("def5y", a[1])
            a[1] += a[1]
            Assert.assertEquals("def5ydef5y", a[1])
        }

        // A right side that throws leaves the element as it was.
        test throwingRhsKeepsElement() {
            var a = new String[1]
            CompoundOnceTests.fillHeap(new String[2])
            var k = 7
            a[0] = "e" + k.toString()
            var threw = false
            try {
                a[0] += CoNode.fail()
            } catch (e: Exception) {
                threw = true
            }
            Assert.assertTrue(threw)
            Assert.assertEquals("e7", a[0])
            threw = false
            try {
                a[0] = CoNode.fail()
            } catch (e: Exception) {
                threw = true
            }
            Assert.assertTrue(threw)
            Assert.assertEquals("e7", a[0])
        }

        test operatorClassOnce() {
            reset()
            var o = new CoNode()
            o.me().vec += new CoVec(2)
            Assert.assertEquals(1, CoNode.calls)
            Assert.assertEquals(3, o.vec.v)
            o.me().vec *= new CoVec(5)
            Assert.assertEquals(2, CoNode.calls)
            Assert.assertEquals(15, o.vec.v)
            CoNode.get().vec += new CoVec(4)
            Assert.assertEquals(3, CoNode.calls)
            Assert.assertEquals(5, CoNode.shared.vec.v)
            var v = new CoVec(2)
            v += new CoVec(1)
            v *= v
            Assert.assertEquals(9, v.v)
        }

        test operatorClassElementOnce() {
            reset()
            var o = new CoNode()
            o.vecs[0] = new CoVec(1)
            o.vecs[1] = new CoVec(10)
            o.vecs[2] = new CoVec(100)
            o.vecs[CoNode.idx(1)] += new CoVec(5)
            Assert.assertEquals(1, CoNode.calls)
            Assert.assertEquals(15, o.vecs[1].v)
            o.varr()[CoNode.idx(2)] *= new CoVec(3)
            Assert.assertEquals(3, CoNode.calls)
            Assert.assertEquals(300, o.vecs[2].v)
            var n = 0
            o.me().vecs[n++] += new CoVec(1)
            Assert.assertEquals(1, n)
            Assert.assertEquals(4, CoNode.calls)
            Assert.assertEquals(2, o.vecs[0].v)
            Assert.assertEquals(15, o.vecs[1].v)
        }

        test structMemberThroughCall() {
            reset()
            var o = new CoNode()
            o.me().pt.x += 4
            Assert.assertEquals(1, CoNode.calls)
            Assert.assertEquals(4, o.pt.x)
            o.me().pt.y -= 2
            o.me().pt.y *= 5
            Assert.assertEquals(3, CoNode.calls)
            Assert.assertEquals(-10, o.pt.y)
            Assert.assertEquals(4, o.pt.x)
        }

        test structElementMembers() {
            reset()
            var pts = new CoPoint[3]
            var n = 0
            pts[n++].x += 5
            Assert.assertEquals(1, n)
            Assert.assertEquals(5, pts[0].x)
            pts[CoNode.idx(2)].y -= 3
            Assert.assertEquals(1, CoNode.calls)
            Assert.assertEquals(-3, pts[2].y)
            Assert.assertEquals(0, pts[1].y)
            var o = new CoNode()
            var parr = new CoPoint[2]
            parr[n--].x *= 2
            Assert.assertEquals(0, n)
        }

        test staticTargets() {
            reset()
            CoNode.sn += 3
            CoNode.sn *= 2
            Assert.assertEquals(16, CoNode.sn)
            var a = new Int[3]
            var n = 1
            a[n++] += CoNode.sn
            Assert.assertEquals(2, n)
            Assert.assertEquals(16, a[1])
        }

        test nullableTargets() {
            reset()
            var o = new CoNode()
            o.me().m += 4
            Assert.assertEquals(1, CoNode.calls)
            Assert.assertEquals(7, o.m!!)
            o.me().m *= 2
            Assert.assertEquals(2, CoNode.calls)
            Assert.assertEquals(14, o.m!!)
            o.m = null
            var threw = false
            try {
                o.me().m += 1
            } catch (e: Exception) {
                threw = true
            }
            Assert.assertTrue(threw)
            Assert.assertEquals(3, CoNode.calls)
        }

        test rhsEvaluatedOnce() {
            reset()
            var a = new Int[3]
            a[CoNode.idx(1)] += CoNode.idx(7)
            Assert.assertEquals(2, CoNode.calls)
            Assert.assertEquals(7, a[1])
        }

        test outOfBoundsThrowsOnce() {
            reset()
            var a = new Int[2]
            var threw = false
            try {
                a[CoNode.idx(5)] += 1
            } catch (e: Exception) {
                threw = true
            }
            Assert.assertTrue(threw)
            Assert.assertEquals(1, CoNode.calls)
        }
    }
}
