namespace Tests {

    // Redmine #447: every object of a thread is on its object list, and when a
    // thread ends (or the program does) whatever is left is released through
    // the normal release hooks, after the usual cycle sweep. The out-of-memory
    // case (frames skipped by the jump) is checked by examples/OomShutdown;
    // these tests cover the ordinary ends and GC.collect, whose candidates are
    // now every object rather than only property-referenced ones.

    class HrNode(var n: Int, var other: HrNode?) {
        import Am.Lang
    }

    class HrHolder(var name: String, var stream: Am.IO.Stream?, var other: HrHolder?) {
        import Am.Lang
        import Am.IO
    }

    // Leaves a nested stream (TextStream over BinaryStream over FileStream)
    // in a cycle of two holders, unclosed. Ending the thread must release it:
    // FileStream's release closes the file, so the parent can read it back and
    // delete it (on AmigaOS an unclosed write stream keeps the file locked).
    class HrCycleWriter(private var path: String) : Runnable {
        import Am.Lang
        import Am.IO
        import Am.Threading

        override fun run() {
            var fs = new FileStream(new File(this.path), FileAccess.writeOnly)
            var ts = new TextStream(new BinaryStream(fs))
            ts.writeString("written by the worker")
            var a = new HrHolder("a", ts, null)
            var b = new HrHolder("b", null, a)
            a.other = b
            Thread.getParent().send(new HrNode(1, null))
        }
    }

    // A cycle that runs through an interface wrapper (holder -> Runnable
    // wrapper -> implementation -> holder), the shape the thread pool's
    // TaskRunner/Thread pair has. The end-of-thread sweep must take it as a
    // cycle, not mistake the wrapper's reference for one from code.
    class HrSelfRunner(var holder: HrRunnableHolder?) : Runnable {
        import Am.Lang
        override fun run() {
        }
    }

    class HrRunnableHolder(var runnable: Runnable?) {
        import Am.Lang
    }

    class HrInterfaceCycleWorker : Runnable {
        import Am.Lang
        import Am.Threading

        override fun run() {
            var r = new HrSelfRunner(null)
            var h = new HrRunnableHolder(r)
            r.holder = h
            Thread.getParent().send(new HrNode(2, null))
        }
    }

    class HeapReleaseTests {
        import Am.Lang
        import Am.IO
        import Am.Threading
        import Am.Tests

        test testThreadEndClosesAStreamLeftInACycle() {
            var path = "heap-release-cycle.txt"
            var t = new Thread(new HrCycleWriter(path))
            t.start()
            var m = Thread.receive() as HrNode
            t.join()
            Assert.assertEquals(1, m.n)
            var stream = new FileStream(new File(path), FileAccess.readOnly)
            var reader = new TextStream(stream)
            var text = reader.readString()
            stream.close()
            Assert.assertEquals("written by the worker", text)
            Assert.assertTrue(new File(path).delete())
        }

        test testThreadEndReleasesACycleThroughAnInterface() {
            var t = new Thread(new HrInterfaceCycleWorker())
            t.start()
            var m = Thread.receive() as HrNode
            t.join()
            Assert.assertEquals(2, m.n)
        }

        // GC.collect sees objects held only by locals too now: they must stay
        // (their code count makes them roots), and so must what they hold.
        test testCollectKeepsWhatALocalHolds() {
            var keep = new HrNode(10, new HrNode(11, null))
            var cycleA = new HrNode(20, null)
            var cycleB = new HrNode(21, cycleA)
            cycleA.other = cycleB
            cycleA = new HrNode(0, null)
            cycleB = new HrNode(0, null)
            var reclaimed = GC.collect()
            Assert.assertTrue(reclaimed >= 2L)
            Assert.assertEquals(10, keep.n)
            Assert.assertEquals(11, keep.other!!.n)
            Assert.assertTrue(keep.other!!.other == null)
        }

        // A local that only an interface wrapper holds stays too.
        test testCollectKeepsAnImplementationHeldThroughAnInterface() {
            var r: Runnable = new HrSelfRunner(null)
            var h = new HrRunnableHolder(r)
            GC.collect()
            Assert.assertTrue(h.runnable != null)
            h.runnable!!.run()
        }
    }
}
