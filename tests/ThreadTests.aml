namespace Tests {

    // Black-box coverage of Am.Threading.Thread under the share-nothing
    // (isolate) model: a worker runs on a deep COPY of its Runnable and can
    // only talk to other threads through messages. So every test here has
    // the worker send its observations back to the parent, and the parent
    // reads them with TtMail.afterJoin() (Thread.tryReceive) after join(). A regression in the
    // Runnable copy, the message copy, the mailbox or the isolate startup
    // shows up as a missing or wrong message — never as a silently "correct"
    // zero, which is why the assertions check for specific non-zero values.

    // Reads the message a worker sent before the join that just returned. Not
    // Thread.receive(): before #467 a worker that threw before it sent left
    // that waiting forever (a 55-minute hang of the v2 suite, 2026-11-20), and
    // a regression there would again; this fails the test instead.
    class TtMail {
        import Am.Lang
        import Am.Threading
        import Am.Tests

        static fun afterJoin(): Object {
            var m = Thread.tryReceive()
            if (m == null) {
                Assert.fail("The worker sent no message before it ended (its exception, if any, is printed above)")
            }
            return m!!
        }
    }

    // The message a worker sends back.
    class TtResult(var label: String, var number: Int, var runCount: Int) {
        import Am.Lang
    }

    // A mutable object handed to a worker inside its Runnable. The worker
    // mutates ITS copy; the parent's instance must stay untouched.
    class TtHolder {
        import Am.Lang

        var value: Int = 0
    }

    // Two references to one node inside a message: identity must survive
    // the copy (one copy of the node, referenced twice).
    class TtNode(var value: Int) {
        import Am.Lang
    }

    class TtPair(var a: TtNode, var b: TtNode) {
        import Am.Lang
    }

    // Worker with String + Int fields set by the parent; reads them off the
    // copied Runnable and reports them back.
    class TtBasicWorker(private var label: String, private var value: Int) : Runnable {
        import Am.Lang
        import Am.Threading

        override fun run() {
            var parent = Thread.getParent()
            parent.send(new TtResult(this.label, this.value, 1))
        }
    }

    // Reports its amount; the parent sums the reports.
    class TtAdderWorker(private var amount: Int) : Runnable {
        import Am.Lang
        import Am.Threading

        override fun run() {
            var parent = Thread.getParent()
            parent.send(new TtResult("add", this.amount, 1))
        }
    }

    // Throws before it sends anything: its parent gets only the failure notice.
    class TtThrowingWorker() : Runnable {
        import Am.Lang

        override fun run() {
            throw new Exception("TtThrowingWorker fails on purpose (expected in the test output)")
        }
    }

    // Waits for a message from the parent and echoes a derived one back.
    class TtEchoWorker() : Runnable {
        import Am.Lang
        import Am.Threading

        override fun run() {
            var m = Thread.receive() as TtResult
            var parent = Thread.getParent()
            parent.send(new TtResult(m.label + "!", m.number * 2, 1))
        }
    }

    // Mutates the holder it was given. Under share-nothing that holder is a
    // copy, so the parent's holder must not change.
    class TtMutatorWorker(private var holder: TtHolder) : Runnable {
        import Am.Lang
        import Am.Threading

        override fun run() {
            this.holder.value = 99
            var parent = Thread.getParent()
            parent.send(new TtResult("mutated", this.holder.value, 1))
        }
    }

    // Sends a graph with a shared node and a list, to exercise the copier.
    class TtGraphWorker() : Runnable {
        import Am.Lang
        import Am.Threading
        import Am.Collections

        override fun run() {
            var node = new TtNode(7)
            var pair = new TtPair(node, node)
            var parent = Thread.getParent()
            parent.send(pair)
            var names = List.newList<String>()
            names.add("alpha")
            names.add("beta")
            names.add("gamma")
            parent.send(names)
        }
    }

    // Sends one result, then throws: the parent receives the result first,
    // then the failure notice (#467).
    class TtSendThenThrowWorker() : Runnable {
        import Am.Lang
        import Am.Threading

        override fun run() {
            Thread.getParent().send(new TtResult("before-failure", 3, 1))
            throw new Exception("TtSendThenThrowWorker fails on purpose (expected in the test output)")
        }
    }

    // A custom exception type, to check the cause's class name and copy.
    class TtFailure(var code: Int) : Exception("TtFailure code " + code.toString()) {
        import Am.Lang
    }

    class TtCustomThrowWorker() : Runnable {
        import Am.Lang

        override fun run() {
            throw new TtFailure(17)
        }
    }

    // An exception that holds something not sendable (a Mutex): the notice
    // still arrives, without the cause.
    class TtUnsendableFailure(var lock: Mutex) : Exception("TtUnsendableFailure on purpose") {
        import Am.Lang
        import Am.Threading
    }

    class TtUnsendableThrowWorker() : Runnable {
        import Am.Lang
        import Am.Threading

        override fun run() {
            throw new TtUnsendableFailure(new Mutex())
        }
    }

    // Starts a TtThrowingWorker of its own, joins it and reports to ITS
    // parent what its tryReceive threw: nested workers notify their own
    // parent, not main.
    class TtNestedParentWorker() : Runnable {
        import Am.Lang
        import Am.Threading

        override fun run() {
            var child = new Thread(new TtThrowingWorker())
            child.name = "tt-nested-child"
            child.start()
            child.join()
            var report = "no notice"
            try {
                var m = Thread.tryReceive()
                if (m != null) {
                    report = "a message"
                }
            } catch (e: ThreadFailedException) {
                report = e.message
            }
            Thread.getParent().send(new TtResult(report, 0, 1))
        }
    }

    // A sentinel the parent sends itself after a join, so that a missing
    // failure notice makes receive() return the sentinel instead of hanging.
    class TtSentinel() {
        import Am.Lang
    }

    class ThreadTests {
        import Am.Lang
        import Am.Threading
        import Am.Collections
        import Am.Tests

        // ---- Baseline: start + join schedules run(), the reply arrives ---

        test testWorkerRunsAtLeastOnce() {
            var w = new TtBasicWorker("baseline", 1)
            var t = new Thread(w as Runnable)
            t.name = "tt-baseline"
            t.start()
            t.join()

            var r = TtMail.afterJoin() as TtResult
            Assert.assertEquals(1, r.runCount)
        }

        // ---- The copied Runnable carries the parent's String field ------

        test testWorkerReadsStringField() {
            var w = new TtBasicWorker("cross-thread-string", 0)
            var t = new Thread(w as Runnable)
            t.name = "tt-string"
            t.start()
            t.join()

            var r = TtMail.afterJoin() as TtResult
            Assert.assertEquals("cross-thread-string", r.label)
        }

        // ---- ... and its Int field ---------------------------------------

        test testWorkerReadsIntField() {
            var w = new TtBasicWorker("int-field", 12345)
            var t = new Thread(w as Runnable)
            t.name = "tt-int"
            t.start()
            t.join()

            var r = TtMail.afterJoin() as TtResult
            Assert.assertEquals(12345, r.number)
        }

        // ---- Two workers, two replies, summed by the parent ---------------

        test testTwoWorkersReportToParent() {
            var a = new TtAdderWorker(10)
            var b = new TtAdderWorker(20)

            var ta = new Thread(a as Runnable)
            ta.name = "tt-adder-a"
            var tb = new Thread(b as Runnable)
            tb.name = "tt-adder-b"

            ta.start()
            tb.start()
            ta.join()
            tb.join()

            var r1 = TtMail.afterJoin() as TtResult
            var r2 = TtMail.afterJoin() as TtResult
            // Arrival order is unspecified; the total is not.
            Assert.assertEquals(30, r1.number + r2.number)
        }

        // ---- Many rapid start/join cycles ---------------------------------

        test testRepeatedStartJoin() {
            var iterations = 10
            for (i = 0 until iterations) {
                var w = new TtBasicWorker("iter", i)
                var t = new Thread(w as Runnable)
                t.name = "tt-repeat"
                t.start()
                t.join()
            }
            var total = 0
            for (i = 0 until iterations) {
                var r = TtMail.afterJoin() as TtResult
                total = total + r.runCount
            }
            Assert.assertEquals(iterations, total)
        }

        // ---- Parent -> worker -> parent round trip -------------------------

        test testSendToWorkerAndBack() {
            var w = new TtEchoWorker()
            var t = new Thread(w as Runnable)
            t.name = "tt-echo"
            t.start()
            t.send(new TtResult("ping", 21, 0))
            t.join()

            var r = TtMail.afterJoin() as TtResult
            Assert.assertEquals("ping!", r.label)
            Assert.assertEquals(42, r.number)
        }

        // ---- The worker runs on a COPY: the parent's objects stay put ------

        test testWorkerMutatesItsOwnCopy() {
            var holder = new TtHolder()
            var w = new TtMutatorWorker(holder)
            var t = new Thread(w as Runnable)
            t.name = "tt-mutator"
            t.start()
            t.join()

            var r = TtMail.afterJoin() as TtResult
            Assert.assertEquals(99, r.number)
            // Share-nothing: the worker changed its copy, not this one.
            Assert.assertEquals(0, holder.value)
        }

        // ---- Message graphs: shared nodes and collections ------------------

        test testMessageGraphKeepsSharedNodeAndList() {
            var w = new TtGraphWorker()
            var t = new Thread(w as Runnable)
            t.name = "tt-graph"
            t.start()
            t.join()

            var pair = TtMail.afterJoin() as TtPair
            Assert.assertEquals(7, pair.a.value)
            Assert.assertEquals(7, pair.b.value)
            // One node referenced twice on the sender must be ONE node here too.
            pair.a.value = 8
            Assert.assertEquals(8, pair.b.value)

            var names = TtMail.afterJoin() as List<String>
            Assert.assertEquals(3, names.getSize())
            Assert.assertEquals("beta", names.get(1))
        }

        // ---- tryReceive on an empty mailbox --------------------------------

        test testTryReceiveEmpty() {
            var m = Thread.tryReceive()
            Assert.assertTrue(m == null)
        }

        // ---- Non-sendable objects are refused, nothing is sent -------------

        test testNonSendableThrows() {
            var threw = false
            try {
                // A Mutex is a native class that owns an OS handle: not sendable.
                Thread.getCurrent().send(new Mutex())
            } catch (e: Exception) {
                threw = true
            }
            Assert.assertTrue(threw)
            var m = Thread.tryReceive()
            Assert.assertTrue(m == null)
        }

        // A send that fails on a nested child that is not sendable leaves no
        // partial copy behind (it used to stay alive until the thread ended).
        test testFailedNestedSendLeavesNoPartialCopy() {
            var failure = new TtUnsendableFailure(new Mutex())
            var before = instances(TtUnsendableFailure)
            var threw = false
            try {
                Thread.getCurrent().send(failure)
            } catch (e: Exception) {
                threw = true
            }
            Assert.assertTrue(threw)
            Assert.assertEquals(before, instances(TtUnsendableFailure))
            Assert.assertTrue(Thread.tryReceive() == null)
        }

        // ---- A worker that throws: the parent's receive throws (#467) -------

        // tryReceive after the join: the notice is there, deterministically.
        test testAWorkerThatThrowsFailsTryReceive() {
            var t = new Thread(new TtThrowingWorker())
            t.name = "tt-throws"
            t.start()
            t.join()
            var message = "no exception"
            var threadName = ""
            var causeClass = ""
            var causeMessage = ""
            try {
                Thread.tryReceive()
            } catch (e: ThreadFailedException) {
                message = e.message
                threadName = e.threadName
                causeClass = e.causeClassName
                causeMessage = e.causeMessage
                var cause = e.cause
                if (cause != null) {
                    Assert.assertEquals(causeMessage, cause.message)
                } else {
                    Assert.fail("The notice lost its cause")
                }
            }
            Assert.assertEquals("Thread 'tt-throws' failed: TtThrowingWorker fails on purpose (expected in the test output)", message)
            Assert.assertEquals("tt-throws", threadName)
            Assert.assertEquals("Am.Lang.Exception", causeClass)
            Assert.assertEquals("TtThrowingWorker fails on purpose (expected in the test output)", causeMessage)
            // The notice was taken: the mailbox is empty again.
            Assert.assertTrue(Thread.tryReceive() == null)
        }

        // receive() throws too. The sentinel sent after the join makes a
        // missing notice a failure, not a hang.
        test testAWorkerThatThrowsFailsReceive() {
            var t = new Thread(new TtThrowingWorker())
            t.name = "tt-throws-receive"
            t.start()
            t.join()
            Thread.getCurrent().send(new TtSentinel())
            var message = "no exception"
            try {
                Thread.receive()
            } catch (e: ThreadFailedException) {
                message = e.message
            }
            Assert.assertEquals("Thread 'tt-throws-receive' failed: TtThrowingWorker fails on purpose (expected in the test output)", message)
            Assert.assertTrue(Thread.receive() is TtSentinel)
        }

        // A plain catch (e: Exception) sees it as well.
        test testThreadFailedIsAnException() {
            var t = new Thread(new TtThrowingWorker())
            t.name = "tt-throws-plain"
            t.start()
            t.join()
            var caught = false
            try {
                Thread.tryReceive()
            } catch (e: Exception) {
                caught = e is ThreadFailedException
            }
            Assert.assertTrue(caught)
        }

        // Messages sent before the failure come first, then the notice.
        test testSendThenThrowDeliversMessageThenFails() {
            var t = new Thread(new TtSendThenThrowWorker())
            t.name = "tt-send-throw"
            t.start()
            t.join()
            Thread.getCurrent().send(new TtSentinel())
            var first = Thread.receive()
            Assert.assertTrue(first is TtResult)
            Assert.assertEquals("before-failure", (first as TtResult).label)
            var message = "no exception"
            try {
                Thread.receive()
            } catch (e: ThreadFailedException) {
                message = e.message
            }
            Assert.assertEquals("Thread 'tt-send-throw' failed: TtSendThenThrowWorker fails on purpose (expected in the test output)", message)
            Assert.assertTrue(Thread.receive() is TtSentinel)
        }

        // A worker that ends normally posts nothing beyond what it sent.
        test testANormalWorkerPostsNoNotice() {
            var t = new Thread(new TtBasicWorker("normal", 4) as Runnable)
            t.name = "tt-normal"
            t.start()
            t.join()
            var r = TtMail.afterJoin() as TtResult
            Assert.assertEquals(4, r.number)
            Assert.assertTrue(Thread.tryReceive() == null)
        }

        // The cause keeps its class and fields across the copy.
        test testCustomExceptionCause() {
            var t = new Thread(new TtCustomThrowWorker())
            t.name = "tt-custom"
            t.start()
            t.join()
            var causeClass = ""
            var code = 0
            var message = ""
            try {
                Thread.tryReceive()
            } catch (e: ThreadFailedException) {
                causeClass = e.causeClassName
                message = e.message
                var cause = e.cause
                if (cause != null && cause is TtFailure) {
                    code = (cause as TtFailure).code
                }
            }
            Assert.assertEquals("Tests.TtFailure", causeClass)
            Assert.assertEquals("Thread 'tt-custom' failed: TtFailure code 17", message)
            Assert.assertEquals(17, code)
        }

        // A cause that cannot be copied is left out; the notice still comes.
        test testUnsendableCauseIsLeftOut() {
            var t = new Thread(new TtUnsendableThrowWorker())
            t.name = "tt-unsendable"
            t.start()
            t.join()
            var message = "no exception"
            var causeClass = ""
            var hasCause = true
            try {
                Thread.tryReceive()
            } catch (e: ThreadFailedException) {
                message = e.message
                causeClass = e.causeClassName
                hasCause = e.cause != null
            }
            Assert.assertEquals("Thread 'tt-unsendable' failed: TtUnsendableFailure on purpose", message)
            Assert.assertEquals("Tests.TtUnsendableFailure", causeClass)
            Assert.assertFalse(hasCause)
            Assert.assertTrue(Thread.tryReceive() == null)
        }

        // A nested worker's failure goes to the worker that started it.
        test testNestedWorkerFailureReachesItsParentWorker() {
            var t = new Thread(new TtNestedParentWorker())
            t.name = "tt-nested-parent"
            t.start()
            t.join()
            var r = TtMail.afterJoin() as TtResult
            Assert.assertEquals("Thread 'tt-nested-child' failed: TtThrowingWorker fails on purpose (expected in the test output)", r.label)
            // Main got nothing from the grandchild.
            Assert.assertTrue(Thread.tryReceive() == null)
        }

        // ---- A handle to self round-trips through the mailbox --------------

        test testSelfSend() {
            var me = Thread.getCurrent()
            me.send(new TtResult("self", 5, 0))
            var r = Thread.receive() as TtResult
            Assert.assertEquals("self", r.label)
            Assert.assertEquals(5, r.number)
        }
    }
}
