namespace Tests {

    // Black-box coverage of Am.Threading.Thread under the share-nothing
    // (isolate) model: a worker runs on a deep COPY of its Runnable and can
    // only talk to other threads through messages. So every test here has
    // the worker send its observations back to the parent, and the parent
    // reads them with Thread.receive() after join(). A regression in the
    // Runnable copy, the message copy, the mailbox or the isolate startup
    // shows up as a missing or wrong message — never as a silently "correct"
    // zero, which is why the assertions check for specific non-zero values.

    // The message a worker sends back.
    class TtResult(var label: String, var number: Int, var runCount: Int) {
        import Am.Lang
    }

    // A mutable object handed to a worker inside its Runnable. The worker
    // mutates ITS copy; the parent's instance must stay untouched.
    class TtHolder {
        import Am.Lang

        var value: Int = 0
    }

    // Two references to one node inside a message: identity must survive
    // the copy (one copy of the node, referenced twice).
    class TtNode(var value: Int) {
        import Am.Lang
    }

    class TtPair(var a: TtNode, var b: TtNode) {
        import Am.Lang
    }

    // Worker with String + Int fields set by the parent; reads them off the
    // copied Runnable and reports them back.
    class TtBasicWorker(private var label: String, private var value: Int) : Runnable {
        import Am.Lang
        import Am.Threading

        override fun run() {
            var parent = Thread.getParent()
            parent.send(new TtResult(this.label, this.value, 1))
        }
    }

    // Reports its amount; the parent sums the reports.
    class TtAdderWorker(private var amount: Int) : Runnable {
        import Am.Lang
        import Am.Threading

        override fun run() {
            var parent = Thread.getParent()
            parent.send(new TtResult("add", this.amount, 1))
        }
    }

    // Waits for a message from the parent and echoes a derived one back.
    class TtEchoWorker() : Runnable {
        import Am.Lang
        import Am.Threading

        override fun run() {
            var m = Thread.receive() as TtResult
            var parent = Thread.getParent()
            parent.send(new TtResult(m.label + "!", m.number * 2, 1))
        }
    }

    // Mutates the holder it was given. Under share-nothing that holder is a
    // copy, so the parent's holder must not change.
    class TtMutatorWorker(private var holder: TtHolder) : Runnable {
        import Am.Lang
        import Am.Threading

        override fun run() {
            this.holder.value = 99
            var parent = Thread.getParent()
            parent.send(new TtResult("mutated", this.holder.value, 1))
        }
    }

    // Sends a graph with a shared node and a list, to exercise the copier.
    class TtGraphWorker() : Runnable {
        import Am.Lang
        import Am.Threading
        import Am.Collections

        override fun run() {
            var node = new TtNode(7)
            var pair = new TtPair(node, node)
            var parent = Thread.getParent()
            parent.send(pair)
            var names = List.newList<String>()
            names.add("alpha")
            names.add("beta")
            names.add("gamma")
            parent.send(names)
        }
    }

    class ThreadTests {
        import Am.Lang
        import Am.Threading
        import Am.Collections
        import Am.Tests

        // ---- Baseline: start + join schedules run(), the reply arrives ---

        test testWorkerRunsAtLeastOnce() {
            var w = new TtBasicWorker("baseline", 1)
            var t = new Thread(w as Runnable)
            t.name = "tt-baseline"
            t.start()
            t.join()

            var r = Thread.receive() as TtResult
            Assert.assertEquals(1, r.runCount)
        }

        // ---- The copied Runnable carries the parent's String field ------

        test testWorkerReadsStringField() {
            var w = new TtBasicWorker("cross-thread-string", 0)
            var t = new Thread(w as Runnable)
            t.name = "tt-string"
            t.start()
            t.join()

            var r = Thread.receive() as TtResult
            Assert.assertEquals("cross-thread-string", r.label)
        }

        // ---- ... and its Int field ---------------------------------------

        test testWorkerReadsIntField() {
            var w = new TtBasicWorker("int-field", 12345)
            var t = new Thread(w as Runnable)
            t.name = "tt-int"
            t.start()
            t.join()

            var r = Thread.receive() as TtResult
            Assert.assertEquals(12345, r.number)
        }

        // ---- Two workers, two replies, summed by the parent ---------------

        test testTwoWorkersReportToParent() {
            var a = new TtAdderWorker(10)
            var b = new TtAdderWorker(20)

            var ta = new Thread(a as Runnable)
            ta.name = "tt-adder-a"
            var tb = new Thread(b as Runnable)
            tb.name = "tt-adder-b"

            ta.start()
            tb.start()
            ta.join()
            tb.join()

            var r1 = Thread.receive() as TtResult
            var r2 = Thread.receive() as TtResult
            // Arrival order is unspecified; the total is not.
            Assert.assertEquals(30, r1.number + r2.number)
        }

        // ---- Many rapid start/join cycles ---------------------------------

        test testRepeatedStartJoin() {
            var iterations = 10
            for (i = 0 to iterations) {
                var w = new TtBasicWorker("iter", i)
                var t = new Thread(w as Runnable)
                t.name = "tt-repeat"
                t.start()
                t.join()
            }
            var total = 0
            for (i = 0 to iterations) {
                var r = Thread.receive() as TtResult
                total = total + r.runCount
            }
            Assert.assertEquals(iterations, total)
        }

        // ---- Parent -> worker -> parent round trip -------------------------

        test testSendToWorkerAndBack() {
            var w = new TtEchoWorker()
            var t = new Thread(w as Runnable)
            t.name = "tt-echo"
            t.start()
            t.send(new TtResult("ping", 21, 0))
            t.join()

            var r = Thread.receive() as TtResult
            Assert.assertEquals("ping!", r.label)
            Assert.assertEquals(42, r.number)
        }

        // ---- The worker runs on a COPY: the parent's objects stay put ------

        test testWorkerMutatesItsOwnCopy() {
            var holder = new TtHolder()
            var w = new TtMutatorWorker(holder)
            var t = new Thread(w as Runnable)
            t.name = "tt-mutator"
            t.start()
            t.join()

            var r = Thread.receive() as TtResult
            Assert.assertEquals(99, r.number)
            // Share-nothing: the worker changed its copy, not this one.
            Assert.assertEquals(0, holder.value)
        }

        // ---- Message graphs: shared nodes and collections ------------------

        test testMessageGraphKeepsSharedNodeAndList() {
            var w = new TtGraphWorker()
            var t = new Thread(w as Runnable)
            t.name = "tt-graph"
            t.start()
            t.join()

            var pair = Thread.receive() as TtPair
            Assert.assertEquals(7, pair.a.value)
            Assert.assertEquals(7, pair.b.value)
            // One node referenced twice on the sender must be ONE node here too.
            pair.a.value = 8
            Assert.assertEquals(8, pair.b.value)

            var names = Thread.receive() as List<String>
            Assert.assertEquals(3, names.getSize())
            Assert.assertEquals("beta", names.get(1))
        }

        // ---- tryReceive on an empty mailbox --------------------------------

        test testTryReceiveEmpty() {
            var m = Thread.tryReceive()
            Assert.assertTrue(m == null)
        }

        // ---- Non-sendable objects are refused, nothing is sent -------------

        test testNonSendableThrows() {
            var threw = false
            try {
                // A Mutex is a native class that owns an OS handle: not sendable.
                Thread.getCurrent().send(new Mutex())
            } catch (e: Exception) {
                threw = true
            }
            Assert.assertTrue(threw)
            var m = Thread.tryReceive()
            Assert.assertTrue(m == null)
        }

        // ---- A handle to self round-trips through the mailbox --------------

        test testSelfSend() {
            var me = Thread.getCurrent()
            me.send(new TtResult("self", 5, 0))
            var r = Thread.receive() as TtResult
            Assert.assertEquals("self", r.label)
            Assert.assertEquals(5, r.number)
        }
    }
}
