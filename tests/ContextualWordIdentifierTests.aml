namespace Tests {

    // Redmine #515: contextual words (either, when, data, scratch, keep, shared,
    // fast) stay usable as ordinary identifiers in every position.
    class CwEitherBox(var n: Int) {
        import Am.Lang
    }

    class CwEither {
        import Am.Lang
        import Am.Tests

        var either: Int = 5
        var eitherBox: CwEitherBox = new CwEitherBox(7)

        static fun ident(x: Int): Int {
            return x
        }

        static fun asParam(either: Int): Int {
            return either + 1
        }

        static fun paramArg(either: Int): Int {
            return CwEither.ident(either)
        }

        static fun fieldRead(o: CwEither): Int {
            return o.either
        }

        fun fieldSelf(): Int {
            return either * 2
        }

        static test testLocalAndArgument() {
            var either = 4
            Assert.assertEquals(4, CwEither.ident(either))
            Assert.assertEquals(9, CwEither.ident(either) + 5)
            Assert.assertEquals(12, CwEither.ident(either + either + either))
        }

        static test testExpression() {
            var either = 10
            var r = either + 1
            Assert.assertEquals(11, r)
            Assert.assertTrue(either > 3)
            Assert.assertTrue(either == 10 && either != 2)
            if (either > 5) {
                r = either * 3
            }
            Assert.assertEquals(30, r)
        }

        static test testAssignmentTarget() {
            var either = 1
            either = 2
            either = either + 5
            either += 1
            Assert.assertEquals(8, either)
        }

        static test testReceiver() {
            var either = new CwEitherBox(3)
            Assert.assertEquals(3, either.n)
            either.n = 9
            Assert.assertEquals(9, either.n)
            Assert.assertEquals("9", either.n.toString())
        }

        static test testParameter() {
            Assert.assertEquals(6, CwEither.asParam(5))
            Assert.assertEquals(8, CwEither.paramArg(8))
        }

        static test testField() {
            var o = new CwEither()
            o.bare()
            var o2 = new CwEither()
            Assert.assertEquals(5, o2.either)
            Assert.assertEquals(10, o2.fieldSelf())
            o2.either = 6
            Assert.assertEquals(6, CwEither.fieldRead(o2))
            Assert.assertEquals(7, o2.eitherBox.n)
            o2.eitherBox.n = 8
            Assert.assertEquals(8, o2.eitherBox.n)
        }

        fun bare() {
            Assert.assertEquals(5, either)
            Assert.assertEquals(5, this.either)
            either = 6
            Assert.assertEquals(6, either)
            eitherBox.n = 8
            Assert.assertEquals(8, eitherBox.n)
        }

        static test testLambdaParameter() {
            var f = (either: Int) => either + 100
            Assert.assertEquals(103, f(3))
            var h: (Int) => Int = (either) => CwEither.ident(either)
            Assert.assertEquals(42, h(42))
        }

        static test testReturnAndString() {
            var either = 7
            Assert.assertEquals("v=7", "v=" + either.toString())
            Assert.assertEquals(7, CwEither.back(either))
        }

        static fun back(x: Int): Int {
            var either = x
            return either
        }
    }

