    class CwEitherConstruct {
        import Am.Lang
        import Am.Tests

        static fun boom(): Int {
            throw new Exception("boom")
        }

        static test testEitherKeywordStillWorks() {
            var either = 3
            Assert.assertEquals(9, either(CwEitherConstruct.boom(), 9))
            Assert.assertEquals(3, either(either, 9))
            Assert.assertEquals(4, either(either + 1, 9))
        }
    }
}
