namespace Tests {

    // Redmine #420b, the null-member-access cases: an override of a #noThrow
    // function (toString, hash, equals) that reads through a nullable member
    // must catch the null check itself. (In tests-v1-only until v2 emitted
    // the null check for a call through a null object, #428.) The
    // explicit-throw cases are in tests/NoThrowOverrideTests.aml.
    class NoThrowOverrideNullNode {
        import Am.Lang
        var next: NoThrowOverrideNullNode? = null

        override fun toString(): String {
            try {
                return this.next.toString() + "!"
            } catch (e: Exception) {
                return "end"
            }
        }

        override fun hash(): UInt {
            try {
                return this.next.hash() + 7UI
            } catch (e: Exception) {
            }
            return 1UI
        }

        override fun equals(other: Object): Bool {
            try {
                return this.next.equals(other)
            } catch (e: Exception) {
            }
            return false
        }
    }

    class NoThrowOverrideNullMemberTests {
        import Am.Lang
        import Am.Tests

        static fun describe(a: Any): String {
            return a.toString()
        }

        static fun hashOf(a: Any): UInt {
            return a.hash()
        }

        static fun same(a: Object, b: Object): Bool {
            return a.equals(b)
        }

        test aNullMemberIsCaughtByTheOverride() {
            var escaped = false
            var n = new NoThrowOverrideNullNode()
            var text = "unset"
            var h = 0UI
            var r = true
            try {
                text = NoThrowOverrideNullMemberTests.describe(n)
                h = NoThrowOverrideNullMemberTests.hashOf(n)
                r = NoThrowOverrideNullMemberTests.same(n, n)
            } catch (e: Exception) {
                escaped = true
            }
            Assert.assertFalse(escaped)
            Assert.assertEquals("end", text)
            Assert.assertTrue(h == 1UI)
            Assert.assertFalse(r)
        }

        test aChainFallsBackAtItsEnd() {
            var b = new NoThrowOverrideNullNode()
            b.next = new NoThrowOverrideNullNode()
            b.next.next = new NoThrowOverrideNullNode()
            Assert.assertEquals("end!!", NoThrowOverrideNullMemberTests.describe(b))
            Assert.assertTrue(NoThrowOverrideNullMemberTests.hashOf(b) == 15UI)
        }

        test repeatedCatchesDoNotPileUp() {
            var n = new NoThrowOverrideNullNode()
            var total = 0UI
            for (i = 0 until 1000) {
                total = total + n.hash()
                n.toString()
                n.equals(n)
            }
            Assert.assertTrue(total == 1000UI)
        }
    }
}
