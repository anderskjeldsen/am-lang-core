namespace Tests {

    // Redmine #580: a statement call whose object result is discarded releases
    // it right after the statement, so Arc.getAllocationCount() right after the
    // statement matches the count before it (v2 kept the last result alive: a
    // result of `this.f()` was never released, one of `T.f()` or a chain lived
    // to the end of the function). Redmine #583: v1 released the result of a
    // straight-line statement only at the end of its block (in a function
    // body, at function exit); the `...Straight` tests count right after such
    // statements.

    class DrBox {
        import Am.Lang
        import Am.Lang.Diagnostics
        var tag: String = "t"
        var kid: DrBox? = null

        fun fresh(): DrBox {
            return new DrBox()
        }

        fun text(): String {
            return "v" + this.tag
        }

        fun literal(): String {
            return "literal"
        }

        fun self(): DrBox {
            return this
        }

        fun getTag(): String {
            return this.tag
        }

        fun once(): String {
            return this.tag + "!"
        }

        static fun made(i: Int): String {
            return "m" + i.toString()
        }

        // Calls on `this` and a bare call in straight-line code: the
        // difference in allocations across them.
        fun selfCallsStraight(): Long {
            var before = Arc.getAllocationCount()
            this.once()
            this.fresh()
            this.text()
            once()
            fresh().fresh()
            return Arc.getAllocationCount() - before
        }

        // Calls on `this` and a bare call, results discarded.
        fun selfCalls(n: Int) {
            for (i = 0 until n) {
                this.once()
                this.fresh()
                this.text()
                once()
            }
        }
    }

    class DiscardedResultTests {
        import Am.Lang
        import Am.Lang.Diagnostics
        import Am.Tests

        test discardedNewObjectInLoop() {
            var b = new DrBox()
            b.fresh()
            var before = Arc.getAllocationCount()
            for (i = 0 until 5) {
                b.fresh()
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test discardedNewStringInLoop() {
            var b = new DrBox()
            b.text()
            var before = Arc.getAllocationCount()
            for (i = 0 until 5) {
                b.once()
                b.text()
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test discardedStaticCallInLoop() {
            DrBox.made(0)
            var before = Arc.getAllocationCount()
            for (i = 0 until 5) {
                DrBox.made(i)
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test discardedCallsOnThisInLoop() {
            var b = new DrBox()
            b.selfCalls(1)
            var before = Arc.getAllocationCount()
            b.selfCalls(5)
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test discardedChainedCallsInLoop() {
            var b = new DrBox()
            b.fresh().fresh()
            var before = Arc.getAllocationCount()
            for (i = 0 until 5) {
                b.fresh().fresh().fresh()
                b.fresh().once()
                b.self().text()
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test discardedResultsInWhileLoop() {
            var b = new DrBox()
            b.fresh()
            var before = Arc.getAllocationCount()
            var k = 0
            while (k < 5) {
                b.fresh()
                DrBox.made(k)
                k++
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test discardedBorrowedResultsStayAlive() {
            var b = new DrBox()
            b.kid = new DrBox()
            for (i = 0 until 5) {
                b.self()
                b.literal()
                b.getTag()
                b.self().self()
            }
            Assert.assertEquals("t", b.tag)
            Assert.assertEquals("t", b.getTag())
            Assert.assertEquals("literal", b.literal())
            Assert.assertTrue(b.self() == b)
            Assert.assertTrue(b.kid != null)
        }

        test aNewExpressionStatementInLoop() {
            new DrBox().once()
            var before = Arc.getAllocationCount()
            for (i = 0 until 5) {
                new DrBox().once()
                new DrBox().fresh()
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test aStringLiteralReceiverInLoop() {
            "abc".toUpperCase()
            var before = Arc.getAllocationCount()
            for (i = 0 until 5) {
                "abc".toUpperCase()
                "abc".substring(1, 1)
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test discardedResultsStraight() {
            var b = new DrBox()
            var before = Arc.getAllocationCount()
            b.fresh()
            Assert.assertEquals(before, Arc.getAllocationCount())
            b.text()
            b.once()
            Assert.assertEquals(before, Arc.getAllocationCount())
            DrBox.made(3)
            Assert.assertEquals(before, Arc.getAllocationCount())
            b.fresh().fresh().fresh()
            b.fresh().once()
            b.self().text()
            Assert.assertEquals(before, Arc.getAllocationCount())
            new DrBox().once()
            new DrBox()
            "abc".toUpperCase()
            Assert.assertEquals(before, Arc.getAllocationCount())
            b.text().length()
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test discardedResultsThroughNonNullStraight() {
            var b = new DrBox()
            var k = new DrBox()
            b.kid = k
            var before = Arc.getAllocationCount()
            b.kid!!.fresh()
            b.kid!!.text()
            Assert.assertEquals(before, Arc.getAllocationCount())
        }

        test discardedResultsOnThisStraight() {
            var b = new DrBox()
            Assert.assertEquals(0L, b.selfCallsStraight())
        }

        // The statement's own temps only: an earlier statement's value, a
        // local and a field set from a call, stays alive.
        test keptResultsStraight() {
            var b = new DrBox()
            var s = b.text()
            b.fresh()
            var k = b.fresh()
            k.tag = "k"
            b.kid = b.fresh()
            b.text()
            b.kid!!.tag = s
            Assert.assertEquals("vt", s)
            Assert.assertEquals("k", k.tag)
            Assert.assertEquals("vt", b.kid!!.tag)
            Assert.assertEquals("vk", k.text())
        }

        test discardedResultsInIfBlockStraight() {
            var b = new DrBox()
            var before = Arc.getAllocationCount()
            if (b.tag == "t") {
                b.fresh()
                Assert.assertEquals(before, Arc.getAllocationCount())
                b.text()
            }
            Assert.assertEquals(before, Arc.getAllocationCount())
        }
    }
}
