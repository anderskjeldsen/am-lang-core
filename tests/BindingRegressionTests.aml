namespace Tests {

    // Field initialisers that read another class's untyped static (Redmine
    // #150). Declared before the class that owns the statics on purpose.
    class BindRegHolder {
        import Am.Lang

        var sized: Int[] = new Int[BindRegZConsts.count]
        var copied: Int = BindRegZConsts.count
        var doubled = BindRegZConsts.count * 2
        var tier: UByte = 3UB
    }

    class BindRegZConsts {
        import Am.Lang

        static const var count = 5
        static const var label = "consts"
    }

    enum BindRegColor<UByte> {
        import Am.Lang

        background = 0UB
        white = 7UB
    }

    // #160: bare calls on the right of an operator are calls on `this`.
    class BindRegPicker {
        import Am.Lang

        fun pick(): BindRegColor {
            return BindRegColor.white
        }

        fun two(): Int {
            return 2
        }

        override fun toString(): String {
            return "picker"
        }

        fun matches(k: BindRegColor): Bool {
            return k == pick()
        }

        fun sum(n: Int): Int {
            return n + two() * two()
        }

        fun greater(n: Int): Bool {
            return n > two()
        }

        // String declares toString too: the bare call must still be this.toString().
        fun sameText(other: String): Bool {
            return other == toString()
        }
    }

    // #18: writes through an inline cast, on an inherited field.
    class BindRegBase {
        import Am.Lang

        var tool: BindRegHolder? = null
        var n: Int = 0
    }

    class BindRegCanvas : BindRegBase {
        import Am.Lang

        var label: String = "unset"
    }

    class BindingRegressionTests {
        import Am.Lang
        import Am.Collections
        import Am.Tests

        var starts: Int[] = new Int[3]
        var items: Int[] = new Int[4]

        static fun maybeHolder(): BindRegHolder? {
            return new BindRegHolder()
        }

        // #150
        static test fieldInitialiserReadsUntypedStaticOfLaterClass() {
            var h = new BindRegHolder()
            Assert.assertEquals(5, (h.sized.length() as Int))
            Assert.assertEquals(5, h.copied)
            Assert.assertEquals(10, h.doubled)
            Assert.assertEquals("consts", BindRegZConsts.label)
        }

        // #148: loop bounds read straight from array elements
        static test forLoopBoundsFromArrayElements() {
            var t = new BindingRegressionTests()
            t.starts[0] = 1
            t.starts[1] = 3
            t.items[1] = 10
            t.items[2] = 20
            var out = List.newList<Int>()
            t.collect(0, out)
            Assert.assertEquals(2, out.getSize())
            Assert.assertEquals(10, out.get(0))
            Assert.assertEquals(20, out.get(1))
        }

        fun collect(i0: Int, out: List<Int>) {
            for (i = this.starts[i0] until this.starts[i0 + 1]) {
                out.add(this.items[i])
            }
        }

        // #149: a method of the backing type, called on an enum member
        static test enumMemberCallsBackingTypeMethod() {
            var c = new Int[8]
            c[BindRegColor.white.toInt()] = 42
            Assert.assertEquals(42, c[7])
            var k = BindRegColor.white
            Assert.assertEquals(7, k.toInt())
        }

        fun yes(): Bool {
            return true
        }

        fun no(): Bool {
            return false
        }

        // A bare call on the right of && / || is a call on `this`, not on
        // the left operand's type (Bool).
        static test bareCallAfterLogicalOperator() {
            var t = new BindingRegressionTests()
            t.checkLogical()
        }

        fun checkLogical() {
            var a = true
            var b = false
            Assert.assertTrue(a && yes())
            Assert.assertFalse(a && no())
            Assert.assertTrue(b || yes())
            Assert.assertFalse(b || no())
        }

        // #158: a member after `!!` / `?.` is never a same-named local
        static test memberAfterNonNullAssertionIsNotALocal() {
            var h = BindingRegressionTests.maybeHolder()
            var tier = 4
            if (h != null) {
                tier = h!!.tier.toInt()
            }
            Assert.assertEquals(3, tier)

            var copied = 9
            if (h != null) {
                copied = h!!.copied
            }
            Assert.assertEquals(5, copied)

            copied = 1
            copied = h?.copied ?? 0
            Assert.assertEquals(5, copied)
        }

        // #160
        static test bareCallOnTheRightOfAnOperator() {
            var p = new BindRegPicker()
            Assert.assertTrue(p.matches(BindRegColor.white))
            Assert.assertFalse(p.matches(BindRegColor.background))
            Assert.assertEquals(9, p.sum(5))
            Assert.assertTrue(p.greater(3))
            Assert.assertFalse(p.greater(2))
            Assert.assertTrue(p.sameText("picker"))
            Assert.assertFalse(p.sameText("other"))
        }

        // #211: a write through `!!` with a same-named local in scope.
        static test writeAfterNonNullAssertionIsNotALocal() {
            var h = BindingRegressionTests.maybeHolder()
            var copied = 9
            h!!.copied = 42
            Assert.assertEquals(9, copied)
            Assert.assertEquals(42, h!!.copied)
        }

        // #18: `(x as T).field = v` assigns to the object.
        static test writeThroughInlineCast() {
            var o: Object = new BindRegCanvas()
            var tool = new BindRegHolder()
            tool.copied = 77
            (o as BindRegCanvas).tool = tool
            (o as BindRegCanvas).n = 4
            (o as BindRegCanvas).label = "cast"
            var c = o as BindRegCanvas
            Assert.assertEquals(77, c.tool!!.copied)
            Assert.assertEquals(4, c.n)
            Assert.assertEquals("cast", c.label)

            var list = new List<Object>()
            list.add(new BindRegCanvas())
            var label = "from list"
            (list.get(0) as BindRegCanvas).label = label
            (list.get(0) as BindRegCanvas).n = 9
            var back = list.get(0) as BindRegCanvas
            Assert.assertEquals("from list", back.label)
            Assert.assertEquals(9, back.n)
        }
    }
}
