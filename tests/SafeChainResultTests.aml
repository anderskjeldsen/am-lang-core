namespace Tests {

    // Redmine #592 (v2): a safe chain with a primitive or enum result is an
    // `Int?` / `Color?`, null when ANY link is. v2 put the result in a plain
    // int slot and emitted the `??` fallback only for a null head, so
    // `a?.kid?.n ?? -1` gave 0 with `a` set and `kid` null.
    // Redmine #593 (v2): `a?.f()` as a statement did not parse, and a safe
    // chain right of a binary operator (`"n=" + a?.me().s`) swallowed the
    // operator and its left operand into the receiver.

    enum ScrColor {
        import Am.Lang

        red = 1
        green = 2
    }

    class ScrNode {
        import Am.Lang
        var n: Int = 7
        var flag: Bool = true
        var color: ScrColor = ScrColor.green
        var name: String = "nd"
        var kid: ScrNode? = null
        var hits: Int = 0

        fun me(): ScrNode { return this }
        fun num(): Int { return this.n }
        fun touch() { this.hits = this.hits + 1 }
    }

    class SafeChainResultTests {
        import Am.Lang
        import Am.Tests

        static fun describe(v: Int?): String {
            if (v == null) { return "null" }
            return v!!.toString()
        }

        static fun kidN(a: ScrNode?): Int? {
            return a?.kid?.n
        }

        test intFallbackMiddleNull() {
            var a: ScrNode? = new ScrNode()
            var z: ScrNode? = null
            Assert.assertEquals(-1, a?.kid?.n ?? -1)
            Assert.assertEquals(-2, z?.kid?.n ?? -2)
            Assert.assertEquals(7, a?.n ?? -3)
            Assert.assertEquals(-4, a?.kid?.num() ?? -4)
            Assert.assertEquals(7, a?.num() ?? -5)
            a.kid = new ScrNode()
            a.kid.n = 9
            Assert.assertEquals(9, a?.kid?.n ?? -1)
            Assert.assertEquals(9, a?.kid?.num() ?? -1)
        }

        test boolAndEnumFallback() {
            var a: ScrNode? = new ScrNode()
            Assert.assertFalse(a?.kid?.flag ?? false)
            Assert.assertTrue(a?.flag ?? false)
            var c = a?.kid?.color ?? ScrColor.red
            Assert.assertTrue(c == ScrColor.red)
            var d = a?.color ?? ScrColor.red
            Assert.assertTrue(d == ScrColor.green)
        }

        test stringFallback() {
            var a: ScrNode? = new ScrNode()
            Assert.assertEquals("dflt", a?.kid?.name ?? "dflt")
            Assert.assertEquals("nd", a?.name ?? "dflt")
        }

        test inferredLocalIsNullable() {
            var a: ScrNode? = new ScrNode()
            var v = a?.kid?.n
            Assert.assertTrue(v == null)
            var w = a?.n
            Assert.assertTrue(w != null)
            Assert.assertEquals(7, w!!)
            var c = a?.kid?.color
            Assert.assertTrue(c == null)
            var b = a?.flag
            Assert.assertTrue(b!!)
        }

        test assignToNullableLocal() {
            var a: ScrNode? = new ScrNode()
            var w: Int? = 5
            w = a?.kid?.n
            Assert.assertTrue(w == null)
            w = a?.n
            Assert.assertEquals(7, w!!)
            var c: ScrColor? = ScrColor.red
            c = a?.kid?.color
            Assert.assertTrue(c == null)
        }

        test passAndReturn() {
            var a: ScrNode? = new ScrNode()
            Assert.assertEquals("null", SafeChainResultTests.describe(a?.kid?.n))
            Assert.assertEquals("7", SafeChainResultTests.describe(a?.me().n))
            Assert.assertTrue(SafeChainResultTests.kidN(a) == null)
            a.kid = new ScrNode()
            Assert.assertEquals(7, SafeChainResultTests.kidN(a) ?? -1)
        }

        test compareWithValue() {
            var a: ScrNode? = new ScrNode()
            Assert.assertTrue(a?.flag == true)
            Assert.assertFalse(a?.kid?.flag == true)
            Assert.assertTrue(a?.color == ScrColor.green)
            Assert.assertFalse(a?.kid?.color == ScrColor.green)
            Assert.assertTrue(a?.n == 7)
            Assert.assertFalse(a?.n != 7)
            Assert.assertTrue(a?.me().n == 7)
            Assert.assertFalse(a?.kid?.n == 7)
            // #596: v1 compared inside the chain, so these read false.
            Assert.assertTrue(a?.kid?.n != 7)
            Assert.assertTrue(a?.kid?.n == null)
            Assert.assertFalse(a?.kid?.n != null)
            Assert.assertTrue(a?.kid?.flag != true)
            Assert.assertTrue(a?.kid?.color != ScrColor.green)
            a.kid = new ScrNode()
            a.kid.n = 300
            Assert.assertTrue(a?.kid?.n == 300)
            Assert.assertTrue(a?.kid?.me().n == 300)
        }

        test bangAfterChain() {
            var a: ScrNode? = new ScrNode()
            Assert.assertEquals("7", a?.n!!.toString())
            Assert.assertEquals(7, a?.me().n!!)
        }

        test fallbackInLoopResets() {
            var withKid = new ScrNode()
            withKid.kid = new ScrNode()
            var nodes = new Am.Collections.List<ScrNode>()
            nodes.add(withKid)
            nodes.add(new ScrNode())
            nodes.add(withKid)
            var sum = 0
            each (nd in nodes) {
                var k = nd.kid?.n ?? 100
                sum = sum + k
            }
            Assert.assertEquals(114, sum)
        }

        test safeCallStatement() {
            var a: ScrNode? = new ScrNode()
            var z: ScrNode? = null
            a?.touch()
            z?.touch()
            a.kid?.touch()
            a?.kid?.touch()
            Assert.assertEquals(1, a.hits)
            a.kid = new ScrNode()
            a.kid?.touch()
            a?.kid?.touch()
            a?.me().touch()
            Assert.assertEquals(2, a.hits)
            Assert.assertEquals(2, a.kid.hits)
        }

        // Redmine #596 (v1): `==`, `!=` and `!!` after a safe chain apply to
        // the chain's result, null when any link is. v1 rendered them inside
        // the chain's non-null branches, and a null link left NULL in the
        // result, which read as `false` (and as `0` for `!!`, which never threw).
        test compareNullAtStart() {
            var z: ScrNode? = null
            Assert.assertTrue(z?.n == null)
            Assert.assertFalse(z?.n != null)
            Assert.assertFalse(z?.n == 7)
            Assert.assertTrue(z?.n != 7)
            Assert.assertTrue(z?.flag == null)
            Assert.assertFalse(z?.flag == false)
            Assert.assertTrue(z?.flag != false)
            Assert.assertTrue(z?.color == null)
            Assert.assertFalse(z?.color == ScrColor.green)
            Assert.assertTrue(z?.name == null)
            Assert.assertFalse(z?.name != null)
            Assert.assertTrue(z?.kid == null)
            Assert.assertTrue(z?.me().n == null)
            Assert.assertTrue(z?.num() == null)
            Assert.assertTrue(z?.kid?.n == null)
        }

        test compareNullInTheMiddle() {
            var a: ScrNode? = new ScrNode()
            Assert.assertTrue(a?.kid?.n == null)
            Assert.assertFalse(a?.kid?.n != null)
            Assert.assertTrue(a?.kid?.n != 300)
            Assert.assertTrue(a?.kid?.num() == null)
            Assert.assertTrue(a?.kid?.flag == null)
            Assert.assertTrue(a?.kid?.color == null)
            Assert.assertTrue(a?.kid?.name == null)
            Assert.assertTrue(a?.kid?.kid == null)
            Assert.assertTrue(a?.kid?.me().n == null)
            Assert.assertTrue(a?.me().kid?.n == null)
            a.kid = new ScrNode()
            Assert.assertTrue(a?.kid?.kid?.n == null)
            Assert.assertTrue(a?.kid?.kid?.name == null)
            Assert.assertFalse(a?.kid?.n == null)
            Assert.assertTrue(a?.kid?.n == 7)
            Assert.assertTrue(a?.kid?.name == "nd")
        }

        test compareNullAtTheEnd() {
            var a: ScrNode? = new ScrNode()
            Assert.assertTrue(a?.kid == null)
            Assert.assertFalse(a?.kid != null)
            Assert.assertTrue(a?.me().kid == null)
            Assert.assertFalse(a?.n == null)
            Assert.assertTrue(a?.n != null)
            Assert.assertFalse(a?.name == null)
            Assert.assertTrue(a?.name == "nd")
            Assert.assertFalse(a?.name != "nd")
            Assert.assertTrue(a?.flag == true)
            Assert.assertTrue(a?.color == ScrColor.green)
        }

        test compareInIfAndLocals() {
            var a: ScrNode? = new ScrNode()
            var z: ScrNode? = null
            var hits = 0
            if (z?.n == null) { hits = hits + 1 }
            if (a?.kid?.n == null) { hits = hits + 10 }
            if (a?.kid?.n != 7) { hits = hits + 100 }
            if (z?.name == null && a?.n == 7) { hits = hits + 1000 }
            if (a?.kid?.color == ScrColor.green || a?.kid?.name == null) { hits = hits + 10000 }
            Assert.assertEquals(11111, hits)
            var b1 = z?.n == null
            var b2 = a?.kid?.n != 7
            var b3 = a?.kid?.name == null
            var b4 = a?.n == null
            Assert.assertTrue(b1)
            Assert.assertTrue(b2)
            Assert.assertTrue(b3)
            Assert.assertFalse(b4)
            var b5 = false
            b5 = a?.kid?.flag == null
            Assert.assertTrue(b5)
        }

        test bangOnNullChainThrows() {
            var a: ScrNode? = new ScrNode()
            var z: ScrNode? = null
            var thrown = 0
            var got = -5
            var gotS = "none"
            try {
                got = a?.kid?.n!!
            } catch (e: Exception) {
                thrown = thrown + 1
            }
            try {
                got = z?.n!!
            } catch (e: Exception) {
                thrown = thrown + 10
            }
            try {
                gotS = a?.kid?.name!!
            } catch (e: Exception) {
                thrown = thrown + 100
            }
            Assert.assertEquals(-5, got)
            Assert.assertEquals("none", gotS)
            Assert.assertEquals(111, thrown)
            Assert.assertEquals(7, a?.n!!)
            Assert.assertEquals("nd", a?.name!!)
            a.kid = new ScrNode()
            Assert.assertEquals(7, a?.kid?.n!!)
            Assert.assertEquals("7", a?.kid?.n!!.toString())
        }

        test fallbackAfterNullLinks() {
            var a: ScrNode? = new ScrNode()
            var z: ScrNode? = null
            Assert.assertEquals(-1, z?.n ?? -1)
            Assert.assertEquals(-2, a?.kid?.n ?? -2)
            Assert.assertEquals("fb", z?.name ?? "fb")
            Assert.assertEquals("fb", a?.kid?.kid?.name ?? "fb")
            Assert.assertTrue((a?.kid?.color ?? ScrColor.red) == ScrColor.red)
        }

        // A name that is also an operator-ish word stays an identifier.
        test identifiersUnaffected() {
            var a: ScrNode? = new ScrNode()
            var kid = a?.kid
            Assert.assertTrue(kid == null)
            var n = 3
            Assert.assertTrue(n == 3)
        }

        test stringConcatenation() {
            var a: ScrNode? = new ScrNode()
            var z: ScrNode? = null
            Assert.assertEquals("n=nd", "n=" + a?.me().name)
            Assert.assertEquals("nd!", a?.me().name + "!")
            Assert.assertEquals("<nd>", "<" + a?.name + ">")
            Assert.assertEquals("<none>", "<" + (z?.name ?? "none") + ">")
            Assert.assertEquals("n=7", "n=" + (a?.n ?? 0).toString())
            Assert.assertEquals("n=0", "n=" + (a?.kid?.n ?? 0).toString())
        }
    }
}
