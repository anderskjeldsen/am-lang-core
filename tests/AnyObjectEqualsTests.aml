namespace Tests {

    // Redmine #562: comparing an Any that holds a primitive with an object
    // (`h.getN() == "5"`) crashed in v1: the guard for an object operand
    // tested `(flags & 0) == 0`, always true, so the boxed Int was read as an
    // object pointer. The comparison is false (true for `!=`) now, in v1 and
    // v2, for every kind of value the Any holds, in both operand orders.
    // v2 compiled a primitive or enum on the left of an Any, and an Any local
    // or field against an enum or another Any, to invalid C until #533.

    enum AoColor {
        import Am.Lang

        red = 1
        blue = 2
    }

    class AoThing {
        import Am.Lang
        var name: String = "t"
    }

    class AoHolder {
        import Am.Lang
        var value: Any = 5
        fun get(): Any { return this.value }
        fun getInt(): Any { return 5 }
        fun getLong(): Any { return 5L }
        fun getBool(): Any { return true }
        fun getDouble(): Any { return 2.5 }
        fun getEnum(): Any { return AoColor.red }
        fun getString(): Any { return "5" }
        fun getNull(): Any { return null }
    }

    class AnyObjectEqualsTests {
        import Am.Lang
        import Am.Tests

        test primitiveHoldersComparedWithAString() {
            var h = new AoHolder()
            Assert.assertTrue(h.getInt() != "5")
            Assert.assertTrue(!(h.getInt() == "5"))
            Assert.assertTrue("5" != h.getInt())
            Assert.assertTrue(!("5" == h.getInt()))
            Assert.assertTrue(!(h.getLong() == "5"))
            Assert.assertTrue(h.getBool() != "true")
            Assert.assertTrue(!(h.getDouble() == "2.5"))
            Assert.assertTrue(h.getEnum() != "1")
            Assert.assertTrue(!("1" == h.getEnum()))
        }

        test primitiveHoldersComparedWithAnObject() {
            var h = new AoHolder()
            var t = new AoThing()
            Assert.assertTrue(h.getInt() != t)
            Assert.assertTrue(!(h.getInt() == t))
            Assert.assertTrue(t != h.getInt())
            Assert.assertTrue(!(t == h.getInt()))
            Assert.assertTrue(h.getBool() != t)
            Assert.assertTrue(h.getDouble() != t)
            Assert.assertTrue(!(h.getEnum() == t))
            h.value = 0
            Assert.assertTrue(h.get() != t)
            Assert.assertTrue(!(t == h.get()))
        }

        test objectHoldersStillCompareByValue() {
            var h = new AoHolder()
            Assert.assertTrue(h.getString() == "5")
            Assert.assertTrue("5" == h.getString())
            Assert.assertTrue(!(h.getString() != "5"))
            Assert.assertTrue(h.getString() != "6")
            var t = new AoThing()
            h.value = t
            Assert.assertTrue(h.get() == t)
            Assert.assertTrue(t == h.get())
            Assert.assertTrue(h.get() != new AoThing())
            Assert.assertTrue(h.get() != "t")
            h.value = "t"
            Assert.assertTrue(h.get() != t)
        }

        test primitivesStillCompareWithPrimitives() {
            var h = new AoHolder()
            Assert.assertTrue(h.getInt() == 5)
            Assert.assertTrue(5 == h.getInt())
            Assert.assertTrue(h.getInt() != 6)
            Assert.assertTrue(h.getLong() == 5L)
            Assert.assertTrue(h.getBool() == true)
            Assert.assertTrue(h.getBool() != false)
            Assert.assertTrue(h.getDouble() == 2.5)
            Assert.assertTrue(2.5 == h.getDouble())
            Assert.assertTrue(h.getEnum() == AoColor.red)
            Assert.assertTrue(AoColor.red == h.getEnum())
            Assert.assertTrue(h.getEnum() != AoColor.blue)
        }

        test nullHolders() {
            var h = new AoHolder()
            var t = new AoThing()
            Assert.assertTrue(h.getNull() != "5")
            Assert.assertTrue(!(h.getNull() == "5"))
            Assert.assertTrue("5" != h.getNull())
            Assert.assertTrue(h.getNull() != t)
            Assert.assertTrue(!(t == h.getNull()))
            Assert.assertTrue(h.getNull() == null)
            Assert.assertTrue(!(h.getNull() != null))
            Assert.assertTrue(h.getInt() != null)
            Assert.assertTrue(!(h.getInt() == null))
            Assert.assertTrue(h.getString() != null)
            Assert.assertTrue(h.getEnum() != null)
            Assert.assertTrue(h.getBool() != null)
            Assert.assertTrue(h.getDouble() != null)
        }

        test localsAndFieldsHoldingPrimitives() {
            var a: Any = 5
            Assert.assertTrue(a != "5")
            Assert.assertTrue(!(a == "5"))
            var h = new AoHolder()
            Assert.assertTrue(h.value != "5")
            Assert.assertTrue(!("5" == h.value))
            var b: Any = AoColor.blue
            Assert.assertTrue(b != "2")
            Assert.assertTrue(b == AoColor.blue)
        }

        test anyAgainstAny() {
            var h = new AoHolder()
            var s: Any = "5"
            Assert.assertTrue(h.getInt() != s)
            Assert.assertTrue(!(s == h.getInt()))
            Assert.assertTrue(h.getString() == s)
            var n: Any = null
            Assert.assertTrue(h.getNull() == n)
            Assert.assertTrue(h.getInt() != n)
            Assert.assertTrue(h.getString() != n)
        }

        test differentPrimitiveKindsAreNotEqual() {
            var h = new AoHolder()
            Assert.assertTrue(h.getLong() != 5)
            Assert.assertTrue(!(5 == h.getLong()))
            Assert.assertTrue(h.getInt() != 5L)
            Assert.assertTrue(h.getDouble() != 5L)
            Assert.assertTrue(!(h.getBool() == 1))
        }

        test anyOnEitherSideOfAPrimitiveOrEnum() {
            var h = new AoHolder()
            var a: Any = 5
            Assert.assertTrue(a == 5)
            Assert.assertTrue(5 == a)
            Assert.assertTrue(a != 5L)
            Assert.assertTrue(!(5L == a))
            Assert.assertTrue(a == h.getInt())
            Assert.assertTrue(h.getInt() == a)
            var b: Any = AoColor.blue
            Assert.assertTrue(AoColor.blue == b)
            Assert.assertTrue(b != AoColor.red)
            Assert.assertTrue(b != 2L)
            var one: Any = 1
            Assert.assertTrue(one != AoColor.red)
            Assert.assertTrue(!(AoColor.red == one))
            Assert.assertTrue(AoColor.red != h.getInt())
            Assert.assertTrue(h.getInt() != AoColor.red)
            Assert.assertTrue(true == h.getBool())
            Assert.assertTrue(!(1 == h.getBool()))
            Assert.assertTrue(h.getNull() != 0)
            Assert.assertTrue(!(0 == h.getNull()))
            var n: Any = null
            Assert.assertTrue(n != 0)
            Assert.assertTrue(!(0 == n))
            h.value = AoColor.blue
            Assert.assertTrue(h.value == AoColor.blue)
            Assert.assertTrue(AoColor.blue == h.value)
            Assert.assertTrue(h.get() != AoColor.red)
        }

        test anyOnEitherSideOfAnObject() {
            var h = new AoHolder()
            var t = new AoThing()
            var o: Any = t
            Assert.assertTrue(o == t)
            Assert.assertTrue(t == o)
            Assert.assertTrue(o != new AoThing())
            Assert.assertTrue(o != "t")
            Assert.assertTrue(o != 5)
            Assert.assertTrue(!(5 == o))
            var n: Any = null
            Assert.assertTrue(n != t)
            Assert.assertTrue(!(t == n))
            h.value = t
            Assert.assertTrue(h.value == t)
            Assert.assertTrue(t == h.value)
            Assert.assertTrue(h.value != 5)
            Assert.assertTrue(!(5 == h.value))
            Assert.assertTrue(t.name == h.getString() || t == h.get())
        }

        test comparisonsInsideBoolChains() {
            var h = new AoHolder()
            var t = new AoThing()
            var a: Any = 5
            var b: Any = AoColor.blue
            var o: Any = t
            Assert.assertTrue(5 == h.getInt() && 6 != h.getInt())
            Assert.assertTrue(5 == h.getInt() || false)
            Assert.assertTrue(a == 5 && b == AoColor.blue)
            Assert.assertTrue(t == h.getInt() || o == t)
            Assert.assertTrue(!(a == "5" || AoColor.red == b))
        }
    }
}
